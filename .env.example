# Paddle configuration (required; environment values must match)
# Copy this file to .env and fill in the values.
# Get these from: https://vendors.paddle.com/authentication (use sandbox-vendors for sandbox)

# Client-side checkout configuration
PUBLIC_PADDLE_ENVIRONMENT=sandbox
PUBLIC_PADDLE_CLIENT_TOKEN=<your-client-side-token>

# Price IDs — set these after running: pnpm paddle:provision
PUBLIC_PADDLE_BASIC_MONTHLY_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_BASIC_ANNUAL_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_PRO_ANNUAL_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_PLUS_MONTHLY_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_PLUS_ANNUAL_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_MAX_MONTHLY_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_MAX_ANNUAL_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_SETUP_FEE_PRICE_ID=pri_<replace>

# Server-side environment used by the permanent portal redirect.
PADDLE_ENVIRONMENT=sandbox

# Permanent general portal URLs copied from the matching Paddle dashboard.
# Never use or store tokenized portal-session or subscription management URLs.
PADDLE_SANDBOX_CUSTOMER_PORTAL_URL=
PADDLE_CUSTOMER_PORTAL_URL=

# Optional local tooling only. Used by `pnpm paddle:provision` to administer
# the Paddle Sandbox catalog. Never use a PUBLIC_ prefix or bundle this key.
# PADDLE_API_KEY=<local-only-sandbox-api-key>
