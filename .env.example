# Paddle Sandbox Configuration
# Copy this file to .env and fill in the values.
# Get these from: https://sandbox-vendors.paddle.com/authentication

PUBLIC_PADDLE_ENVIRONMENT=sandbox
PUBLIC_PADDLE_CLIENT_TOKEN=test_<your-client-side-token>

# Price IDs — set these after running: node scripts/provision-paddle.mjs
PUBLIC_PADDLE_BASIC_MONTHLY_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_BASIC_ANNUAL_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_PRO_ANNUAL_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_MAX_MONTHLY_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_MAX_ANNUAL_PRICE_ID=pri_<replace>
PUBLIC_PADDLE_SETUP_FEE_PRICE_ID=pri_<replace>

# Server-side only (provisioning — do not expose in client code)
# PADDLE_API_KEY=sandbox_<your-api-key>
