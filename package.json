{
	"name": "ringlume",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.15.0",
	"engines": {
		"node": "22.23.5"
	},
	"scripts": {
		"dev": "tinacms dev -c \"astro dev --ignore-lock\"",
		"build": "tinacms build -c \"astro build\"",
		"build:local": "node scripts/build-local.mjs",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "astro preview",
		"preview:local": "wrangler dev --config dist-local/server/wrangler.json --local",
		"test": "vitest run",
		"check": "astro check",
		"astro": "astro"
	},
	"dependencies": {
		"@tinacms/astro": "0.8.0",
		"astro": "7.4.12",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"retell-client-js-sdk": "3.0.3",
		"tailwindcss": "^4.3.2",
		"tinacms": "3.15.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/cloudflare": "14.4.8",
		"@tailwindcss/vite": "^4.3.2",
		"@tinacms/cli": "4.0.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"vitest": "^4.1.12",
		"wrangler": "4.164.0"
	}
}
