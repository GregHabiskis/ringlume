---
import CapabilityCard from './CapabilityCard.astro'

const steps = [
	{
		step: 1,
		kind: 'answer',
		title: 'Answers the call.',
		description: 'Greets callers with your business name, even after hours.',
	},
	{
		step: 2,
		kind: 'capture',
		title: 'Understands the request.',
		description:
			'Uses your business info to answer questions and collect the right details.',
	},
	{
		step: 3,
		kind: 'action',
		title: 'Takes the next step.',
		description:
			'Books an estimate, transfers the call, or takes a message, following your rules.',
	},
] as const
---

<section
	id="capabilities"
	class="scrim content-auto scroll-mt-24 py-16 lg:py-24"
	aria-labelledby="capabilities-heading"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<header
			class="mb-8 flex flex-wrap items-end justify-between gap-3 lg:mb-10"
		>
			<h2
				id="capabilities-heading"
				class="reveal-text max-w-3xl text-h2 font-bold text-fg-1"
			>
				From first ring<br /><span class="text-brand-text"
					>to the right next step.</span
				>
			</h2>
			<span
				class="mb-2 rounded-full border border-line px-3 py-1.5 text-xs text-fg-3"
			>
				Illustrative example
			</span>
		</header>

		<ol
			class="call-journey"
			role="list"
			aria-label="How Ringlume handles a call"
		>
			{steps.map((step) => <CapabilityCard {...step} />)}
		</ol>

		<div
			class="flow-handoff mt-8 flex items-start gap-4 border-t border-line pt-6 sm:mt-10"
		>
			<div
				class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-brand/30 text-brand-text lg:ml-2.5"
				aria-hidden="true"
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M8 3h8l4 4v14H4V3h4Zm8 0v5h4M8 12h8m-8 4h5"></path>
				</svg>
			</div>
			<div class="lg:ml-4">
				<h3 class="font-sans text-sm font-semibold text-fg-1">
					Your team gets the details.
				</h3>
				<p class="mt-2 text-sm leading-relaxed text-fg-3">
					Who called, what they need, and the next steps, in a call summary.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.call-journey {
		position: relative;
		display: grid;
		gap: 2.5rem;
	}

	.call-journey::before {
		content: '';
		position: absolute;
		top: 1.25rem;
		bottom: 0;
		left: 1.125rem;
		border-inline-start: 1px solid
			color-mix(in srgb, var(--brand) 30%, transparent);
	}

	@media (min-width: 1024px) {
		.call-journey {
			gap: 3rem;
		}

		.call-journey::before {
			top: 1.75rem;
			left: 1.75rem;
		}
	}

	@media (prefers-contrast: more) {
		.call-journey::before {
			border-color: var(--brand);
		}
	}
</style>
