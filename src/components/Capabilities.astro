---
import CapabilityCard from './CapabilityCard.astro'

const steps = [
	{
		step: 1,
		kind: 'answer',
		title: 'Answers the call.',
		description: 'Greets callers with your business name, even after hours.',
	},
	{
		step: 2,
		kind: 'capture',
		title: 'Understands the request.',
		description:
			'Uses your business info to answer questions and collect the right details.',
	},
	{
		step: 3,
		kind: 'action',
		title: 'Takes the next step.',
		description:
			'Books an estimate, transfers the call, or takes a message, following your rules.',
	},
] as const
---

<section
	id="capabilities"
	class="scrim content-auto scroll-mt-24 py-16 lg:py-24"
	aria-labelledby="capabilities-heading"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mb-8 lg:mb-10">
			<h2
				id="capabilities-heading"
				class="reveal-text max-w-3xl text-h2 font-bold text-fg-1"
			>
				From first ring<br /><span class="text-brand-text"
					>to the right next step.</span
				>
			</h2>
			<p class="mt-4 text-xs text-fg-3">Illustrative tree-care call flow</p>
		</header>

		<ol
			class="grid gap-10 md:grid-cols-3 md:gap-6 lg:gap-7"
			role="list"
			aria-label="How Ringlume handles a call"
		>
			{steps.map((step) => <CapabilityCard {...step} />)}
		</ol>

		<div class="mt-9 flex items-start gap-4 border-t border-line pt-7 sm:mt-10">
			<div
				class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-line bg-brand/10 text-brand-text"
				aria-hidden="true"
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M8 3h8l4 4v14H4V3h4Zm8 0v5h4M8 12h8m-8 4h5"></path>
				</svg>
			</div>
			<div>
				<h3 class="font-sans text-sm font-semibold text-fg-1">
					Your team gets the details.
				</h3>
				<p class="mt-2 text-sm leading-relaxed text-fg-3">
					Who called, what they need, and the next steps, in a call summary.
				</p>
			</div>
		</div>
	</div>
</section>
