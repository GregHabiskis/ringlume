---
import CapabilityCard from './CapabilityCard.astro'

const capabilities = [
	{
		kind: 'call' as const,
		icon: 'call' as const,
		title: 'Never miss a call',
		description:
			'A natural-sounding virtual receptionist answers instantly after hours, during busy periods, and whenever your team cannot.',
		layoutClass: 'md:col-span-2 lg:col-span-3 lg:row-span-2',
	},
	{
		kind: 'booking' as const,
		icon: 'booking' as const,
		title: 'Books appointments',
		description:
			'Finds the right time and adds it directly to your calendar.',
		layoutClass: 'lg:col-span-3',
	},
	{
		kind: 'follow-up' as const,
		icon: 'follow-up' as const,
		title: 'Follows up automatically',
		description:
			'Sends reminders, follows up with potential customers, and keeps them updated at the right time.',
		layoutClass: 'lg:col-span-3',
	},
	{
		kind: 'knowledge' as const,
		icon: 'knowledge' as const,
		title: 'Knows your business',
		description:
			'Uses your website, services, pricing, FAQs, and approved business information to answer customer questions.',
		layoutClass: 'lg:col-span-2',
	},
	{
		kind: 'handoff' as const,
		icon: 'handoff' as const,
		title: 'Knows when to hand off',
		description:
			'Transfers urgent, sensitive, or high-value calls to the right person.',
		layoutClass: 'lg:col-span-2',
	},
	{
		kind: 'reporting' as const,
		icon: 'reporting' as const,
		title: 'Everything stays visible',
		description:
			'Get call summaries, written call records, customer-record updates, and support for multiple languages automatically.',
		layoutClass: 'md:col-span-2 lg:col-span-2',
	},
]
---

<section
	id="capabilities"
	class="scrim content-auto scroll-mt-16 overflow-hidden py-20 lg:scroll-mt-20 lg:py-32"
	data-capabilities-section
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mb-14 max-w-3xl sm:mb-16 lg:mb-20">
			<p class="eyebrow mb-5 flex items-center gap-2">
				<span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
				Every call, handled
			</p>
			<h2 class="reveal-text text-balance text-h2 font-bold text-fg-1">
				Your best receptionist.<br />
				<span class="text-brand-text">Available 24/7.</span>
			</h2>
			<p class="mt-6 max-w-2xl text-base leading-relaxed text-fg-3 sm:text-lg">
				Answers calls, books appointments, follows up, and keeps your team informed without
				putting customers on hold.
			</p>
		</header>

		<div class="grid grid-cols-1 gap-5 md:auto-rows-[minmax(220px,auto)] md:grid-cols-2 lg:grid-cols-6 lg:gap-6">
			{capabilities.map((capability, index) => (
				<CapabilityCard {...capability} index={index} />
			))}
		</div>
	</div>
</section>

<script>
	const section = document.querySelector('[data-capabilities-section]')
	const cards = section?.querySelectorAll('[data-capability-card]') ?? []
	const prefersReducedMotion = window.matchMedia(
		'(prefers-reduced-motion: reduce)',
	).matches

	if (
		section &&
		!prefersReducedMotion &&
		'IntersectionObserver' in window
	) {
		cards.forEach((card) => card.classList.add('reveal-pending'))

		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return

				cards.forEach((card, index) => {
					card.classList.remove('reveal-pending')
					card.classList.add('reveal-visible')
					window.setTimeout(
						() => card.classList.remove('reveal-visible'),
						550 + index * 65,
					)
				})
				observer.disconnect()
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
		)

		observer.observe(section)
	}
</script>
