---
interface Props {
	step: number
	kind: 'answer' | 'capture' | 'action'
	title: string
	description: string
}

const { step, kind, title, description } = Astro.props
---

<li class="flow-step relative grid min-w-0" data-call-step={kind}>
	<h3
		class="flex min-h-14 items-center gap-3 font-sans text-lg font-semibold leading-snug tracking-tight text-fg-1"
	>
		<span
			class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-xs font-medium tabular-nums text-brand-text"
			aria-hidden="true">{String(step).padStart(2, '0')}</span
		>
		<span>{title}</span>
	</h3>
	<p class="mt-2 mb-5 text-sm leading-relaxed text-fg-3">{description}</p>

	<div
		class="flow-preview glass glass-fill glass-regular glass-card rounded-3xl p-5"
	>
		{
			kind === 'answer' && (
				<>
					<p class="mb-4 flex items-center gap-2 text-xs font-semibold text-fg-1">
						<svg
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							aria-hidden="true"
						>
							<path d="M8 3H5a2 2 0 0 0-2 2c0 8.8 7.2 16 16 16a2 2 0 0 0 2-2v-3l-5-2-2 2a13 13 0 0 1-6-6l2-2-2-5Z" />
						</svg>
						AI receptionist
					</p>
					<div class="rounded-2xl rounded-tl-sm border border-line bg-surface-1/40 px-4 py-3 text-sm leading-relaxed text-fg-2">
						“Example Tree Care. How can I help?”
					</div>
					<div class="mt-3 ml-5 rounded-2xl rounded-tr-sm border border-brand/20 bg-brand/10 px-4 py-3 text-sm leading-relaxed text-fg-2">
						“I’d like an estimate for oak removal.”
					</div>
				</>
			)
		}

		{
			kind === 'capture' && (
				<>
					<p class="mb-4 text-xs font-semibold text-fg-1">Request details</p>
					<dl class="space-y-3 text-xs">
						{[
							['Tree work', 'Oak removal'],
							['Property', 'Address captured'],
							['Contact', 'Name & phone captured'],
						].map(([label, value]) => (
							<div class="border-b border-line pb-3 last:border-b-0 last:pb-0">
								<dt class="text-fg-3">{label}</dt>
								<dd class="mt-1 flex items-center gap-2 font-medium text-fg-1">
									<span
										class="h-1 w-1 shrink-0 rounded-full bg-brand"
										aria-hidden="true"
									/>
									{value}
								</dd>
							</div>
						))}
					</dl>
				</>
			)
		}

		{
			kind === 'action' && (
				<>
					<p class="mb-4 text-xs font-semibold text-fg-1">
						Based on your rules
					</p>
					<ul class="space-y-3" role="list" aria-label="Possible next steps">
						{[
							['Available time', 'Book an estimate'],
							['Needs your team', 'Transfer the call'],
							['Can’t connect', 'Take a message'],
						].map(([condition, action]) => (
							<li class="flex items-start gap-3 border-b border-line pb-3 last:border-b-0 last:pb-0">
								<span class="mt-1 text-brand-text" aria-hidden="true">
									&rarr;
								</span>
								<div>
									<p class="text-xs text-fg-3">{condition}</p>
									<p class="mt-1 text-xs font-medium text-fg-1">{action}</p>
								</div>
							</li>
						))}
					</ul>
				</>
			)
		}
	</div>

	{
		kind !== 'action' && (
			<svg
				class="flow-connector text-fg-3"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M5 12h14m-6-6 6 6-6 6" />
			</svg>
		)
	}
</li>

<style>
	.flow-step {
		grid-template-rows: auto 1fr auto;
	}
	.flow-preview {
		min-height: 280px;
	}
	.flow-connector {
		position: absolute;
		bottom: -28px;
		left: calc(50% - 8px);
		transform: rotate(90deg);
		pointer-events: none;
	}
	@media (min-width: 768px) {
		.flow-connector {
			top: 20px;
			right: -20px;
			bottom: auto;
			left: auto;
			transform: none;
		}
	}
	@media (min-width: 1024px) {
		.flow-connector {
			right: -22px;
		}
	}
</style>
