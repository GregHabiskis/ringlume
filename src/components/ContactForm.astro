---
import { tinaField } from '@tinacms/astro'
const copy = Astro.locals.site.forms.contact
const labelClass = 'block text-sm font-medium text-fg-2 mb-2'
const fieldClass =
  'w-full min-h-11 rounded-xl border border-line bg-surface-2 px-4 py-2.5 text-base text-fg-1 transition-colors hover:border-line-strong focus-visible:border-brand'
---

<form
  name="contact-message"
  method="POST"
  action="/api/contact"
  aria-label={copy.ariaLabel}
  data-tina-field={tinaField(copy, 'ariaLabel')}
  class="glass glass-fill glass-regular glass-card rounded-2xl p-6 sm:p-8 min-w-0"
>
  <input type="hidden" name="form-name" value="contact-message" />

  <div class="hidden" aria-hidden="true">
    <label for="bot-field" data-tina-field={tinaField(copy, 'honeypot')}>{copy.honeypot}</label>
    <input
      id="bot-field"
      name="bot-field"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="space-y-5">
    <div class="min-w-0">
      <label for="email" class={labelClass}>
        <span data-tina-field={tinaField(copy, 'emailLabel')}>{copy.emailLabel}</span> <span class="text-brand-text" aria-hidden="true">*</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class={fieldClass}
      />
    </div>

    <div class="min-w-0">
      <label for="message" class={labelClass}>
        <span data-tina-field={tinaField(copy, 'messageLabel')}>{copy.messageLabel}</span> <span class="text-brand-text" aria-hidden="true">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        maxlength="2000"
        required
        class={`${fieldClass} resize-y`}
      ></textarea>
    </div>
  </div>

  <button data-tina-field={tinaField(copy, 'submitLabel')} type="submit" class="btn btn-primary mt-6 w-full sm:w-auto">
    {copy.submitLabel}
  </button>

  <p class="mt-4 text-xs text-fg-3">
    <span data-tina-field={tinaField(copy, 'consentBefore')}>{copy.consentBefore}</span>
    <a
      data-tina-field={tinaField(copy, 'privacyLabel')} href="/privacy"
      class="text-brand-text underline underline-offset-2 transition-colors hover:text-fg-1"
    >
      {copy.privacyLabel}
    </a><span data-tina-field={tinaField(copy, 'consentAfter')}>{copy.consentAfter}</span>
  </p>
</form>
