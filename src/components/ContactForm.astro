---
const labelClass = 'block text-sm font-medium text-fg-2 mb-2'
const fieldClass =
  'w-full min-h-11 rounded-xl border border-line bg-surface-2 px-4 py-2.5 text-base text-fg-1 transition-colors hover:border-line-strong focus-visible:border-brand'
---

<form
  name="contact-message"
  method="POST"
  action="/contact/thanks"
  data-netlify="true"
  netlify-honeypot="bot-field"
  aria-label="Contact form"
  class="glass glass-regular grain rounded-2xl p-6 sm:p-8 min-w-0"
>
  <input type="hidden" name="form-name" value="contact-message" />

  <div class="hidden" aria-hidden="true">
    <label for="bot-field">Don't fill this out if you're human</label>
    <input
      id="bot-field"
      name="bot-field"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="space-y-5">
    <div class="min-w-0">
      <label for="email" class={labelClass}>
        Email <span class="text-brand-text" aria-hidden="true">*</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class={fieldClass}
      />
    </div>

    <div class="min-w-0">
      <label for="message" class={labelClass}>
        Message <span class="text-brand-text" aria-hidden="true">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        maxlength="2000"
        required
        class={`${fieldClass} resize-y`}
      ></textarea>
    </div>
  </div>

  <button type="submit" class="btn btn-primary mt-6 w-full sm:w-auto">
    Send message
  </button>

  <p class="mt-4 text-xs text-fg-3">
    By submitting you agree to our
    <a
      href="/privacy"
      class="text-brand-text underline underline-offset-2 transition-colors hover:text-fg-1"
    >
      Privacy Policy
    </a>.
  </p>
</form>
