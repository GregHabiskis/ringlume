<section id="contact" class="py-20 lg:py-32 gradient-bg-muted relative overflow-hidden content-auto">
  <!-- Background Elements: desktop-only soft orbs -->
  <div class="absolute inset-0 overflow-hidden hidden md:block" aria-hidden="true">
    <div class="orb orb-sm absolute -top-40 -right-40 w-80 h-80 bg-white/10"></div>
    <div class="orb orb-sm absolute -bottom-40 -left-40 w-80 h-80 bg-white/10"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
      Never Miss Another Call. Ever Again.
    </h2>
    <p class="text-lg text-white/80 max-w-2xl mx-auto mb-10">
      Appointments booked automatically 24/7 while you stay focused running your business.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="https://wa.me/8801951284128"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-white text-green-dark px-8 py-4 rounded-full text-base font-semibold hover:bg-slate-50 transition-colors shadow-lg"
      >
        Contact Us on WhatsApp
      </a>
      <a
        href="mailto:support@ringlume.com"
        class="text-white px-8 py-4 rounded-full text-base font-semibold border-2 border-white/30 hover:bg-white/10 transition-colors"
      >
        Send an Email
      </a>
    </div>
  </div>
</section>
