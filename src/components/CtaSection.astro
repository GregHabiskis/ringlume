---
import { tinaField } from '@tinacms/astro'
const site = Astro.locals.site
const copy = site.pages.home.closingCta
---

<section
	id="contact"
	class="scrim content-auto px-4 pb-16 sm:px-6 lg:px-8 lg:pb-24"
	aria-labelledby="cta-heading"
>
	<div
		class="closing-panel glass glass-fill glass-regular glass-card relative mx-auto grid max-w-7xl gap-8 overflow-hidden rounded-[2rem] px-6 py-10 sm:px-10 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-12 lg:px-14 lg:py-14"
	>
		<div>
			<h2
				id="cta-heading"
				class="reveal-text max-w-2xl text-h2 font-bold text-fg-1"
			>
				<span data-tina-field={tinaField(copy, 'heading')}>{copy.heading}</span><br /><span class="text-brand-text" data-tina-field={tinaField(copy, 'accent')}
					>{copy.accent}</span
				>
			</h2>
		</div>
		<div class="flex flex-col items-stretch gap-3 sm:flex-row lg:flex-col">
			<a href={site.links.freeDemo} class="btn btn-primary" data-tina-field={tinaField(site.links, 'freeDemo')}><span data-tina-field={tinaField(site.shared, 'getFreeDemo')}>{site.shared.getFreeDemo}</span></a>
			<a href={site.links.contact} class="btn btn-quiet" data-tina-field={tinaField(site.links, 'contact')}><span data-tina-field={tinaField(copy, 'contact')}>{copy.contact}</span></a>
		</div>
	</div>
</section>
