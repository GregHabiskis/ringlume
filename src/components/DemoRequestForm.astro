---
import { getReferralOptions, WEBSITE_PATTERN } from '../lib/demo-form'
import { getOffer } from '../lib/offer'
import { formatCopy } from '../lib/tina/site-model'
import { tinaField } from '@tinacms/astro'
const copy = Astro.locals.site.forms.demo
const { demoDeliveryMax } = getOffer(Astro.locals.site.offer)
const referralOptions = getReferralOptions(copy)

const labelClass = 'block text-sm font-medium text-fg-2 mb-2'
const optionalClass = 'ml-1 font-normal text-fg-3'
const fieldClass =
  'w-full min-h-11 rounded-xl border border-line bg-surface-2 px-4 py-2.5 text-base text-fg-1 transition-colors hover:border-line-strong focus-visible:border-brand'
---

<form
  name="demo-request"
  method="POST"
  action="/api/book-demo"
  aria-label={copy.ariaLabel}
  data-tina-field={tinaField(copy, 'ariaLabel')}
  class="glass glass-fill glass-regular glass-card rounded-2xl p-6 sm:p-8 min-w-0"
>
  <input type="hidden" name="form-name" value="demo-request" />

  <div class="hidden" aria-hidden="true">
    <label for="bot-field" data-tina-field={tinaField(copy, 'honeypot')}>{copy.honeypot}</label>
    <input
      id="bot-field"
      name="bot-field"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="min-w-0">
      <label for="first_name" class={labelClass}>
        <span data-tina-field={tinaField(copy, 'firstNameLabel')}>{copy.firstNameLabel}</span> <span class="text-brand-text" aria-hidden="true">*</span>
      </label>
      <input
        id="first_name"
        name="first_name"
        type="text"
        autocomplete="given-name"
        required
        class={fieldClass}
      />
    </div>

    <div class="min-w-0">
      <label for="last_name" class={labelClass}>
        <span data-tina-field={tinaField(copy, 'lastNameLabel')}>{copy.lastNameLabel}</span> <span class="text-brand-text" aria-hidden="true">*</span>
      </label>
      <input
        id="last_name"
        name="last_name"
        type="text"
        autocomplete="family-name"
        required
        class={fieldClass}
      />
    </div>

    <div class="sm:col-span-2 min-w-0">
      <label for="email" class={labelClass}>
        <span data-tina-field={tinaField(copy, 'emailLabel')}>{copy.emailLabel}</span> <span class="text-brand-text" aria-hidden="true">*</span>
      </label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class={fieldClass}
      />
    </div>

    <div class="sm:col-span-2 min-w-0">
      <label for="company_website" class={labelClass}>
        <span data-tina-field={tinaField(copy, 'websiteLabel')}>{copy.websiteLabel}</span>
        <span class="text-brand-text" aria-hidden="true">*</span>
      </label>
      <input
        id="company_website"
        name="company_website"
        type="text"
        inputmode="url"
        autocomplete="url"
        required
        pattern={WEBSITE_PATTERN}
        title={copy.websiteTitle}
        data-tina-field={tinaField(copy, 'websiteTitle')}
        class={fieldClass}
      />
    </div>

    <div class="min-w-0">
      <label for="phone" class={labelClass}>
        <span data-tina-field={tinaField(copy, 'phoneLabel')}>{copy.phoneLabel}</span> <span class={optionalClass} data-tina-field={tinaField(copy, 'optionalLabel')}>{copy.optionalLabel}</span>
      </label>
      <input
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        class={fieldClass}
      />
    </div>

    <div class="min-w-0">
      <label for="referral_source" class={labelClass}>
        <span data-tina-field={tinaField(copy, 'referralLabel')}>{copy.referralLabel}</span>
        <span class={optionalClass} data-tina-field={tinaField(copy, 'optionalLabel')}>{copy.optionalLabel}</span>
      </label>
      <select
        id="referral_source"
        name="referral_source"
        class={fieldClass}
      >
        <option value="" data-tina-field={tinaField(copy, 'referralPlaceholder')}>{copy.referralPlaceholder}</option>
        {referralOptions.map((option) => <option value={option.value} data-tina-field={tinaField(copy, option.key)}>{option.label}</option>)}
      </select>
    </div>
  </div>

  <button data-tina-field={tinaField(copy, 'submitLabel')} type="submit" class="btn btn-primary mt-6 w-full sm:w-auto">
    {copy.submitLabel}
  </button>

  <p class="mt-4 text-xs text-fg-3">
    <span data-tina-field={tinaField(copy, 'delivery')}>{formatCopy(copy.delivery, { deliveryMax: demoDeliveryMax })}</span><span data-tina-field={tinaField(copy, 'consentBefore')}>{copy.consentBefore}</span><a href="/terms" class="text-brand-text underline underline-offset-2 transition-colors hover:text-fg-1" data-tina-field={tinaField(copy, 'termsLabel')}>{copy.termsLabel}</a><span data-tina-field={tinaField(copy, 'consentBetween')}>{copy.consentBetween}</span><a href="/privacy" class="text-brand-text underline underline-offset-2 transition-colors hover:text-fg-1" data-tina-field={tinaField(copy, 'privacyLabel')}>{copy.privacyLabel}</a><span data-tina-field={tinaField(copy, 'consentAfter')}>{copy.consentAfter}</span>
  </p>
</form>

<style>
	/* Enhance supported desktop/mobile browsers; keep the native fallback. */
	@supports (appearance: base-select) and selector(::picker(select)) {
		@media (forced-colors: none) {
			#referral_source,
			#referral_source::picker(select) {
				appearance: base-select;
			}

			#referral_source::picker(select) {
				max-inline-size: calc(100vw - 2rem);
				border: 1px solid var(--line-strong);
				border-radius: 0.75rem;
				padding: 0.25rem;
				background: var(--color-surface-2);
				color: var(--fg-1);
			}

			#referral_source option {
				border-radius: 0.5rem;
				padding: 0.375rem 0.75rem;
			}
		}
	}
</style>
