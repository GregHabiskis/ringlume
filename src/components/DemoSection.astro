---
import { getRetellConfig } from '../lib/retell-config'
import { tinaField } from '@tinacms/astro'

const retell = getRetellConfig()
const site = Astro.locals.site
const copy = site.demo
---

{
	retell && (
		<aside
			id="demo"
			class="voice-console glass glass-fill glass-regular glass-card relative scroll-mt-24 overflow-hidden rounded-[2rem]"
			aria-labelledby="demo-heading"
			data-retell-public-key={retell.voicePublicKey}
			data-retell-agent-id={retell.voiceAgentId}
			data-retell-recaptcha-key={retell.recaptchaKey}
			data-demo-copy={JSON.stringify(copy)}
			data-demo-fields={JSON.stringify({
				text: Object.fromEntries(Object.keys(copy.text).map(key => [key, tinaField(copy.text, key as keyof typeof copy.text)])),
				messages: Object.fromEntries(Object.keys(copy.messages).map(key => [key, tinaField(copy.messages, key as keyof typeof copy.messages)])),
			})}
		>
			<div class="flex items-center justify-between gap-4 border-b border-line px-6 py-5 sm:px-8">
				<h2 id="demo-heading" class="font-sans text-sm font-semibold text-fg-1" data-demo-text="heading" data-tina-field={tinaField(copy.text, 'heading')}>
					{copy.text.heading}
				</h2>
				<span class="flex items-center gap-2 text-xs text-fg-3">
					<span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true" />
					<span data-demo-connection data-tina-field={tinaField(copy.text, 'idle')}>{copy.text.idle}</span>
				</span>
			</div>
			<div class="signal-stage" aria-hidden="true">
				<div class="hero-rings">
					<>
						<span class="hero-ring" />
						<span class="hero-ring" />
						<span class="hero-ring" />
					</>
				</div>
				<div class="signal-lens">
					<div class="signal-core">
						{[14, 25, 38, 21, 46, 30, 18].map((height, index) => (
							<span
								style={`height: ${height}px; --wave-delay: ${index * -0.23}s; --wave-duration: ${1.6 + (index % 3) * 0.3}s`}
							/>
						))}
					</div>
				</div>
			</div>
			<div class="relative px-6 pb-7 text-center sm:px-8 sm:pb-8">
				<p class="mb-5 text-sm text-fg-2" data-demo-text="description" data-tina-field={tinaField(copy.text, 'description')}>
					{copy.text.description}
				</p>
				<div class="demo-controls">
					<div data-demo-start-controls class="flex gap-3">
						<button
							type="button"
							data-demo-open
							class="btn btn-primary min-w-0 flex-1 disabled:opacity-60"
							aria-describedby="demo-call-help"
							disabled
						>
							<svg
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="1.7"
								stroke-linecap="round"
								viewBox="0 0 24 24"
								aria-hidden="true"
							>
								<path d="M8 3H5a2 2 0 0 0-2 2c0 8.8 7.2 16 16 16a2 2 0 0 0 2-2v-3l-5-2-2 2a13 13 0 0 1-6-6l2-2-2-5Z" />
							</svg>
							<span data-demo-label data-tina-field={tinaField(copy.text, 'start')}>{copy.text.start}</span>
						</button>
						<button
							type="button"
							data-demo-cancel
							data-demo-text="cancel"
							data-tina-field={tinaField(copy.text, 'cancel')}
							class="btn btn-secondary"
							hidden
						>
							{copy.text.cancel}
						</button>
					</div>
					<div data-demo-live class="grid grid-cols-2 gap-3" hidden>
						<button
							type="button"
							data-demo-mute
							class="btn btn-secondary"
							aria-pressed="false"
							aria-label={copy.text.muteLabel}
							data-tina-field={tinaField(copy.text, 'mute')}
						>
							{copy.text.mute}
						</button>
						<button type="button" data-demo-end class="btn demo-end" data-demo-text="end" data-tina-field={tinaField(copy.text, 'end')}>
							{copy.text.end}
						</button>
					</div>
				</div>
				<div class="flex min-h-11 items-center justify-center">
					<p id="demo-call-help" class="text-xs leading-relaxed text-fg-3" data-demo-text="help" data-tina-field={tinaField(copy.text, 'help')}>
						{copy.text.help}
					</p>
					<button
						type="button"
						data-demo-audio
						data-demo-text="audio"
						data-tina-field={tinaField(copy.text, 'audio')}
						class="min-h-11 text-xs text-fg-3 underline underline-offset-4 hover:text-fg-1"
						hidden
					>
						{copy.text.audio}
					</button>
				</div>
				<p
					data-demo-status
					data-tina-field={tinaField(copy.text, 'hint')}
					role="status"
					aria-atomic="true"
					class="demo-status mt-3 text-sm leading-relaxed text-fg-2"
				>
					{copy.text.hint}
				</p>
				<noscript>
					<p class="mt-3 text-sm text-fg-3" data-demo-text="noScript" data-tina-field={tinaField(copy.text, 'noScript')}>
						{copy.text.noScript}
					</p>
				</noscript>
			</div>
			<div class="border-t border-line px-5 py-4 text-center">
				<a
					href={site.links.freeDemo}
					data-site-link="freeDemo"
					data-tina-field={tinaField(site.links, 'freeDemo')}
					class="text-xs text-fg-3 underline underline-offset-4 hover:text-fg-1"
				>
					<span data-demo-text="personalizedDemo" data-tina-field={tinaField(copy.text, 'personalizedDemo')}>{copy.text.personalizedDemo}</span>
				</a>
			</div>
		</aside>
	)
}

<style>
	/* Author display utilities must not override the native hidden attribute. */
	[hidden] {
		display: none !important;
	}
	.demo-controls {
		min-height: 52px;
	}
	.demo-status {
		min-height: 2.5em;
	}
	.demo-end {
		border: 1px solid var(--danger);
		color: var(--fg-1);
		background: color-mix(in srgb, var(--danger) 25%, var(--bg-base));
	}
	.demo-end:hover {
		background: color-mix(in srgb, var(--danger) 40%, var(--bg-base));
	}
	[data-demo-connection] {
		font-variant-numeric: tabular-nums;
	}
	.signal-stage {
		position: relative;
		display: grid;
		height: 245px;
		place-items: center;
		overflow: hidden;
	}
	.signal-lens {
		position: relative;
		display: grid;
		width: 174px;
		aspect-ratio: 1;
		place-items: center;
		border-radius: 50%;
	}
	.signal-lens::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: conic-gradient(
			from 25deg,
			var(--glass-edge-lo),
			var(--brand-deep),
			var(--bg-alt),
			var(--brand-bright),
			var(--glass-edge-hi),
			var(--bg-alt),
			var(--glass-edge-lo)
		);
		box-shadow:
			inset 0 1px 2px var(--fg-2),
			inset 0 -2px 8px var(--brand-deep),
			0 16px 32px -20px var(--brand-ink);
		animation: signal-orbit 18s linear infinite;
	}
	.signal-core {
		position: relative;
		display: flex;
		width: 146px;
		aspect-ratio: 1;
		align-items: center;
		justify-content: center;
		gap: 5px;
		border-radius: 50%;
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--fg-1) 14%, var(--bg-alt)),
			var(--bg-base) 65%
		);
		box-shadow:
			inset 0 1px 1px var(--glass-edge-hi),
			inset 0 -1px 1px var(--brand-deep);
	}
	.signal-core span {
		width: 4px;
		border-radius: 10px;
		background: linear-gradient(var(--fg-1), var(--brand));
		transform-origin: center;
		animation: signal-wave var(--wave-duration) ease-in-out var(--wave-delay)
			infinite;
	}
	@keyframes signal-orbit {
		to {
			transform: rotate(1turn);
		}
	}
	@keyframes signal-wave {
		0%,
		100% {
			transform: scaleY(0.4);
			opacity: 0.75;
		}
		30% {
			transform: scaleY(1);
			opacity: 1;
		}
		60% {
			transform: scaleY(0.55);
			opacity: 0.85;
		}
		80% {
			transform: scaleY(0.8);
			opacity: 1;
		}
	}
	.hero-rings {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.hero-ring {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 300px;
		height: 300px;
		margin: -150px;
		border: 1px solid var(--brand);
		border-radius: 50%;
		opacity: 0;
		animation: ring-expand 8s linear infinite;
	}
	.hero-ring:nth-child(2) {
		animation-delay: -2.7s;
	}
	.hero-ring:nth-child(3) {
		animation-delay: -5.4s;
	}
	@keyframes ring-expand {
		0% {
			transform: scale(0.55);
			opacity: 0;
		}
		20% {
			opacity: 0.2;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}
	:global(html.is-paused) .hero-ring,
	:global(html.is-paused) .signal-lens::before,
	:global(html.is-paused) .signal-core span {
		animation-play-state: paused;
	}
	@media (min-width: 640px) {
		.signal-stage {
			height: 265px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.signal-lens::before,
		.signal-core span {
			animation: none;
		}
		.hero-ring {
			animation: none;
			opacity: 0.12;
		}
		.hero-ring:nth-child(2) {
			transform: scale(1.25);
		}
		.hero-ring:nth-child(3) {
			transform: scale(1.5);
		}
	}
</style>

<script>
	import {
		createDemoController,
		formatDemoTime,
		type DemoPhase,
		type DemoState,
		type DemoCopy,
	} from '../lib/retell-demo'
	import { loadRetellClient, prepareRetellCall } from '../lib/retell-browser'
	import { formatCopy } from '../lib/tina/site-model'

	function initDemo(section: HTMLElement): void {
		let copy: DemoCopy = JSON.parse(section.dataset.demoCopy!)
		const fields: Record<'text' | 'messages', Record<string, string>> = JSON.parse(section.dataset.demoFields!)
		function mark(element: HTMLElement, group: 'text' | 'messages', key: string): void {
			if (fields[group][key]) element.setAttribute('data-tina-field', fields[group][key])
		}
		const publicKey = section.dataset.retellPublicKey
		const agentId = section.dataset.retellAgentId
		if (!publicKey || !agentId) return
		const start = section.querySelector<HTMLButtonElement>('[data-demo-open]')!
		const startControls = section.querySelector<HTMLElement>(
			'[data-demo-start-controls]',
		)!
		const label = section.querySelector<HTMLElement>('[data-demo-label]')!
		const cancel = section.querySelector<HTMLButtonElement>(
			'[data-demo-cancel]',
		)!
		const liveControls = section.querySelector<HTMLElement>('[data-demo-live]')!
		const mute = section.querySelector<HTMLButtonElement>('[data-demo-mute]')!
		const end = section.querySelector<HTMLButtonElement>('[data-demo-end]')!
		const help = section.querySelector<HTMLElement>('#demo-call-help')!
		const audio = section.querySelector<HTMLButtonElement>('[data-demo-audio]')!
		const status = section.querySelector<HTMLElement>('[data-demo-status]')!
		const connection = section.querySelector<HTMLElement>(
			'[data-demo-connection]',
		)!
		let phase: DemoPhase = 'idle'
		let connectedAt = 0
		let timer: ReturnType<typeof setInterval> | undefined
		function liveLabel(): string {
			return formatCopy(copy.text.live, { time: formatDemoTime((Date.now() - connectedAt) / 1000) })
		}

		function render(state: DemoState): void {
			const previous = phase
			const wasFocused = section.contains(document.activeElement)
			const focusedControl = document.activeElement as HTMLElement | null
			phase = state.phase
			const live = phase === 'live'
			const connecting = phase === 'connecting'
			startControls.hidden = live
			start.disabled = connecting
			start.setAttribute('aria-busy', String(connecting))
			label.textContent = connecting ? copy.text.connecting : copy.text.start
			mark(label, 'text', connecting ? 'connecting' : 'start')
			cancel.hidden = !connecting
			liveControls.hidden = !live
			help.hidden = live
			audio.hidden = !live
			mute.textContent = state.muted ? copy.text.unmute : copy.text.mute
			mark(mute, 'text', state.muted ? 'unmute' : 'mute')
			mute.setAttribute('aria-pressed', String(state.muted))
			mute.setAttribute(
				'aria-label',
				state.muted ? copy.text.unmuteLabel : copy.text.muteLabel,
			)
			const message = state.messageKey ? copy.messages[state.messageKey] : copy.text.hint
			if (status.textContent !== message) status.textContent = message
			mark(status, state.messageKey ? 'messages' : 'text', state.messageKey ?? 'hint')
			mark(connection, 'text', live ? 'live' : phase)
			if (live && previous !== 'live') {
				connectedAt = Date.now()
				const tick = () => {
					connection.textContent = liveLabel()
				}
				tick()
				timer = setInterval(tick, 1000)
			} else if (phase === 'live') {
				connection.textContent = liveLabel()
			} else {
				clearInterval(timer)
				timer = undefined
				const labels = {
					idle: copy.text.idle,
					connecting: copy.text.connecting,
					ended: copy.text.ended,
					error: copy.text.error,
				}
				connection.textContent = labels[phase]
			}
			// Move focus only when the control the visitor was using disappears.
			if (
				wasFocused &&
				(focusedControl?.closest('[hidden]') ||
					(focusedControl === start && connecting))
			) {
				if (connecting) cancel.focus({ preventScroll: true })
				else if (live) end.focus({ preventScroll: true })
				else start.focus({ preventScroll: true })
			}
		}

		const controller = createDemoController({
			copy,
			agentId,
			loadClient: () => loadRetellClient(publicKey),
			prepare: () => prepareRetellCall(section.dataset.retellRecaptchaKey),
			onChange: render,
		})
		window.addEventListener('ringlume:copy-change', ((event: CustomEvent<{ demo?: DemoCopy }>) => {
			if (!event.detail.demo) return
			copy = event.detail.demo
			section.querySelectorAll<HTMLElement>('[data-demo-text]').forEach((element) => {
				const key = element.dataset.demoText as keyof DemoCopy['text']
				element.textContent = copy.text[key]
			})
			controller.setCopy(copy)
		}) as EventListener)
		start.addEventListener('click', () => void controller.start())
		cancel.addEventListener('click', controller.end)
		end.addEventListener('click', controller.end)
		mute.addEventListener('click', controller.toggleMute)
		audio.addEventListener('click', () => void controller.enableAudio())
		window.addEventListener('offline', controller.offline)
		window.addEventListener('pagehide', controller.end)
		start.disabled = false
	}

	const section = document.getElementById('demo')
	if (section) initDemo(section)
</script>
