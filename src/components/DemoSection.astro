---
import { getRetellConfig } from '../lib/retell-config'

const retell = getRetellConfig()
---

{
	retell && (
		<aside
			id="demo"
			class="voice-console glass glass-fill glass-regular glass-card relative scroll-mt-24 overflow-hidden rounded-[2rem]"
			aria-labelledby="demo-heading"
			data-retell-public-key={retell.voicePublicKey}
			data-retell-agent-id={retell.voiceAgentId}
			data-retell-recaptcha-key={retell.recaptchaKey}
		>
			<div class="flex items-center justify-between gap-4 border-b border-line px-6 py-5 sm:px-8">
				<h2 id="demo-heading" class="font-sans text-sm font-semibold text-fg-1">
					Live voice demo
				</h2>
				<span class="flex items-center gap-2 text-xs text-fg-3">
					<span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true" />
					Try it yourself
				</span>
			</div>
			<div class="signal-stage" aria-hidden="true">
				<div class="hero-rings">
					<>
						<span class="hero-ring" />
						<span class="hero-ring" />
						<span class="hero-ring" />
					</>
				</div>
				<div class="signal-lens">
					<div class="signal-core">
						{[14, 25, 38, 21, 46, 30, 18].map((height, index) => (
							<span
								style={`height: ${height}px; --wave-delay: ${index * -0.23}s; --wave-duration: ${1.6 + (index % 3) * 0.3}s`}
							/>
						))}
					</div>
				</div>
			</div>
			<div class="relative px-6 pb-7 text-center sm:px-8 sm:pb-8">
				<p class="mb-5 text-sm text-fg-2">
					A real conversation. Not a recording.
				</p>
				<button
					type="button"
					data-demo-open
					class="btn btn-primary w-full disabled:opacity-60"
					aria-describedby="demo-call-help"
				>
					<svg
						width="18"
						height="18"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path d="M8 3H5a2 2 0 0 0-2 2c0 8.8 7.2 16 16 16a2 2 0 0 0 2-2v-3l-5-2-2 2a13 13 0 0 1-6-6l2-2-2-5Z" />
					</svg>
					<span data-demo-label>Try it now</span>
				</button>
				<p id="demo-call-help" class="mt-3 text-xs leading-relaxed text-fg-3">
					Opens the call panel. Microphone required to speak.
				</p>
				<p class="mt-4 text-xs text-fg-3">
					Try asking: &ldquo;Can I book an appointment?&rdquo;
				</p>
				<p data-demo-status role="status" class="mt-3 text-sm text-fg-2" />
				<noscript>
					<p class="mt-3 text-sm text-fg-3">
						Enable JavaScript to use the live demo.
					</p>
				</noscript>
			</div>
			<div class="border-t border-line px-5 py-4 text-center">
				<a
					href="/book-demo"
					class="text-xs text-fg-3 underline underline-offset-4 hover:text-fg-1"
				>
					Get your free personalized demo
				</a>
			</div>
		</aside>
	)
}

<style>
	.signal-stage {
		position: relative;
		display: grid;
		height: 245px;
		place-items: center;
		overflow: hidden;
	}
	.signal-lens {
		position: relative;
		display: grid;
		width: 174px;
		aspect-ratio: 1;
		place-items: center;
		border-radius: 50%;
	}
	.signal-lens::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: conic-gradient(
			from 25deg,
			var(--glass-edge-lo),
			var(--brand-deep),
			var(--bg-alt),
			var(--brand-bright),
			var(--glass-edge-hi),
			var(--bg-alt),
			var(--glass-edge-lo)
		);
		box-shadow:
			inset 0 1px 2px var(--fg-2),
			inset 0 -2px 8px var(--brand-deep),
			0 16px 32px -20px var(--brand-ink);
		animation: signal-orbit 18s linear infinite;
	}
	.signal-core {
		position: relative;
		display: flex;
		width: 146px;
		aspect-ratio: 1;
		align-items: center;
		justify-content: center;
		gap: 5px;
		border-radius: 50%;
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--fg-1) 14%, var(--bg-alt)),
			var(--bg-base) 65%
		);
		box-shadow:
			inset 0 1px 1px var(--glass-edge-hi),
			inset 0 -1px 1px var(--brand-deep);
	}
	.signal-core span {
		width: 4px;
		border-radius: 10px;
		background: linear-gradient(var(--fg-1), var(--brand));
		transform-origin: center;
		animation: signal-wave var(--wave-duration) ease-in-out var(--wave-delay)
			infinite;
	}
	@keyframes signal-orbit {
		to {
			transform: rotate(1turn);
		}
	}
	@keyframes signal-wave {
		0%,
		100% {
			transform: scaleY(0.4);
			opacity: 0.75;
		}
		30% {
			transform: scaleY(1);
			opacity: 1;
		}
		60% {
			transform: scaleY(0.55);
			opacity: 0.85;
		}
		80% {
			transform: scaleY(0.8);
			opacity: 1;
		}
	}
	.hero-rings {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.hero-ring {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 300px;
		height: 300px;
		margin: -150px;
		border: 1px solid var(--brand);
		border-radius: 50%;
		opacity: 0;
		animation: ring-expand 8s linear infinite;
	}
	.hero-ring:nth-child(2) {
		animation-delay: -2.7s;
	}
	.hero-ring:nth-child(3) {
		animation-delay: -5.4s;
	}
	@keyframes ring-expand {
		0% {
			transform: scale(0.55);
			opacity: 0;
		}
		20% {
			opacity: 0.2;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}
	:global(html.is-paused) .hero-ring,
	:global(html.is-paused) .signal-lens::before,
	:global(html.is-paused) .signal-core span {
		animation-play-state: paused;
	}
	@media (min-width: 640px) {
		.signal-stage {
			height: 265px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.signal-lens::before,
		.signal-core span {
			animation: none;
		}
		.hero-ring {
			animation: none;
			opacity: 0.12;
		}
		.hero-ring:nth-child(2) {
			transform: scale(1.25);
		}
		.hero-ring:nth-child(3) {
			transform: scale(1.5);
		}
	}
</style>

<script>
	const RETELL_SCRIPT_ID = 'retell-widget'
	const RETELL_SRC = 'https://dashboard.retellai.com/retell-widget-v2.js'
	const RETELL_TITLE = "Talk to Ringlume's Virtual receptionist"
	const RETELL_FAB_TEXT = 'Try it now'
	const OPEN_LABEL = 'Try it now'
	const BUSY_LABEL = 'Connecting…'
	const MAX_WAIT_MS = 8000

	// Retell's public key is domain-restricted in the Retell dashboard.
	// Keep this in sync with that list: on any other origin
	// POST /v3/create-web-call returns 401 and the widget fails silently
	// (panel opens, timer stays 00:00, agent never speaks).
	const ALLOWED_ORIGINS = ['https://ringlume.com', 'https://www.ringlume.com']

	const CLOSED_FAB_SELECTOR =
		'button[aria-label="Open Assistant"], button[title="Assistant"]'
	const OPEN_PANEL_SELECTOR =
		'button[aria-label="Minimize window"], button[aria-label="Return to active call"]'
	const STYLE_OVERRIDE_ID = 'ringlume-retell-overrides'
	const POLL_MS = 150

	type RetellConfig = {
		publicKey: string
		agentId: string
		recaptchaKey: string
	}

	let injected = false
	let opening = false

	function readConfig(): RetellConfig | null {
		const section = document.getElementById('demo')
		if (!section) return null

		const publicKey = section.dataset.retellPublicKey?.trim()
		const agentId = section.dataset.retellAgentId?.trim()
		if (!publicKey || !agentId) return null

		return {
			publicKey,
			agentId,
			recaptchaKey: section.dataset.retellRecaptchaKey?.trim() ?? '',
		}
	}

	function isOpen(): boolean {
		return Boolean(queryWidget(OPEN_PANEL_SELECTOR))
	}

	// Retell renders its whole UI inside a shadow root, so a plain
	// document.querySelector() never sees the FAB or the panel.
	function widgetRoot(): ShadowRoot | null {
		const host = document.getElementById('retell-widget-root')
		const candidate = host?.firstElementChild ?? host
		const root = candidate?.shadowRoot ?? findAnyShadowRoot()
		if (root) applyOverrides(root)
		return root
	}

	function findAnyShadowRoot(): ShadowRoot | null {
		for (const el of document.querySelectorAll('div')) {
			if (el.shadowRoot) return el.shadowRoot
		}
		return null
	}

	function applyOverrides(root: ShadowRoot): void {
		if (root.getElementById(STYLE_OVERRIDE_ID)) return

		const style = document.createElement('style')
		style.id = STYLE_OVERRIDE_ID
		// Keep CSS compact so Astro can inline this script without another request.
		style.textContent = [
			/* Retell hardcodes the subtitle and only drops it behind their
			   white-label token, so suppress it locally instead. */
			'[class*="_brandSubtitle_"]{display:none!important}',
			/* Retell left-aligns the brand title; keep it centred at every
			   breakpoint so it matches the avatar and the Start-to-call
			   button, and give it the pricing-card heading treatment
			   (foreground colour, bold). */
			'[class*="_brandTitle_"]{text-align:center!important;color:var(--fg-1)!important;font-weight:700!important}',
			/* The widget card now wears the site's pricing-card material:
			   `.glass-fill .glass-regular` = one 8% white fill over the dark
			   page + the 1px diagonal edge ring + the contact shadow.
			   Retell's surface was a white shell inside a navy rim, so the
			   rim carries the material and the inner shell goes transparent
			   (single fill layer = same composite as the cards). */
			'[class*="_window_"]{background:rgba(13,17,26,0.72)!important;box-shadow:inset 1px 1px 0 0 var(--glass-edge-hi),inset -1px -1px 0 0 var(--glass-edge-lo),inset 0 1px 0 var(--glass-specular),var(--shadow-contact)!important}',
			'[class*="_innerShell_"]{background:transparent!important}',
			/* Surface controls on the dark card. */
			'[class*="_voiceTimer_"]{color:var(--fg-3)!important}',
			'[class*="_closeButton_"]{background:rgba(13,17,26,0.6)!important;color:var(--fg-2)!important}',
			'[class*="_closeButton_"]:hover{background:rgba(18,23,34,0.75)!important;color:var(--fg-1)!important}',
			/* Start-to-call mirrors the site's primary CTA (.btn-primary). */
			'[class*="_startCallButton_"]{background:var(--grad-cta)!important;color:var(--fg-1)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,0.28),inset 0 -8px 16px -12px rgba(2,20,12,0.55),var(--glow-brand),var(--shadow-contact)!important}',
			/* Any chat-variant text shares the dark shell, so swap Retell's
			   navy-on-white palette for the site's foreground tokens. */
			'[class*="_brandText_"],[class*="_title_"]{color:var(--fg-1)!important}',
			'[class*="_subtitle_"]{color:var(--fg-3)!important}',
			/* The delayed greeting ignores Retell's theme and defaults to white.
			   Match its minimized button; scope text overrides to this popup. */
			'[class*=_popup_] [class*=_bubble_]{background:var(--color-theme)}',
			'[class*=_popup_] [class]{color:var(--fg-1)}',
			/* Site typeface everywhere (Retell defaults to Inter). */
			':host{--font-family:"Plus Jakarta Sans","Jakarta Fallback",system-ui,sans-serif!important}',
		].join('')
		root.appendChild(style)
	}

	function queryWidget<T extends Element>(selector: string): T | null {
		return (
			widgetRoot()?.querySelector<T>(selector) ??
			document.querySelector<T>(selector)
		)
	}

	function warnIfOriginNotAllowed(): void {
		if (ALLOWED_ORIGINS.includes(window.location.origin)) return
		console.warn(
			`[Ringlume demo] ${window.location.origin} is not on Retell's allowed-domain list for this public key. ` +
				'The demo UI will open but create-web-call will return 401 and the agent stays silent. ' +
				`Add this origin in the Retell dashboard (Settings → Allowed domains) or test on ${ALLOWED_ORIGINS.join(' / ')}.`,
		)
	}

	function inject(config: RetellConfig): void {
		if (injected || document.getElementById(RETELL_SCRIPT_ID)) {
			injected = true
			return
		}

		const tag = document.createElement('script')
		tag.id = RETELL_SCRIPT_ID
		tag.src = RETELL_SRC
		tag.type = 'module'
		tag.dataset.voicePublicKey = config.publicKey
		tag.dataset.voiceAgentId = config.agentId
		tag.dataset.title = RETELL_TITLE
		tag.dataset.fabText = RETELL_FAB_TEXT
		tag.dataset.botName = 'Ringlume'
		tag.dataset.logoUrl = '/images/logo-240.webp'
		tag.dataset.themeColor = '#0A1120'
		tag.dataset.componentColor = '#269635'
		tag.dataset.showAiPopup = 'true'
		tag.dataset.showAiPopupTime = '8'
		tag.dataset.popupMessage =
			"Hi! I'm Ringlume's Virtual receptionist. Ask me anything."

		if (config.recaptchaKey) {
			const recaptcha = document.createElement('script')
			recaptcha.src = `https://www.google.com/recaptcha/api.js?render=${config.recaptchaKey}`
			recaptcha.async = true
			document.head.appendChild(recaptcha)
			tag.dataset.recaptchaKey = config.recaptchaKey
		}

		tag.addEventListener(
			'error',
			() => {
				injected = false
				tag.remove()
			},
			{ once: true },
		)

		document.head.appendChild(tag)
		injected = true
	}

	function waitForFab(
		timeoutMs = MAX_WAIT_MS,
	): Promise<HTMLButtonElement | null> {
		return new Promise((resolve) => {
			// Shadow-root mutations never reach a document observer, so poll.
			const started = Date.now()

			function tick(): void {
				const fab = queryWidget<HTMLButtonElement>(CLOSED_FAB_SELECTOR)
				if (fab) {
					resolve(fab)
					return
				}
				if (Date.now() - started >= timeoutMs) {
					resolve(null)
					return
				}
				window.setTimeout(tick, POLL_MS)
			}

			tick()
		})
	}

	function setBusy(button: HTMLButtonElement, busy: boolean): void {
		const label = button.querySelector<HTMLElement>('[data-demo-label]')
		button.disabled = busy
		button.setAttribute('aria-busy', String(busy))
		if (label) label.textContent = busy ? BUSY_LABEL : OPEN_LABEL
	}

	async function openDemo(button: HTMLButtonElement): Promise<void> {
		if (opening || isOpen()) return

		const config = readConfig()
		if (!config) return

		opening = true
		setBusy(button, true)
		const status = document.querySelector<HTMLElement>('[data-demo-status]')
		if (status) status.textContent = ''
		warnIfOriginNotAllowed()

		try {
			inject(config)
			const fab = await waitForFab()
			if (fab && !isOpen()) fab.click()
			if (!fab && !isOpen() && status) {
				status.textContent =
					'The demo could not load. Please try again or request a personalized demo below.'
			}
		} catch {
			if (status)
				status.textContent = 'The demo could not load. Please try again.'
		} finally {
			opening = false
			setBusy(button, false)
		}
	}

	document
		.querySelectorAll<HTMLButtonElement>('[data-demo-open]')
		.forEach((button) => {
			button.addEventListener('click', () => void openDemo(button))
		})
</script>
