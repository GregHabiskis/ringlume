---
import { faqItems, type FaqId, type FaqItem } from '../data/faqs'

interface Props {
	faqIds?: readonly FaqId[]
	headingLevel?: 'h1' | 'h2'
	showAllLink?: boolean
}

const {
	faqIds,
	headingLevel = 'h2',
	showAllLink = false,
} = Astro.props

const faqs = faqIds
	? faqIds
			.map((id) => faqItems.find((faq) => faq.id === id))
			.filter((faq): faq is FaqItem => faq !== undefined)
	: faqItems
---

<section
	id="faq"
	class="scrim scroll-mt-16 overflow-hidden py-20 content-auto lg:scroll-mt-20 lg:py-32"
	aria-labelledby="faq-heading"
	data-faq
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mx-auto mb-12 max-w-3xl text-center sm:mb-16">
			{headingLevel === 'h1' ? (
				<h1 id="faq-heading" class="text-h2 font-bold text-fg-1">
					Frequently Asked <span class="gradient-green-text">Questions</span>
				</h1>
			) : (
				<h2 id="faq-heading" class="text-h2 font-bold text-fg-1">
					Frequently Asked <span class="gradient-green-text">Questions</span>
				</h2>
			)}
		</header>

		<div class="glass glass-thick grain mx-auto max-w-4xl overflow-hidden rounded-3xl">
			{faqs.map((faq) => {
				const questionId = `faq-question-${faq.id}`
				const answerId = `faq-answer-${faq.id}`

				return (
					<div class="faq-item border-b border-line last:border-b-0" data-faq-item>
						<h3 class="m-0">
							<button
								type="button"
								id={questionId}
								class="flex min-h-16 w-full min-w-0 items-center justify-between gap-4 px-5 py-5 text-left text-base font-semibold leading-relaxed text-fg-1 transition-colors hover:bg-fg-1/[0.04] sm:px-7 sm:py-6 sm:text-lg"
								aria-expanded="false"
								aria-controls={answerId}
								data-faq-trigger
							>
								<span class="min-w-0 break-words">{faq.question}</span>
								<svg
									class="h-5 w-5 flex-none text-brand-text transition-transform duration-200 motion-reduce:transition-none"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									aria-hidden="true"
									data-faq-icon
								>
									<path d="M12 5v14M5 12h14" />
								</svg>
							</button>
						</h3>

						<div
							id={answerId}
							class="faq-answer"
							data-faq-answer
							data-open="false"
							hidden
						>
							<div class="min-h-0 overflow-hidden px-5 pb-6 pr-14 text-sm leading-relaxed text-fg-2 sm:px-7 sm:pb-7 sm:pr-16 sm:text-base">
								{faq.linkedParagraphs?.map((paragraph) => (
									<p class="mb-4 last:mb-0">
										{paragraph.before}
										<a
											href={paragraph.href}
											class="text-brand-text underline underline-offset-2 hover:opacity-80"
										>
											{paragraph.linkText}
										</a>
										{paragraph.after}
									</p>
								))}

								{faq.paragraphs?.map((paragraph) => (
									<p class="mb-4 last:mb-0">{paragraph}</p>
								))}

								{faq.list && (
									<ul class="mt-4 list-disc space-y-2 pl-5 marker:text-brand-text">
										{faq.list.map((item) => <li>{item}</li>)}
									</ul>
								)}
							</div>
						</div>
					</div>
				)
			})}
		</div>

		{showAllLink && (
			<div class="mt-8 text-center">
				<a
					href="/faq"
					class="btn btn-primary"
				>
					View all FAQs
					<span aria-hidden="true">&rarr;</span>
				</a>
			</div>
		)}
	</div>
</section>

<style>
	.faq-answer {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 240ms ease;
	}

	.faq-answer[data-open='true'] {
		grid-template-rows: 1fr;
	}

	.faq-answer[hidden] {
		display: none;
	}

	[data-faq-trigger][aria-expanded='true'] [data-faq-icon] {
		transform: rotate(45deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-answer {
			transition: none;
		}
	}
</style>

<script>
	const faqSection = document.querySelector<HTMLElement>('[data-faq]')
	const faqTriggers = Array.from(
		faqSection?.querySelectorAll<HTMLButtonElement>('[data-faq-trigger]') ?? [],
	)

	function setExpanded(trigger: HTMLButtonElement, expanded: boolean) {
		const answerId = trigger.getAttribute('aria-controls')
		const answer = answerId ? document.getElementById(answerId) : null

		if (!answer) return

		trigger.setAttribute('aria-expanded', String(expanded))

		if (expanded) {
			answer.hidden = false
			requestAnimationFrame(() => {
				if (trigger.getAttribute('aria-expanded') === 'true') {
					answer.dataset.open = 'true'
				}
			})
			return
		}

		answer.dataset.open = 'false'

		if (
			answer.hidden ||
			window.matchMedia('(prefers-reduced-motion: reduce)').matches
		) {
			answer.hidden = true
			return
		}

		answer.addEventListener(
			'transitionend',
			(event) => {
				if (
					event.propertyName === 'grid-template-rows' &&
					trigger.getAttribute('aria-expanded') === 'false'
				) {
					answer.hidden = true
				}
			},
			{ once: true },
		)
	}

	faqTriggers.forEach((trigger, index) => {
		trigger.addEventListener('click', () => {
			const isExpanded = trigger.getAttribute('aria-expanded') === 'true'
			setExpanded(trigger, !isExpanded)
		})

		trigger.addEventListener('keydown', (event) => {
			let nextIndex: number | undefined

			if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
				nextIndex = (index + 1) % faqTriggers.length
			} else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
				nextIndex = (index - 1 + faqTriggers.length) % faqTriggers.length
			} else if (event.key === 'Home') {
				nextIndex = 0
			} else if (event.key === 'End') {
				nextIndex = faqTriggers.length - 1
			}

			if (nextIndex === undefined) return

			event.preventDefault()
			faqTriggers[nextIndex]?.focus()
		})
	})
</script>
