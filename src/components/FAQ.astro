---
interface FaqItem {
	question: string
	paragraphs: string[]
	list?: string[]
}

const faqs: FaqItem[] = [
	{
		question: "Can Ringlume answer calls when we're out on jobs?",
		paragraphs: [
			'Yes. Ringlume can answer calls 24/7, including while your team is at work, operating equipment, driving between jobs, after hours, or dealing with another customer.',
		],
	},
	{
		question: 'Can the AI handle emergency tree-service calls?',
		paragraphs: [
			"Ringlume can be configured to recognize urgent situations, collect the caller's contact and job information, and escalate the call according to your company's emergency workflow.",
			'For example, you can flag situations such as a tree on a house, blocked access, major storm damage, or a tree near electrical lines for immediate human attention.',
		],
	},
	{
		question: 'Will it diagnose whether a tree is dangerous?',
		paragraphs: [
			"It should not replace an arborist's professional assessment. Instead, the receptionist can collect details, identify potential urgency, and schedule or escalate the caller to the appropriate person on your team.",
		],
	},
	{
		question: 'Can it book tree estimates automatically?',
		paragraphs: [
			'Yes. Ringlume can connect to your booking workflow and schedule estimates according to the availability and rules you provide. The caller can move from "I need a quote" to a confirmed appointment during the same conversation.',
		],
	},
	{
		question: 'What information can it collect from a lead?',
		paragraphs: ['Your workflow can collect information such as:'],
		list: [
			'Caller name',
			'Caller phone number',
			'Service address',
			'Type of service',
			'Preferred appointment time',
			'Basically anything you prefer',
		],
	},
	{
		question: 'Can it answer questions about our services?',
		paragraphs: [
			'Yes. Ringlume can use information you approve, such as your website, online reviews, service list, service area, business hours, pricing rules, FAQs, and internal knowledge documents.',
		],
	},
	{
		question: 'What if customers ask, "How much does x service cost?"',
		paragraphs: [
			'You control the answer. Ringlume can explain that pricing depends on multiple factors and then offer to schedule an estimate. Or, set flat rates as you wish.',
			'The AI will never invent a price simply to keep the conversation moving.',
		],
	},
	{
		question: 'Can it handle different inquiries?',
		paragraphs: [
			'Yes. Your knowledge base can contain the exact services your company offers, allowing Ringlume to identify the service the customer is looking for before booking or routing the lead.',
		],
	},
	{
		question: "What happens if the AI doesn't know the answer?",
		paragraphs: [
			"It can be instructed not to guess. Instead, it can collect the customer's information and transfer or escalate the conversation when human expertise is needed.",
		],
	},
	{
		question: 'Can urgent or high-value jobs be transferred to me?',
		paragraphs: [
			"Yes. Ringlume can support live transfer and human escalation when enabled for the customer's setup or plan, allowing the business to define which calls deserve immediate attention.",
		],
	},
	{
		question: 'Will we know what happened after every call?',
		paragraphs: [
			'Depending on the Ringlume configuration and plan, the team can receive call information such as summaries, transcripts, recordings, and CRM updates so leads do not disappear into a voicemail inbox.',
		],
	},
	{
		question: 'Does Ringlume replace my office staff?',
		paragraphs: [
			"It doesn't have to. Some companies may use Ringlume as their main front desk, while others can use it for overflow calls, after-hours coverage, lead qualification, and booking so existing staff can focus on higher-value work.",
		],
	},
	{
		question: 'How long does setup take?',
		paragraphs: [
			"Ringlume currently advertises a typical setup time of approximately 24-48 hours. The receptionist is configured around the business's services, FAQs, booking rules, and escalation requirements.",
		],
	},
	{
		question: 'How much does Ringlume cost?',
		paragraphs: [
			'Ringlume offers plans for different call volumes and workflow requirements. See the pricing above for the current plans and included features, or book a demo if you are unsure which setup fits your tree-service business.',
		],
	},
]
---

<section
	id="faq"
	class="scroll-mt-16 overflow-hidden bg-[#0d0f10] py-20 content-auto lg:scroll-mt-20 lg:py-32"
	aria-labelledby="faq-heading"
	data-faq
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mx-auto mb-12 max-w-3xl text-center sm:mb-16">
			<h2 id="faq-heading" class="text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
				Frequently Asked <span class="gradient-green-text">Questions</span>
			</h2>
		</header>

		<div class="card-shadow-lg mx-auto max-w-4xl overflow-hidden rounded-3xl border border-white/10 bg-slate-bg">
			{faqs.map((faq, index) => {
				const questionId = `faq-question-${index + 1}`
				const answerId = `faq-answer-${index + 1}`

				return (
					<div class="faq-item border-b border-white/10 last:border-b-0" data-faq-item>
						<h3 class="m-0">
							<button
								type="button"
								id={questionId}
								class="flex min-h-16 w-full min-w-0 items-center justify-between gap-4 px-5 py-5 text-left text-base font-semibold leading-relaxed text-white transition-colors hover:bg-white/[0.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-green-primary/70 sm:px-7 sm:py-6 sm:text-lg"
								aria-expanded="false"
								aria-controls={answerId}
								data-faq-trigger
							>
								<span class="min-w-0 break-words">{faq.question}</span>
								<svg
									class="h-5 w-5 flex-none text-green-primary transition-transform duration-200 motion-reduce:transition-none"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									aria-hidden="true"
									data-faq-icon
								>
									<path d="M12 5v14M5 12h14" />
								</svg>
							</button>
						</h3>

						<div
							id={answerId}
							class="faq-answer"
							data-faq-answer
							data-open="false"
							hidden
						>
							<div class="min-h-0 overflow-hidden px-5 pb-6 pr-14 text-sm leading-relaxed text-slate-300 sm:px-7 sm:pb-7 sm:pr-16 sm:text-base">
								{faq.paragraphs.map((paragraph) => (
									<p class="mb-4 last:mb-0">{paragraph}</p>
								))}

								{faq.list && (
									<ul class="mt-4 list-disc space-y-2 pl-5 marker:text-green-primary">
										{faq.list.map((item) => <li>{item}</li>)}
									</ul>
								)}
							</div>
						</div>
					</div>
				)
			})}
		</div>
	</div>
</section>

<style>
	.faq-answer {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 240ms ease;
	}

	.faq-answer[data-open='true'] {
		grid-template-rows: 1fr;
	}

	.faq-answer[hidden] {
		display: none;
	}

	[data-faq-trigger][aria-expanded='true'] [data-faq-icon] {
		transform: rotate(45deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-answer {
			transition: none;
		}
	}
</style>

<script>
	const faqSection = document.querySelector<HTMLElement>('[data-faq]')
	const faqTriggers = Array.from(
		faqSection?.querySelectorAll<HTMLButtonElement>('[data-faq-trigger]') ?? [],
	)

	function setExpanded(trigger: HTMLButtonElement, expanded: boolean) {
		const answerId = trigger.getAttribute('aria-controls')
		const answer = answerId ? document.getElementById(answerId) : null

		if (!answer) return

		trigger.setAttribute('aria-expanded', String(expanded))

		if (expanded) {
			answer.hidden = false
			requestAnimationFrame(() => {
				if (trigger.getAttribute('aria-expanded') === 'true') {
					answer.dataset.open = 'true'
				}
			})
			return
		}

		answer.dataset.open = 'false'

		if (
			answer.hidden ||
			window.matchMedia('(prefers-reduced-motion: reduce)').matches
		) {
			answer.hidden = true
			return
		}

		answer.addEventListener(
			'transitionend',
			(event) => {
				if (
					event.propertyName === 'grid-template-rows' &&
					trigger.getAttribute('aria-expanded') === 'false'
				) {
					answer.hidden = true
				}
			},
			{ once: true },
		)
	}

	faqTriggers.forEach((trigger, index) => {
		trigger.addEventListener('click', () => {
			const isExpanded = trigger.getAttribute('aria-expanded') === 'true'
			setExpanded(trigger, !isExpanded)
		})

		trigger.addEventListener('keydown', (event) => {
			let nextIndex: number | undefined

			if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
				nextIndex = (index + 1) % faqTriggers.length
			} else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
				nextIndex = (index - 1 + faqTriggers.length) % faqTriggers.length
			} else if (event.key === 'Home') {
				nextIndex = 0
			} else if (event.key === 'End') {
				nextIndex = faqTriggers.length - 1
			}

			if (nextIndex === undefined) return

			event.preventDefault()
			faqTriggers[nextIndex]?.focus()
		})
	})
</script>
