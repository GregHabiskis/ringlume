---
import MissedCallCalculator from './MissedCallCalculator.astro'
import { tinaField } from '@tinacms/astro'
const copy = Astro.locals.site.pages.home.calculator
---

<section
	id="fomo"
	class="scrim content-auto scroll-mt-24 py-16 lg:py-24"
	aria-labelledby="fomo-heading"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mb-9 grid gap-5 lg:grid-cols-2 lg:items-end lg:gap-16">
			<h2
				id="fomo-heading"
				class="reveal-text max-w-lg text-h2 font-bold text-fg-1"
			>
				<span data-tina-field={tinaField(copy, 'heading')}>{copy.heading}</span><br /><span class="text-brand-text" data-tina-field={tinaField(copy, 'accent')}
					>{copy.accent}</span
				>
			</h2>
			<p
				class="max-w-lg text-base leading-relaxed text-fg-3 lg:justify-self-end"
				data-tina-field={tinaField(copy, 'description')}
			>
				{copy.description}
			</p>
		</header>
		<MissedCallCalculator />
	</div>
</section>
