---
import { tinaField } from '@tinacms/astro'
import { fillTokens } from '../lib/tina/site-model'
const copy = Astro.locals.site.shared
const destinations = Astro.locals.site.links
const currentYear = new Date().getFullYear()

const footerLinks = [
  { key: 'freeDemo', label: copy.footer.freeDemo, href: destinations.freeDemo },
  { key: 'terms', label: copy.footer.terms, href: destinations.terms },
  { key: 'privacy', label: copy.footer.privacy, href: destinations.privacy },
  { key: 'contact', label: copy.footer.contact, href: destinations.contact },
] as const
---

<footer class="scrim relative border-t border-line">
  <div class="mx-auto max-w-7xl px-4 pb-8 pt-10 sm:px-6 lg:px-8 lg:pt-12">
    <div
      class="flex flex-col items-center gap-8 md:flex-row md:items-center md:justify-between"
    >
      <div class="text-center md:text-left">
        <picture>
          <!-- logo-320-trimmed: same artwork with the 28px of transparent
               left padding cropped off so the logo sits flush with the
               column text (h-14 keeps the visible size unchanged). -->
          <source srcset="/images/logo-320-trimmed.webp" type="image/webp" />
          <img
            src="/images/logo-320-trimmed.png"
            alt={copy.logoAlt}
            width="292"
            height="128"
            class="mx-auto h-14 w-auto md:mx-0"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>

      <nav aria-label={copy.footer.label} class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 sm:gap-8">
        {footerLinks.map((link) => (
          <a
            href={link.href}
            data-tina-field={tinaField(destinations, link.key)}
            class="text-sm text-fg-3 transition-colors hover:text-fg-1"
          >
            <span data-tina-field={tinaField(copy.footer, link.key)}>{link.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <p class="mt-8 text-center text-xs text-fg-3">
      <span data-tina-field={tinaField(copy.footer, 'copyright')}>{fillTokens(copy.footer.copyright, { year: currentYear })}</span>
    </p>
  </div>
</footer>
