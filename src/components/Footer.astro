---
const currentYear = new Date().getFullYear()
---

<footer class="scrim relative pb-8 pt-14 lg:pt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Main Footer Content -->
    <div
      class="glass glass-regular grain reveal mb-10 rounded-[32px] p-7 sm:p-10 lg:p-12"
    >
      <div class="grid grid-cols-1 gap-10 md:grid-cols-4 lg:gap-12">
        <!-- Brand Column -->
        <div>
          <a href="/" class="group mb-6 inline-block">
            <div class="transition-transform duration-300 group-hover:scale-105">
              <picture>
                <!-- logo-320-trimmed: same artwork with the 28px of transparent
                     left padding cropped off so the logo sits flush with the
                     column text (h-14 keeps the visible size unchanged). -->
                <source srcset="/images/logo-320-trimmed.webp" type="image/webp" />
                <img
                  src="/images/logo-320-trimmed.png"
                  alt="Ringlume"
                  width="292"
                  height="128"
                  class="h-14 w-auto"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
          </a>
          <p class="max-w-sm text-sm leading-relaxed text-fg-3">
            Managed virtual receptionist and call handling for service businesses.
          </p>
        </div>

        <!-- Navigation Column -->
        <div>
          <h3 class="mb-4 font-semibold text-fg-1">Navigation</h3>
          <ul class="space-y-3">
            <li>
              <a href="/" class="text-sm text-fg-3 transition-colors hover:text-fg-1">Home</a>
            </li>
            <li>
              <a href="/#capabilities" class="text-sm text-fg-3 transition-colors hover:text-fg-1"
                >Features</a
              >
            </li>
            <li>
              <a href="/#demo" class="text-sm text-fg-3 transition-colors hover:text-fg-1"
                >Try a Demo</a
              >
            </li>
            <li>
              <a href="/#pricing" class="text-sm text-fg-3 transition-colors hover:text-fg-1"
                >Pricing</a
              >
            </li>
            <li>
              <a href="/faq" class="text-sm text-fg-3 transition-colors hover:text-fg-1">FAQ</a>
            </li>
            <li>
              <a href="/contact" class="text-sm text-fg-3 transition-colors hover:text-fg-1"
                >Contact</a
              >
            </li>
          </ul>
        </div>

        <!-- Legal Column -->
        <div>
          <h3 class="mb-4 font-semibold text-fg-1">Legal</h3>
          <ul class="space-y-3">
            <li>
              <a href="/terms" class="text-sm text-fg-3 transition-colors hover:text-fg-1"
                >Terms & Conditions</a
              >
            </li>
            <li>
              <a href="/privacy" class="text-sm text-fg-3 transition-colors hover:text-fg-1"
                >Privacy Policy</a
              >
            </li>
            <li>
              <a href="/refund" class="text-sm text-fg-3 transition-colors hover:text-fg-1"
                >Return & Refund Policy</a
              >
            </li>
          </ul>
        </div>

        <!-- Contact Us Column. min-w-0 + wrap-anywhere: the grid/flex
             children must be able to shrink so the long email wraps
             instead of widening the column past the panel edge. -->
        <div class="min-w-0">
          <h3 class="mb-4 font-semibold text-fg-1">Contact Us</h3>
          <ul class="space-y-4">
            <li>
              <a
                href="https://wa.me/8801951284128"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-3 text-sm text-fg-3 transition-colors hover:text-fg-1"
              >
                <span
                  class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-fg-1/[0.06] text-fg-1 transition-colors group-hover:bg-fg-1/20"
                >
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                    ></path>
                  </svg>
                </span>
                <span class="min-w-0 wrap-anywhere">+8801951-284128</span>
              </a>
            </li>
            <li>
              <a
                href="https://t.me/fshahariar"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-3 text-sm text-fg-3 transition-colors hover:text-fg-1"
              >
                <span
                  class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-fg-1/[0.06] text-fg-1 transition-colors group-hover:bg-fg-1/20"
                >
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                    ></path>
                  </svg>
                </span>
                <span class="min-w-0 wrap-anywhere">@fshahariar</span>
              </a>
            </li>
            <li>
              <a
                href="mailto:support@ringlume.com"
                class="group flex items-center gap-3 text-sm text-fg-3 transition-colors hover:text-fg-1"
              >
                <span
                  class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-fg-1/[0.06] text-fg-1 transition-colors group-hover:bg-fg-1/20"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                </span>
                <span class="min-w-0 wrap-anywhere">support<wbr />@ringlume.com</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="mt-10 border-t border-line pt-7">
        <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
          <p class="text-sm text-fg-3">&copy; {currentYear} Ringlume. All rights reserved.</p>
          <p class="max-w-md text-center text-xs leading-relaxed text-fg-3 md:text-right">
            Ringlume provides managed automated call-handling services using licensed
            third-party technology. Ringlume handles each Client's setup, deployment,
            billing, and support.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
