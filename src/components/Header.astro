---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/#capabilities' },
  { label: 'Live Demo', href: '/#demo' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
]

const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isCurrent = (href: string) =>
  href.includes('#') ? false : (href.replace(/\/+$/, '') || '/') === path
// Landing page: the hero is section one, so Home ships with
// aria-current="location" and the scroll-spy script moves it from there.
// Every other route keeps the static exact-path "page" marker.
const isIndex = path === '/'
const currentAttr = (href: string) =>
  isIndex
    ? href === '/'
      ? 'location'
      : undefined
    : isCurrent(href)
      ? 'page'
      : undefined
---

<header
  class="pointer-events-none fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-4 lg:px-6 lg:pt-4"
>
  <nav
    data-nav
    data-spy={isIndex || undefined}
    class="nav-pill glass glass-regular grain refract pointer-events-auto relative mx-auto flex h-14 max-w-7xl items-center justify-between rounded-full px-4 sm:px-5 lg:h-16 lg:px-6"
    aria-label="Main"
  >
    <!-- Logo -->
    <a href="/" class="group flex shrink-0 items-center gap-3">
      <div class="transition-transform duration-300 group-hover:scale-105">
        <picture>
          <source srcset="/images/logo-240.webp" type="image/webp" />
          <img
            src="/images/logo-240.png"
            alt="Ringlume"
            width="240"
            height="96"
            class="h-8 w-auto lg:h-9"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <div class="relative hidden items-center gap-1 md:flex" data-nav-links>
      <span class="nav-indicator" aria-hidden="true"></span>
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-link
          aria-current={currentAttr(link.href)}
          class="relative whitespace-nowrap rounded-full px-2.5 py-2 text-[13px] font-medium text-fg-2 transition-colors duration-200 hover:text-fg-1 lg:px-3.5 lg:text-sm"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/book-demo"
        class="btn btn-primary hidden whitespace-nowrap px-5 py-2.5 text-[13px] md:inline-flex lg:px-6 lg:text-sm"
      >
        Free Demo
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="menu-toggle inline-flex md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile drawer: sibling of the glass header, never a descendant,
     so backdrop-filter on the pill cannot break its fixed positioning. -->
<div
  id="mobile-menu"
  class="glass glass-thick grain fixed right-3 left-3 top-[4.75rem] z-40 hidden rounded-3xl p-4 md:hidden sm:left-auto sm:w-80"
>
  <div class="flex flex-col gap-1">
    {navLinks.map((link) => (
      <a
        href={link.href}
        data-nav-link
        aria-current={currentAttr(link.href)}
        class="rounded-2xl px-4 py-3 text-sm font-medium text-fg-2 transition-colors duration-200 hover:bg-white/[0.06] hover:text-fg-1"
      >
        {link.label}
      </a>
    ))}
    <a href="/book-demo" class="btn btn-primary mt-3 w-full text-sm">
      Free Demo
    </a>
  </div>
</div>

<style>
  .nav-pill {
    --glass-fill: rgba(13, 17, 26, 0.72);
    transition:
      height var(--dur-mid) var(--ease-spring),
      box-shadow var(--dur-mid) var(--ease-spring),
      transform var(--dur-mid) var(--ease-spring);
  }

  .nav-pill[data-condensed] {
    box-shadow:
      inset 1px 1px 0 0 var(--glass-edge-hi),
      inset -1px -1px 0 0 var(--glass-edge-lo),
      inset 0 1px 0 var(--glass-specular),
      inset 0 0 24px -12px var(--glass-inner),
      0 10px 30px -12px var(--shadow-diffuse);
  }

  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand) 38%, transparent);
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--dur-mid) var(--ease-spring),
      width var(--dur-mid) var(--ease-spring),
      height var(--dur-mid) var(--ease-spring),
      opacity var(--dur-fast) ease;
  }

  .nav-indicator.is-active {
    opacity: 1;
  }

  /* display comes from the `inline-flex` utility in markup: this rule is
     unlayered, so a `display` here would beat Tailwind's `md:hidden` and
     keep the hamburger on desktop. */
  .menu-toggle {
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    color: var(--fg-2);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--fg-1) 6%, transparent);
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      transform var(--dur-fast) var(--ease-spring);
  }

  .menu-toggle:hover {
    color: var(--fg-1);
    background: color-mix(in srgb, var(--fg-1) 12%, transparent);
  }

  .menu-toggle:active {
    transform: scale(0.94);
  }

  #mobile-menu {
    transform-origin: top right;
  }

  #mobile-menu:not(.hidden) {
    animation: drawer-in var(--dur-mid) var(--ease-spring) both;
  }

  @keyframes drawer-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill,
    .nav-indicator,
    .menu-toggle {
      transition: none;
    }

    #mobile-menu:not(.hidden) {
      animation: none;
    }
  }
</style>

<script>
  import { getAnchorTarget, prepareAnchorLayout } from '../lib/anchor-navigation'

  const toggle = document.getElementById('mobile-menu-toggle')
  const menu = document.getElementById('mobile-menu')

  function setMenu(open: boolean) {
    menu?.classList.toggle('hidden', !open)
    toggle?.setAttribute('aria-expanded', String(open))
  }

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      setMenu(menu.classList.contains('hidden'))
    })

    // Any drawer link closes it, including same-page section anchors
    // where no page reload would clear the state.
    menu.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) {
        setMenu(false)
      }
    })

    document.addEventListener('click', (e) => {
      const target = e.target as Node | null
      if (!menu.classList.contains('hidden') && !menu.contains(target) && !toggle.contains(target)) {
        setMenu(false)
      }
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        setMenu(false)
        toggle.focus()
      }
    })

    // The toggle and drawer are md:hidden; above 768px nothing may stay open.
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setMenu(false)
    })
  }

  // Condense the pill on scroll (visual only).
  const nav = document.querySelector<HTMLElement>('[data-nav]')
  if (nav) {
    const sync = () => nav.toggleAttribute('data-condensed', window.scrollY > 12)
    sync()
    window.addEventListener('scroll', sync, { passive: true })
  }

  // Liquid indicator that slides between nav items. The indicator is
  // absolutely positioned inside [data-nav-links] (that container is the
  // `relative` containing block), so every measurement is taken against
  // its box with getBoundingClientRect: exact, and structurally unable
  // to land on the logo.
  const linksBox = document.querySelector<HTMLElement>('[data-nav-links]')
  const indicator = linksBox?.querySelector<HTMLElement>('.nav-indicator')
  const links = linksBox
    ? Array.from(linksBox.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'))
    : []

  function currentLink() {
    return links.find((link) => link.hasAttribute('aria-current'))
  }

  let shown: HTMLAnchorElement | undefined

  function moveTo(el: HTMLAnchorElement | undefined) {
    shown = el
    if (!indicator || !linksBox) return
    if (!el) {
      indicator.classList.remove('is-active')
      return
    }
    const box = linksBox.getBoundingClientRect()
    const rect = el.getBoundingClientRect()
    indicator.style.width = `${rect.width}px`
    indicator.style.height = `${rect.height}px`
    indicator.style.transform = `translate(${rect.left - box.left}px, ${rect.top - box.top}px)`
    indicator.classList.add('is-active')
  }

  // Re-measure the resting target after resize, webfont swap, or reflow.
  const rest = () => moveTo(shown ?? currentLink())

  links.forEach((link) => {
    link.addEventListener('pointerenter', () => moveTo(link))
    link.addEventListener('focus', () => moveTo(link))
  })

  linksBox?.addEventListener('pointerleave', () => {
    moveTo(currentLink())
  })

  rest()
  window.addEventListener('resize', rest)
  document.fonts?.ready.then(rest)
  if (linksBox && 'ResizeObserver' in window) {
    new ResizeObserver(rest).observe(linksBox)
  }

  // Scroll-spy (index only, signalled by data-spy on the nav): ONE
  // IntersectionObserver maps section position on the page to the active
  // link. Use an explicit mapping for page sections and their links.
  // Bands without a link (the FOMO strip) keep the previous active link.
  if (nav?.hasAttribute('data-spy')) {
    // Prepare direct fragment visits as well as clicks within the homepage.
    prepareAnchorLayout(getAnchorTarget(window.location.hash))

    const allLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'),
    )
    const sections: [selector: string, href: string][] = [
      ['main > section:first-child', '/'], // hero → Home
      ['#capabilities', '/#capabilities'],
      ['#demo', '/#demo'],
      ['#pricing', '/#pricing'],
      ['#faq', '/faq'],
      ['#contact', '/contact'],
    ]
    const pairs = sections.flatMap(([selector, href]) => {
      const el = document.querySelector<HTMLElement>(selector)
      return el && allLinks.some((l) => l.getAttribute('href') === href)
        ? [{ el, href }]
        : []
    })

    let activeHref: string | null = null
    let locked = false
    let lockTimer = 0

    function applyActive(href: string) {
      if (href === activeHref) return
      activeHref = href
      for (const link of allLinks) {
        if (link.getAttribute('href') === href)
          link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      }
      // The indicator follows the active link; it lives inside
      // [data-nav-links], so it can never land on the logo.
      moveTo(links.find((l) => l.getAttribute('href') === href))
    }

    // Active = the section covering the upper-third line of the viewport
    // (34% — exactly where the observer's rootMargin band ends). The
    // sticky-header clearance (-80px) prunes sections that are already
    // fully above the band. Sections never overlap, so the first match
    // is the only match; no observed section on the line (e.g. the FOMO
    // strip) means null: keep the previous active link.
    function pick(): string | null {
      const line = window.innerHeight * 0.34
      for (const { el, href } of pairs) {
        const r = el.getBoundingClientRect()
        if (r.top < line && r.bottom > line) return href
      }
      return null
    }

    function sync() {
      if (locked) return
      const href = pick()
      if (href !== null) applyActive(href)
    }

    // Synchronous state at script run: adopt the server-rendered marker
    // first, then reconcile immediately (covers restored scroll).
    activeHref =
      document
        .querySelector('[data-nav-link][aria-current]')
        ?.getAttribute('href') ?? null
    sync()

    const observer = new IntersectionObserver(sync, {
      rootMargin: '-80px 0px -66% 0px',
    })
    for (const { el } of pairs) observer.observe(el)

    // Lock only the active-link indicator during native smooth scrolling.
    // This fallback changes highlighting, never the page's scroll position.
    const unlock = () => {
      clearTimeout(lockTimer)
      locked = false
      sync()
    }
    if ('onscrollend' in window)
      window.addEventListener('scrollend', unlock)

    document.addEventListener('click', (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return
      const link =
        event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>('a[href]')
          : null
      if (
        !link ||
        link.hasAttribute('download') ||
        (link.target && link.target !== '_self')
      )
        return

      const url = new URL(link.href, window.location.href)
      if (
        url.origin !== window.location.origin ||
        url.pathname !== window.location.pathname ||
        url.search !== window.location.search
      )
        return
      const target = getAnchorTarget(url.hash)
      if (!target) return

      // Expand intervening placeholders before the browser's default action.
      // Do not preventDefault or issue a second programmatic scroll.
      prepareAnchorLayout(target)
      const pair = pairs.find(({ el }) => el === target || el.contains(target))
      if (pair) applyActive(pair.href)
      locked = true
      clearTimeout(lockTimer)
      lockTimer = window.setTimeout(unlock, 2000)
    })
  }
</script>
