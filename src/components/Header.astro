---
import { tinaField } from '@tinacms/astro'
import { isCurrentNavigation } from '../lib/header-navigation'
const copy = Astro.locals.site.shared
const destinations = Astro.locals.site.links
const navLinks = [
  { key: 'home', destination: 'home', label: copy.nav.home, href: destinations.home },
  { key: 'demo', destination: 'liveDemo', label: copy.nav.demo, href: destinations.liveDemo },
  { key: 'features', destination: 'features', label: copy.nav.features, href: destinations.features },
  { key: 'pricing', destination: 'pricing', label: copy.nav.pricing, href: destinations.pricing },
  { key: 'faq', destination: 'faq', label: copy.nav.faq, href: destinations.faq },
  { key: 'contact', destination: 'contact', label: copy.nav.contact, href: destinations.contact },
] as const

// Tina's Astro container doesn't use the preview page's URL.
const previewPaths: Record<string, string> = {
  home: '/', pricing: '/pricing', faq: '/faq', contact: '/contact',
  bookDemo: '/book-demo', terms: '/terms', privacy: '/privacy',
}
const { page } = Astro.props as { page?: string }
const currentUrl = page && Object.hasOwn(previewPaths, page)
  ? new URL(previewPaths[page], Astro.url)
  : Astro.url
const path = currentUrl.pathname.replace(/\/+$/, '') || '/'
// Landing page: the hero is section one, so Home ships with
// aria-current="location" and the scroll-spy script moves it from there.
// Every other route keeps the static exact-path "page" marker.
const isIndex = path === '/'
const currentLink = navLinks.find(link => isCurrentNavigation(link.href, currentUrl))
const currentAttr = (link: typeof navLinks[number]) =>
  link === currentLink ? (isIndex ? 'location' : 'page') : undefined
---

<div data-header-root>
<header
  class="pointer-events-none fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-4 lg:px-6 lg:pt-4"
>
  <nav
    data-nav
    data-spy={isIndex || undefined}
    class="nav-pill glass glass-regular grain refract pointer-events-auto relative mx-auto flex h-14 max-w-7xl items-center justify-between rounded-full px-4 sm:px-5 lg:h-16 lg:px-6"
    aria-label={copy.nav.mainLabel}
  >
    <!-- Logo -->
    <a href={destinations.home} data-tina-field={tinaField(destinations, 'home')} class="group flex shrink-0 items-center gap-3">
      <div class="transition-transform duration-300 group-hover:scale-105">
        <picture>
          <source srcset="/images/logo-240.webp" type="image/webp" />
          <img
            src="/images/logo-240.png"
            alt={copy.logoAlt}
            width="240"
            height="96"
            class="h-8 w-auto lg:h-9"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <div class="relative hidden items-center gap-1 md:flex" data-nav-links>
      <span class="nav-indicator" aria-hidden="true"></span>
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-link
          data-tina-field={tinaField(destinations, link.destination)}
          aria-current={currentAttr(link)}
          class="relative whitespace-nowrap rounded-full px-2.5 py-2 text-[13px] font-medium text-fg-2 transition-colors duration-200 hover:text-fg-1 lg:px-3.5 lg:text-sm"
        >
          <span data-tina-field={tinaField(copy.nav, link.key)}>{link.label}</span>
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a
        href={destinations.freeDemo}
        data-tina-field={tinaField(destinations, 'freeDemo')}
        class="btn btn-primary hidden whitespace-nowrap px-5 py-2.5 text-[13px] md:inline-flex lg:px-6 lg:text-sm"
      >
        <span data-tina-field={tinaField(copy.nav, 'freeDemo')}>{copy.nav.freeDemo}</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="menu-toggle inline-flex md:hidden"
        aria-label={copy.nav.menuLabel}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile drawer: sibling of the glass header, never a descendant,
     so backdrop-filter on the pill cannot break its fixed positioning. -->
<div
  id="mobile-menu"
  class="glass glass-thick grain fixed right-3 left-3 top-[4.75rem] z-40 hidden rounded-3xl p-4 md:hidden sm:left-auto sm:w-80"
>
  <div class="flex flex-col gap-1">
    {navLinks.map((link) => (
      <a
        href={link.href}
        data-nav-link
        data-tina-field={tinaField(destinations, link.destination)}
        aria-current={currentAttr(link)}
        class="rounded-2xl px-4 py-3 text-sm font-medium text-fg-2 transition-colors duration-200 hover:bg-white/[0.06] hover:text-fg-1"
      >
        <span data-tina-field={tinaField(copy.nav, link.key)}>{link.label}</span>
      </a>
    ))}
    <a href={destinations.freeDemo} data-tina-field={tinaField(destinations, 'freeDemo')} class="btn btn-primary mt-3 w-full text-sm">
      <span data-tina-field={tinaField(copy.nav, 'freeDemo')}>{copy.nav.freeDemo}</span>
    </a>
  </div>
</div>

</div>

<style>
  .nav-pill {
    --glass-fill: rgba(13, 17, 26, 0.72);
    transition:
      height var(--dur-mid) var(--ease-spring),
      box-shadow var(--dur-mid) var(--ease-spring),
      transform var(--dur-mid) var(--ease-spring);
  }

  .nav-pill[data-condensed] {
    box-shadow:
      inset 1px 1px 0 0 var(--glass-edge-hi),
      inset -1px -1px 0 0 var(--glass-edge-lo),
      inset 0 1px 0 var(--glass-specular),
      inset 0 0 24px -12px var(--glass-inner),
      0 10px 30px -12px var(--shadow-diffuse);
  }

  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand) 38%, transparent);
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--dur-mid) var(--ease-spring),
      width var(--dur-mid) var(--ease-spring),
      height var(--dur-mid) var(--ease-spring),
      opacity var(--dur-fast) ease;
  }

  .nav-indicator.is-active {
    opacity: 1;
  }

  /* display comes from the `inline-flex` utility in markup: this rule is
     unlayered, so a `display` here would beat Tailwind's `md:hidden` and
     keep the hamburger on desktop. */
  .menu-toggle {
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    color: var(--fg-2);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--fg-1) 6%, transparent);
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      transform var(--dur-fast) var(--ease-spring);
  }

  .menu-toggle:hover {
    color: var(--fg-1);
    background: color-mix(in srgb, var(--fg-1) 12%, transparent);
  }

  .menu-toggle:active {
    transform: scale(0.94);
  }

  #mobile-menu {
    transform-origin: top right;
  }

  #mobile-menu:not(.hidden) {
    animation: drawer-in var(--dur-mid) var(--ease-spring) both;
  }

  @keyframes drawer-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill,
    .nav-indicator,
    .menu-toggle {
      transition: none;
    }

    #mobile-menu:not(.hidden) {
      animation: none;
    }
  }
</style>

<script>
  import { initHeader } from '../scripts/header'
  const root = document.querySelector<HTMLElement>('[data-header-root]')
  if (root) initHeader(root)
</script>
