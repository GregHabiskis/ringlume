---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/#capabilities' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Try a Demo', href: '/#demo' },
  { label: 'Contact', href: '/contact' },
]
---

<header class="fixed top-0 left-0 right-0 z-40 bg-[#111213] md:bg-[#111213]/90 md:backdrop-blur-md border-b border-white/10">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="transition-transform group-hover:scale-105">
          <picture>
            <source srcset="/images/logo-240.webp" type="image/webp" />
            <img
              src="/images/logo-240.png"
              alt="Ringlume"
              width="240"
              height="96"
              class="h-8 lg:h-10 w-auto"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-300 hover:text-green-primary transition-colors"
          >
            {link.label}
          </a>
        ))}
        <a
          href="/#pricing"
          class="gradient-bg text-white px-6 py-2.5 rounded-full text-sm font-semibold hover:[background:linear-gradient(135deg,#3ABF52,#269635)] hover:scale-[1.02] transition-all"
        >
          Get Started
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 text-slate-300 hover:text-white"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-3">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-300 hover:text-green-primary py-2 transition-colors"
          >
            {link.label}
          </a>
        ))}
        <a
          href="/#pricing"
          class="gradient-bg text-white px-6 py-2.5 rounded-full text-sm font-semibold text-center hover:[background:linear-gradient(135deg,#3ABF52,#269635)] hover:scale-[1.02] transition-all"
        >
          Get Started
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle')
  const menu = document.getElementById('mobile-menu')

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden')
    })

    document.addEventListener('click', (e) => {
      const target = e.target as Node | null
      if (!menu.classList.contains('hidden') && !menu.contains(target) && !toggle.contains(target)) {
        menu.classList.add('hidden')
      }
    })
  }
</script>
