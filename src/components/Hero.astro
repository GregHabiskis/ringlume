---
import { getRetellConfig } from '../lib/retell-config'

const retell = getRetellConfig()
---

<section class="relative pt-32 lg:pt-40 pb-20 lg:pb-32 overflow-hidden bg-navy">
  <!-- Background Elements: lighter paint on mobile -->
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="orb orb-sm absolute -top-32 -right-24 w-64 h-64 md:w-80 md:h-80 bg-green-primary/40"></div>
    <div class="orb orb-sm absolute -bottom-32 -left-24 w-64 h-64 md:w-80 md:h-80 bg-green-accent/35 hidden sm:block"></div>
    <div class="orb orb-sm absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[420px] h-[420px] md:w-[600px] md:h-[600px] bg-green-primary/15 hidden md:block"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-white leading-tight mb-6">
        <span class="sr-only">A Receptionist Who Never Sleeps.</span>
        <span aria-hidden="true">
          A Receptionist Who Never{' '}
          <span class="rotating-text">
            <span class="word active">Sleeps.</span>
            <span class="word">Quits.</span>
            <span class="word">Calls in Sick.</span>
          </span>
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-10 max-w-3xl mx-auto">
        Ringlume answers calls, qualifies leads, and books appointments for service businesses—24/7.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#pricing"
          class="gradient-bg text-white px-8 py-4 rounded-full text-base font-semibold hover:[background:linear-gradient(135deg,#3ABF52,#269635)] transition-all hover:scale-105"
        >
          Get Started Today
        </a>
        <a
          href={retell ? '#demo' : '#capabilities'}
          class="text-white px-8 py-4 rounded-full text-base font-semibold border border-white/20 hover:bg-white/10 transition-all"
        >
          {retell ? 'Try a Demo' : 'Explore Features'}
        </a>
      </div>

      <!-- Value Proposition -->
      <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
        <div class="glass-effect rounded-2xl p-6 text-center">
          <div class="text-3xl font-bold gradient-text mb-2">7 Days</div>
          <div class="text-sm text-white/70">7-Day Guarantee</div>
        </div>
        <div class="glass-effect rounded-2xl p-6 text-center">
          <div class="text-3xl font-bold gradient-text mb-2">24/7</div>
          <div class="text-sm text-white/70">Always Working</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .rotating-text {
    display: inline-grid;
    vertical-align: bottom;
  }

  .word {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(100%);
    transition: transform 0.5s ease, opacity 0.5s ease;
    white-space: nowrap;
  }

  .word.active {
    opacity: 1;
    transform: translateY(0);
  }

  .word.leave {
    opacity: 0;
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .word.active,
    .word.leave {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    const rotatingText = document.querySelector('.rotating-text');
    if (!rotatingText) return;

    const words = rotatingText.querySelectorAll('.word');
    if (words.length < 2) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      let currentIndex = 0;
      const total = words.length;
      const DISPLAY_MS = 2800;
      const ANIMATION_MS = 500;

      function rotateWord() {
        const current = words[currentIndex];
        const nextIndex = (currentIndex + 1) % total;
        const next = words[nextIndex];

        current.classList.remove('active');
        current.classList.add('leave');
        next.classList.add('active');

        setTimeout(() => {
          current.classList.remove('leave');
        }, ANIMATION_MS);

        currentIndex = nextIndex;
      }

      const start = () => setInterval(rotateWord, DISPLAY_MS);
      if ('requestIdleCallback' in window) {
        requestIdleCallback(start, { timeout: 2000 });
      } else {
        setTimeout(start, 1);
      }
    }
  })();
</script>
