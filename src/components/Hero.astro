---
---

<section class="relative pt-32 lg:pt-40 pb-20 lg:pb-32 overflow-hidden bg-navy">
  <!-- Background Elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-primary/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-blue-electric/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-primary/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/10 mb-8">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        <span class="text-sm font-medium text-white/80">Now Serving Businesses in 2026</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-white leading-tight mb-6">
        Your Business Needs a
        <span class="gradient-text"> Digital Storefront </span>
        & Intelligent
        <span class="gradient-text"> Voice AI</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-10 max-w-3xl mx-auto">
        In 2026, consumer attention spans are at an all-time low, and instant conversational gratification
        is mandatory. A professional website acts as your 24/7 digital storefront, while a Voice AI
        Receptionist functions as your tireless operating brain.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#pricing"
          class="gradient-bg text-white px-8 py-4 rounded-full text-base font-semibold hover:opacity-90 transition-all hover:scale-105 shadow-lg shadow-blue-primary/30"
        >
          Get Your Free Website
        </a>
        <a
          href="#capabilities"
          class="text-white px-8 py-4 rounded-full text-base font-semibold border border-white/20 hover:bg-white/10 transition-all"
        >
          Explore Voice AI Features
        </a>
      </div>

      <!-- Value Proposition -->
      <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
        <div class="glass-effect rounded-2xl p-6 text-center">
          <div class="text-3xl font-bold gradient-text mb-2">7 Days</div>
          <div class="text-sm text-white/70">Money Back Guarantee</div>
        </div>
        <div class="glass-effect rounded-2xl p-6 text-center">
          <div class="text-3xl font-bold gradient-text mb-2">Free</div>
          <div class="text-sm text-white/70">Professional Website</div>
        </div>
        <div class="glass-effect rounded-2xl p-6 text-center">
          <div class="text-3xl font-bold gradient-text mb-2">24/7</div>
          <div class="text-sm text-white/70">Always Working</div>
        </div>
      </div>
    </div>
  </div>
</section>
