---
import { PLANS, formatPrice } from '../lib/pricing'

interface Props {
	detailed?: boolean
}

const { detailed = false } = Astro.props
const Heading = detailed ? 'h1' : 'h2'
const detailsLink = detailed
	? { href: '#plan-comparison', label: 'Compare every feature' }
	: { href: '/pricing', label: 'Explore full pricing' }
---

<section
	class:list={[
		'scrim content-auto',
		detailed ? 'pb-16 lg:pb-24' : 'py-16 lg:py-24',
	]}
	aria-labelledby="pricing-heading"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mb-8 grid gap-5 lg:grid-cols-2 lg:items-end lg:gap-16">
			<Heading
				id="pricing-heading"
				class="reveal-text max-w-xl text-h2 font-bold text-fg-1"
			>
				A plan for your<br /><span class="text-brand-text"
					>next stage of growth.</span
				>
			</Heading>
			<p
				class="max-w-lg text-base leading-relaxed text-fg-3 lg:justify-self-end"
			>
				Try a free demo before choosing your plan.
			</p>
		</header>

		<div
			class:list={[
				'mb-6 flex flex-wrap items-center justify-between gap-4',
				!detailed && 'max-sm:flex-col max-sm:justify-center max-sm:text-center',
			]}
		>
			<p class="text-xs text-fg-3">Prices in USD.</p>
			<div
				class="glass glass-fill glass-regular inline-flex rounded-full p-1"
				role="group"
				aria-label="Billing period"
			>
				<button
					type="button"
					id="monthly-btn"
					aria-pressed="true"
					class="pricing-toggle toggle-active min-h-11 rounded-full px-4 text-xs font-semibold"
					>Monthly</button
				>
				<button
					type="button"
					id="annual-btn"
					aria-pressed="false"
					class="pricing-toggle toggle-inactive min-h-11 rounded-full px-4 text-xs font-semibold"
					>Annually <span class="ml-1">Save ~17%</span></button
				>
			</div>
		</div>

		<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
			{
				PLANS.map((plan) => (
					<article
						class:list={[
							'plan-card glass glass-fill glass-regular flex min-w-0 flex-col rounded-3xl p-5 lg:p-6',
							plan.recommended && 'plan-recommended',
						]}
					>
						<div class="flex min-h-7 items-center justify-between gap-2">
							<h3 class="font-sans text-lg font-semibold text-fg-1">
								{plan.name}
							</h3>
							{plan.recommended && (
								<span class="rounded-full bg-brand/15 px-2.5 py-1 text-xs font-semibold text-brand-text">
									Recommended
								</span>
							)}
						</div>
						<p class="mt-1 text-xs text-fg-3">{plan.description}</p>
						<div class="mt-6" data-pricing-display>
							<p class="flex items-baseline gap-1 whitespace-nowrap">
								<span
									class="pricing-tilde hidden text-lg text-fg-3"
									aria-hidden="true"
								>
									~
								</span>
								<span
									class="pricing-amount text-4xl font-semibold tracking-tighter text-fg-1"
									data-monthly-display={formatPrice(plan.monthly)}
									data-annual-monthly-display={formatPrice(plan.annualMonthly)}
									data-annual-billing-display={`Billed ${formatPrice(plan.annualTotal)} annually`}
								>
									{formatPrice(plan.monthly)}
								</span>
								<span class="text-xs text-fg-3">/ mo</span>
							</p>
							<p
								class="pricing-billing mt-2 text-xs text-fg-3"
								aria-live="polite"
							>
								Billed monthly
							</p>
							<p class="mt-2 text-xs leading-relaxed text-fg-3">
								+ {formatPrice(plan.setupFee)} one-time Service Setup Fee
							</p>
							<p class="mt-1 text-xs text-fg-3">
								${plan.overagePerMinute.toFixed(2)} / min overage
							</p>
						</div>
						<ul class="my-6 space-y-3 border-t border-line pt-5">
							{plan.benefits.map((benefit) => (
								<li class="flex items-start gap-2 text-sm leading-relaxed text-fg-2">
									<svg
										width="14"
										height="18"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										class="shrink-0 text-brand-text"
										aria-hidden="true"
									>
										<path d="m5 12 4 4L19 6" />
									</svg>
									{benefit}
								</li>
							))}
						</ul>
						<a
							href="/book-demo"
							data-plan={plan.name.toLowerCase()}
							aria-describedby={`cta-legal-notice-${plan.name.toLowerCase()}`}
							class:list={[
								'btn mt-auto w-full px-3 text-sm',
								plan.recommended ? 'btn-primary' : 'btn-secondary',
							]}
						>
							Get Your Free Demo
						</a>
						<p
							id={`cta-legal-notice-${plan.name.toLowerCase()}`}
							class="mt-3 text-xs leading-relaxed text-fg-3"
						>
							Subject to our{' '}
							<a
								href="/terms"
								class="underline underline-offset-2 hover:text-fg-1"
							>
								Terms of Service
							</a>{' '}
							and{' '}
							<a
								href="/privacy"
								class="underline underline-offset-2 hover:text-fg-1"
							>
								Privacy Policy
							</a>
							.
						</p>
					</article>
				))
			}
		</div>

		<div
			class:list={[
				'mt-7 flex flex-col gap-5 border-b border-line pb-8 sm:flex-row sm:items-start sm:justify-between',
				!detailed && 'max-sm:items-center max-sm:text-center',
			]}
		>
			<div>
				<p class="text-xs leading-relaxed text-fg-3">
					Cancel anytime. Minutes reset monthly.
				</p>
				<p class="mt-2 text-xs leading-relaxed text-fg-3">
					<a
						href="/terms#setup-fee-upgrades"
						class="underline underline-offset-4 hover:text-fg-1"
						>Upgrading? Pay only the setup-fee difference.</a
					>
				</p>
			</div>
			<a
				href={detailsLink.href}
				class="inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-fg-1 underline underline-offset-8 hover:text-brand-text"
				>{detailsLink.label}<span aria-hidden="true">&rarr;</span></a
			>
		</div>
	</div>
</section>

<style>
	.plan-card {
		--glass-edge-hi: color-mix(in srgb, var(--fg-1) 16%, transparent);
	}
	.plan-recommended {
		border-color: color-mix(in srgb, var(--brand) 45%, transparent);
		background: linear-gradient(
			160deg,
			color-mix(in srgb, var(--brand) 8%, var(--bg-alt)),
			var(--bg-alt) 60%
		);
	}
	@media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
		.plan-recommended {
			background: var(--bg-alt);
		}
	}
</style>

<script>
	const monthlyBtn = document.getElementById('monthly-btn')
	const annualBtn = document.getElementById('annual-btn')

	monthlyBtn?.addEventListener('click', () => setBillingPeriod(false))
	annualBtn?.addEventListener('click', () => setBillingPeriod(true))

	function setBillingPeriod(annual: boolean) {
		monthlyBtn?.classList.toggle('toggle-active', !annual)
		monthlyBtn?.classList.toggle('toggle-inactive', annual)
		monthlyBtn?.setAttribute('aria-pressed', String(!annual))
		annualBtn?.classList.toggle('toggle-active', annual)
		annualBtn?.classList.toggle('toggle-inactive', !annual)
		annualBtn?.setAttribute('aria-pressed', String(annual))

		document
			.querySelectorAll<HTMLElement>('.pricing-amount')
			.forEach((amount) => {
				amount.textContent = annual
					? (amount.dataset.annualMonthlyDisplay ?? '')
					: (amount.dataset.monthlyDisplay ?? '')
				const billing = amount
					.closest('[data-pricing-display]')
					?.querySelector('.pricing-billing')
				if (billing)
					billing.textContent = annual
						? (amount.dataset.annualBillingDisplay ?? '')
						: 'Billed monthly'
			})
		document
			.querySelectorAll('.pricing-tilde')
			.forEach((tilde) => tilde.classList.toggle('hidden', !annual))
	}
</script>
