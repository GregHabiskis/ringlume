---
const plans = [
  {
    name: 'Basic',
    monthlyPrice: 299,
    annualPrice: 2990,
    annualMonthly: 249,
    period: '/mo',
    annualPeriod: '/mo',
    description: 'Perfect for small businesses getting started with Voice AI',
    features: [
      '200 Voice Calling Minutes',
      '24/7 Intelligent Call Handling',
      'Knowledge Base Training',
      'Automated Booking (1 Calendar)',
      'Custom CRM Integrations',
      'Daily Post-Call Analytics Reports',
    ],
    cta: 'Get Started',
    checkoutUrl: 'https://allinonesystem.lemonsqueezy.com/checkout/buy/bfc50783-9671-47be-9406-29ba4e9bced4?embed=1',
    popular: false,
  },
  {
    name: 'Pro',
    monthlyPrice: 499,
    annualPrice: 4990,
    annualMonthly: 416,
    period: '/mo',
    annualPeriod: '/mo',
    description: 'Most popular for growing businesses that need more power',
    features: [
      '500 Voice Calling Minutes',
      'Everything in Basic',
      'Live Transfer & Human Escalation',
      'Multilingual Support',
      'Daily Post-Call Recordings & Transcripts',
      'Custom Booking Landing Page',
    ],
    cta: 'Get Started',
    checkoutUrl: 'https://allinonesystem.lemonsqueezy.com/checkout/buy/73eb83a2-4edf-4ee2-9353-f3e38cfb51eb?embed=1',
    popular: true,
  },
  {
    name: 'Max',
    monthlyPrice: 999,
    annualPrice: 9990,
    annualMonthly: 832,
    period: '/mo',
    annualPeriod: '/mo',
    description: 'For businesses that need maximum capacity and customization',
    features: [
      '1,200 Voice Calling Minutes/mo',
      'Everything in Pro',
      'Workflow-Triggered Outbound Campaigns',
      'Continuous AI Performance Optimizations',
      'Custom Feature Integrations',
      'Dedicated Priority Support',
    ],
    cta: 'Buy Max',
    checkoutUrl: 'https://allinonesystem.lemonsqueezy.com/checkout/buy/f69ef3a9-f5e1-4ff3-9e70-06f8def88410?embed=1',
    popular: false,
  },
]
---

<section id="pricing" class="py-20 lg:py-32 bg-navy relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-purple-primary/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-purple-primary/15 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-green-primary/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
        Simple, Transparent <span class="gradient-green-text">Pricing</span>
      </h2>
      <p class="text-lg text-slate-300">
        Choose the plan that fits your business. Upgrade or downgrade anytime.
      </p>
    </div>

    <!-- Billing Toggle -->
    <div class="flex justify-center mb-12">
      <div class="bg-[#1E1F21] rounded-full p-1.5 inline-flex items-center border border-white/10">
        <button
          id="monthly-btn"
          class="pricing-toggle px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 toggle-active"
        >
          Monthly
        </button>
        <button
          id="annual-btn"
          class="pricing-toggle px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 toggle-inactive relative"
        >
          Annually
          <span class="absolute -top-2.5 -right-3 bg-gradient-to-r from-red-500 to-pink-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full shadow-lg">
            Save ~17%
          </span>
        </button>
      </div>
    </div>

    <!-- Pricing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {plans.map((plan) => (
        <div class={`pricing-card bg-slate-bg rounded-3xl p-8 relative ${plan.popular ? 'pricing-card-popular glow-green' : plan.name === 'Max' ? 'border-2 border-amber-500/30 hover:border-amber-500/50 shadow-lg shadow-amber-500/10' : 'border border-white/10 hover:border-white/20'}`}>
          {/* Popular Badge */}
          {plan.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="gradient-green text-white px-5 py-1.5 rounded-full text-xs font-bold shadow-lg glow-green">
                Most Popular
              </span>
            </div>
          )}

          {/* Premium Badge */}
          {plan.name === 'Max' && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="bg-gradient-to-r from-amber-500 to-orange-500 text-white px-5 py-1.5 rounded-full text-xs font-bold shadow-lg shadow-amber-500/30">
                Premium
              </span>
            </div>
          )}

          {/* Plan Name */}
          <div class="mb-6 text-center">
            <h3 class="text-xl font-bold text-white mb-2">{plan.name}</h3>
            <p class="text-sm text-slate-400">{plan.description}</p>
          </div>

          {/* Price */}
          <div class="mb-8 text-center">
            <div class="flex items-baseline justify-center gap-1">
              {plan.name !== 'Max' && (
                <span
                  class="pricing-tilde text-5xl font-bold text-white transition-all duration-300 opacity-0"
                >
                  ~
                </span>
              )}
              <span
                class="pricing-amount text-5xl font-bold text-white transition-all duration-300"
                data-monthly={`$${plan.monthlyPrice}`}
                data-annual={plan.name === 'Max' ? 'Contact Us' : `$${plan.annualMonthly}`}
              >
                ${plan.monthlyPrice}
              </span>
              <span
                class="pricing-period text-slate-400 font-medium transition-all duration-300"
                data-monthly="/mo"
                data-annual={plan.name === 'Max' ? '' : '/mo'}
              >
                /mo
              </span>
            </div>
            <p
              class="pricing-billing text-sm text-slate-500 mt-1 transition-all duration-300"
              data-monthly="Billed monthly"
              data-annual={plan.name === 'Max' ? '' : `Billed $${plan.annualPrice.toLocaleString()}/year`}
            >
              Billed monthly
            </p>
          </div>

          {/* Features */}
          <div class="space-y-3.5 mb-8">
            {plan.features.map((feature) => (
              <div class="flex items-start gap-3">
                <div class={`w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 ${plan.popular ? 'gradient-green' : 'gradient-bg'}`}>
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm text-slate-300">{feature}</span>
              </div>
            ))}
          </div>

          {/* CTA Button */}
          <a
            href={plan.checkoutUrl}
            class={`pricing-cta block w-full text-center py-3.5 rounded-xl text-sm font-semibold transition-all duration-300 ${
              plan.popular
                ? 'gradient-green text-white hover:opacity-90 hover:scale-[1.02] shadow-lg glow-green'
                : 'bg-white/5 text-white border border-white/10 hover:bg-white/10 hover:border-white/20 hover:scale-[1.02]'
            }`}
          >
            <span class="pricing-cta-text">{plan.cta}</span>
            <span class="pricing-cta-spinner hidden flex items-center justify-center">
              <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
              </svg>
            </span>
          </a>
        </div>
      ))}
    </div>

    <!-- Trust Text -->
    <div class="mt-12 text-center">
      <p class="text-sm text-slate-400">
        No hidden fees. Cancel anytime. Setup takes 24-48 hours. Included calling minutes reset monthly. 7-Days Money Back Guarantee.
      </p>
    </div>
  </div>
</section>

<script>
  const monthlyBtn = document.getElementById('monthly-btn');
  const annualBtn = document.getElementById('annual-btn');
  const amounts = document.querySelectorAll('.pricing-amount');
  const periods = document.querySelectorAll('.pricing-period');
  const billings = document.querySelectorAll('.pricing-billing');
  const tildes = document.querySelectorAll('.pricing-tilde');

  let isAnnual = false;

  function updatePricing() {
    amounts.forEach((el) => {
      const amount = el.getAttribute(`data-${isAnnual ? 'annual' : 'monthly'}`);
      if (amount) el.textContent = amount;
    });

    periods.forEach((el) => {
      const period = el.getAttribute(`data-${isAnnual ? 'annual' : 'monthly'}`);
      el.textContent = period || '';
      el.style.display = period ? '' : 'none';
    });

    billings.forEach((el) => {
      const billing = el.getAttribute(`data-${isAnnual ? 'annual' : 'monthly'}`);
      el.textContent = billing || '';
      el.style.display = billing ? '' : 'none';
    });

    tildes.forEach((el) => {
      el.style.opacity = isAnnual ? '1' : '0';
    });

    if (isAnnual) {
      monthlyBtn.classList.remove('toggle-active');
      monthlyBtn.classList.add('toggle-inactive');
      annualBtn.classList.remove('toggle-inactive');
      annualBtn.classList.add('toggle-active');
    } else {
      annualBtn.classList.remove('toggle-active');
      annualBtn.classList.add('toggle-inactive');
      monthlyBtn.classList.remove('toggle-inactive');
      monthlyBtn.classList.add('toggle-active');
    }
  }

  monthlyBtn.addEventListener('click', () => {
    isAnnual = false;
    updatePricing();
  });

  annualBtn.addEventListener('click', () => {
    isAnnual = true;
    updatePricing();
  });
</script>

<script>
(function() {
  /* ── SDK lazy loader ── */
  var lsLoaded = false;
  var lsLoading = false;
  var lsCallbacks = [];

  function loadLS() {
    if (lsLoaded || lsLoading) return;
    lsLoading = true;

    var s = document.createElement('script');
    s.src = 'https://assets.lemonsqueezy.com/lemon.js';
    s.async = true;
    s.onload = function () {
      lsLoaded = true;
      lsLoading = false;
      lsCallbacks.forEach(function (fn) { fn(window.LemonSqueezy); });
      lsCallbacks = [];
    };
    s.onerror = function () {
      lsLoading = false;
      var err = lsCallbacks.slice();
      lsCallbacks = [];
      err.forEach(function (fn) { fn(null); });
    };
    document.body.appendChild(s);
  }

  function onLSReady(callback) {
    if (window.LemonSqueezy && window.LemonSqueezy.Url) {
      callback(window.LemonSqueezy);
      return;
    }
    if (lsLoaded) {
      callback(window.LemonSqueezy || null);
      return;
    }
    lsCallbacks.push(callback);
    if (!lsLoading) loadLS();
  }

  /* ── Checkout state machine ── */
  var checkoutState = 'idle';  // 'idle' | 'loading' | 'open' | 'error'
  var activeBtn = null;

  function resetButton(btn) {
    if (!btn) return;
    delete btn.dataset.processing;
    btn.style.pointerEvents = '';
    var textEl = btn.querySelector('.pricing-cta-text');
    var spinnerEl = btn.querySelector('.pricing-cta-spinner');
    if (textEl) textEl.classList.remove('hidden');
    if (spinnerEl) spinnerEl.classList.add('hidden');
    checkoutState = 'idle';
    activeBtn = null;
  }

  /* ── Lemon Squeezy lifecycle events (postMessage) ── */
  window.addEventListener('message', function (e) {
    if (e.origin !== 'https://app.lemonsqueezy.com' &&
        e.origin !== 'https://allinonesystem.lemonsqueezy.com' &&
        e.origin !== 'https://checkout.lemonsqueezy.com') return;

    var data;
    try {
      data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
    } catch (_) {
      return;
    }
    if (!data || !data.event) return;

    if (data.event === 'CheckoutReady' && checkoutState === 'loading') {
      checkoutState = 'open';
      resetButton(activeBtn);
    }
    if (data.event === 'CheckoutClosed' || data.event === 'CheckoutSuccess') {
      resetButton(activeBtn);
    }
  });

  /* ── bfcache: reset on back/forward restore ── */
  window.addEventListener('pageshow', function (e) {
    if (e.persisted) resetButton(activeBtn);
  });

  /* ── Click handler ── */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.pricing-cta');
    if (!btn) return;

    var url = btn.getAttribute('href');
    if (!url) return;

    e.preventDefault();

    if (btn.dataset.processing === 'true') return;
    if (checkoutState !== 'idle') return;

    btn.dataset.processing = 'true';
    checkoutState = 'loading';
    activeBtn = btn;

    var textEl = btn.querySelector('.pricing-cta-text');
    var spinnerEl = btn.querySelector('.pricing-cta-spinner');
    if (textEl) textEl.classList.add('hidden');
    if (spinnerEl) spinnerEl.classList.remove('hidden');
    btn.style.pointerEvents = 'none';

    onLSReady(function (LS) {
      if (checkoutState !== 'loading') return;

      if (LS && LS.Url && LS.Url.Open) {
        LS.Url.Open(url);
      } else {
        checkoutState = 'error';
        resetButton(btn);
        window.location.href = url;
      }
    });
  });

  /* ── Lazy preloading triggers ── */
  document.addEventListener('mouseover', function (e) {
    var btn = e.target.closest('.pricing-cta');
    if (btn) loadLS();
  });

  document.addEventListener('focusin', function (e) {
    var btn = e.target.closest('.pricing-cta');
    if (btn) loadLS();
  });

  var pricingSection = document.getElementById('pricing');
  if (pricingSection && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          loadLS();
          observer.disconnect();
        }
      });
    }, { rootMargin: '300px' });
    observer.observe(pricingSection);
  }
})();
</script>


