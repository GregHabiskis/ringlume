---
const includedFeatures = [
  'Full Voice AI Agent Deployment (Inbound + Outbound)',
  'Custom Feature Integrations',
  'Continuous AI Optimizations',
  '24/7 Intelligent Call Handling',
  'Automated Appointment Booking',
  'Knowledge Base Training',
  'Live Transfer & Escalation',
  'Post-Call Analytics & Transcripts',
  'Multilingual Support',
  'Workflow-Triggered Outbound Campaigns',
  'Complimentary Professional Custom Web Design ($0 Setup)',
]
---

<section id="pricing" class="py-20 lg:py-32 bg-navy relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-primary/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-blue-electric/20 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
        Simple, Transparent <span class="gradient-text">Pricing</span>
      </h2>
      <p class="text-lg text-slate-300">
        One plan. Everything included. No hidden fees. Your professional website is on us.
      </p>
    </div>

    <!-- Pricing Card -->
    <div class="max-w-2xl mx-auto">
      <div class="bg-slate-bg rounded-3xl p-8 sm:p-12 card-shadow-lg relative">
        <!-- Pricing Toggle -->
        <div class="flex justify-center mb-8">
          <div class="bg-[#111213] rounded-full p-1 inline-flex">
            <button id="monthly-btn" class="pricing-toggle px-6 py-2 rounded-full text-sm font-semibold transition-all duration-200 gradient-bg text-white">
              Monthly
            </button>
            <button id="annual-btn" class="pricing-toggle px-6 py-2 rounded-full text-sm font-semibold transition-all duration-200 text-slate-400 hover:text-white relative">
              Annual
              <span class="absolute -top-2 -right-2 gradient-bg text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">
                20% OFF
              </span>
            </button>
          </div>
        </div>

        <!-- Price -->
        <div class="text-center mb-8 pt-4">
          <div class="flex items-baseline justify-center gap-1 mb-2">
            <span id="price-amount" class="text-6xl sm:text-7xl font-bold gradient-text" data-monthly="300" data-annual="2880">$300</span>
            <span id="price-period" class="text-xl text-slate-400 font-medium">/month</span>
          </div>
          <p id="price-description" class="text-slate-300">Everything your business needs to dominate</p>
        </div>

        <!-- Features List -->
        <div class="space-y-4 mb-8">
          {includedFeatures.map((feature) => (
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 gradient-bg rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-slate-200">{feature}</span>
            </div>
          ))}
        </div>

        <!-- Free Website Highlight -->
        <div class="bg-[#111213] rounded-2xl p-6 mb-8 border border-white/10">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 gradient-bg rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
            </div>
            <div>
              <div class="font-bold text-white">FREE Professional Website</div>
              <div class="text-sm text-slate-400">Custom design & development included with subscription</div>
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        <a
          href="https://wa.me/8801951284128"
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full gradient-bg text-white text-center py-4 rounded-2xl text-lg font-semibold hover:opacity-90 transition-opacity shadow-lg shadow-blue-primary/30"
        >
          Get Started Today
        </a>
        <p class="text-center text-sm text-slate-400 mt-4">
          No contracts. Cancel anytime. Setup takes 24 hours.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const monthlyBtn = document.getElementById('monthly-btn');
  const annualBtn = document.getElementById('annual-btn');
  const priceAmount = document.getElementById('price-amount');
  const pricePeriod = document.getElementById('price-period');
  const priceDescription = document.getElementById('price-description');

  let isAnnual = false;

  function updatePricing() {
    if (isAnnual) {
      priceAmount.textContent = '$2880';
      pricePeriod.textContent = '/year';
      priceDescription.textContent = 'Billed annually — save $720!';
      monthlyBtn.classList.remove('gradient-bg', 'text-white');
      monthlyBtn.classList.add('text-slate-400', 'hover:text-white');
      annualBtn.classList.remove('text-slate-400', 'hover:text-white');
      annualBtn.classList.add('gradient-bg', 'text-white');
    } else {
      priceAmount.textContent = '$300';
      pricePeriod.textContent = '/month';
      priceDescription.textContent = 'Everything your business needs to dominate';
      annualBtn.classList.remove('gradient-bg', 'text-white');
      annualBtn.classList.add('text-slate-400', 'hover:text-white');
      monthlyBtn.classList.remove('text-slate-400', 'hover:text-white');
      monthlyBtn.classList.add('gradient-bg', 'text-white');
    }
  }

  monthlyBtn.addEventListener('click', () => {
    isAnnual = false;
    updatePricing();
  });

  annualBtn.addEventListener('click', () => {
    isAnnual = true;
    updatePricing();
  });
</script>
