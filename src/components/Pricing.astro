---
const plans = [
  {
    name: 'Basic',
    monthlyDisplay: '$299',
    annualMonthlyDisplay: '$249',
    annualBillingDisplay: 'Billed $2,990 annually',
    description: 'Perfect for small businesses getting started with a virtual receptionist',
    features: [
      '600 Call Minutes/month',
      '24/7 Call Answering',
      'Setup Using Your Business Information',
      'Appointment Booking (1 Calendar)',
      '1 Customer Management Integration',
      'Daily Call Reports',
      '1 Free Phone Number',
    ],
    cta: 'Contact Sales',
    popular: false,
  },
  {
    name: 'Pro',
    monthlyDisplay: '$599',
    annualMonthlyDisplay: '$499',
    annualBillingDisplay: 'Billed $5,990 annually',
    description: 'Built for growing businesses that need advanced capabilities',
    features: [
      '1,200 Call Minutes/month',
      'Everything in Basic',
      'Live Transfer to Your Team',
      'Multilingual Support',
      'Meta/Facebook Lead Integration',
      'Daily Call Recordings & Written Records',
      '3 Free Phone Numbers',
    ],
    cta: 'Contact Sales',
    popular: false,
  },
  {
    name: 'Plus',
    monthlyDisplay: '$999',
    annualMonthlyDisplay: '$832',
    annualBillingDisplay: 'Billed $9,990 annually',
    description: 'Most popular for scaling teams that need more power',
    features: [
      '2,400 Call Minutes/month',
      'Everything in Pro',
      'Scheduled Outbound Call Campaigns',
      'Multi-Location Workspace Management',
      'Customer Management & Calendar Integrations',
      'Priority Email & Chat Support',
      '5 Free Phone Numbers',
    ],
    cta: 'Contact Sales',
    popular: true,
  },
  {
    name: 'Max',
    monthlyDisplay: '$1,999',
    annualMonthlyDisplay: '$1,666',
    annualBillingDisplay: 'Billed $19,990 annually',
    description: 'For enterprises that need maximum capacity and customization',
    features: [
      '5,000 Call Minutes/month',
      'Everything in Plus',
      'Enterprise Compliance (HIPAA, GDPR, SOC 2)',
      'Ongoing Call Quality Improvements',
      'Custom Integrations & Developer Access',
      'Dedicated Priority Support & Setup Assistance',
    ],
    cta: 'Contact Sales',
    popular: false,
  },
]
---


<section id="pricing" class="scroll-mt-16 py-20 lg:scroll-mt-20 lg:py-32 bg-navy relative overflow-hidden content-auto">
  <!-- Background Elements: skip heavy blurs on small screens -->
  <div class="absolute inset-0 overflow-hidden hidden md:block" aria-hidden="true">
    <div class="orb orb-sm absolute -top-40 -right-40 w-80 h-80 bg-green-primary/30"></div>
    <div class="orb orb-sm absolute -bottom-40 -left-40 w-80 h-80 bg-green-accent/25"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
        Simple, Transparent <span class="gradient-green-text">Pricing</span>
      </h2>
      <p class="text-lg text-slate-300">
        Choose the plan that fits your business. Upgrade or downgrade anytime.
      </p>
    </div>

    <!-- Billing Toggle -->
    <div class="flex justify-center mb-12">
      <div class="bg-[#1E1F21] rounded-full p-1.5 inline-flex items-center border border-white/10">
        <button
          type="button"
          id="monthly-btn"
          aria-pressed="true"
          class="pricing-toggle px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 toggle-active"
        >
          Monthly
        </button>
        <button
          type="button"
          id="annual-btn"
          aria-pressed="false"
          class="pricing-toggle px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 toggle-inactive relative"
        >
          Annually
          <span class="absolute -top-2.5 -right-3 bg-gradient-to-r from-red-500 to-pink-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full shadow-lg">
            Save ~17%
          </span>
        </button>
      </div>
    </div>

    <!-- Pricing Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto">
      {plans.map((plan) => (
        <div class={`pricing-card bg-slate-bg rounded-3xl p-6 sm:p-8 relative ${plan.popular ? 'pricing-card-popular glow-green' : plan.name === 'Max' ? 'border-2 border-amber-500/30 hover:border-amber-500/50 shadow-lg shadow-amber-500/10' : 'border border-white/10 hover:border-white/20'}`}>
          <!-- Popular Badge -->
          {plan.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="gradient-green text-white px-5 py-1.5 rounded-full text-xs font-bold shadow-lg glow-green">
                Most Popular
              </span>
            </div>
          )}

          <!-- Premium Badge -->
          {plan.name === 'Max' && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="bg-gradient-to-r from-amber-500 to-orange-500 text-white px-5 py-1.5 rounded-full text-xs font-bold shadow-lg shadow-amber-500/30">
                Premium
              </span>
            </div>
          )}

          <!-- Plan Name -->
          <div class="mb-6 text-center">
            <h3 class="text-xl font-bold text-white mb-2">{plan.name}</h3>
            <p class="text-sm text-slate-400">{plan.description}</p>
          </div>

          <!-- Price -->
          <div class="mb-8 text-center" data-pricing-display>
            <div class="flex justify-center">
              <div class="relative inline-flex items-baseline">
                <span
                  class="pricing-tilde absolute right-full mr-1 hidden text-5xl font-bold text-white"
                  aria-hidden="true"
                >~</span>
                <span
                  class="pricing-amount text-5xl font-bold text-white"
                  data-monthly-display={plan.monthlyDisplay}
                  data-annual-monthly-display={plan.annualMonthlyDisplay}
                  data-annual-billing-display={plan.annualBillingDisplay}
                >{plan.monthlyDisplay}</span>
              </div>
            </div>
            <p class="pricing-billing text-sm text-slate-500 mt-1">Billed monthly</p>
            <p class="text-xs text-slate-500 mt-1">+ $1,200 one-time Service Setup Fee</p>
          </div>

          <!-- Features -->
          <div class="space-y-3.5 mb-8">
            {plan.features.map((feature) => (
              <div class="flex items-start gap-3">
                <div class={`w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 ${plan.popular ? 'gradient-green' : 'gradient-bg'}`}>
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm text-slate-300">{feature}</span>
              </div>
            ))}
          </div>

          <!-- CTA Button -->
          <a
            href="https://cal.com/ringlume/meeting"
            data-plan={plan.name.toLowerCase()}
            aria-describedby={`cta-legal-notice-${plan.name.toLowerCase()}`}
            class={`block w-full text-center py-3.5 rounded-xl text-sm font-semibold transition-all duration-300 cursor-pointer ${
              plan.popular
                ? 'gradient-green text-white hover:[background:linear-gradient(135deg,#3ABF52,#269635)] hover:scale-[1.02] shadow-lg glow-green'
                : 'bg-[#181a1d] text-white border border-white/30 hover:bg-[#24272b] hover:border-white/50 hover:scale-[1.02]'
            }`}
          >
            {plan.cta}
          </a>

          <p id={`cta-legal-notice-${plan.name.toLowerCase()}`} class="mt-3 text-center text-[11px] leading-relaxed text-slate-500">
            By continuing, you agree to our
            <a href="/terms" class="text-green-primary underline underline-offset-2 hover:text-green-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-accent focus-visible:ring-offset-2 focus-visible:ring-offset-slate-bg">Terms of Service</a>,
            <a href="/privacy" class="text-green-primary underline underline-offset-2 hover:text-green-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-accent focus-visible:ring-offset-2 focus-visible:ring-offset-slate-bg">Privacy Policy</a>, and
            <a href="/refund" class="text-green-primary underline underline-offset-2 hover:text-green-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-accent focus-visible:ring-offset-2 focus-visible:ring-offset-slate-bg">Refund Policy</a>.
          </p>
        </div>
      ))}
    </div>

    <!-- Trust Text -->
    <div class="mt-12 text-center space-y-2">
      <p class="text-sm text-slate-400">
        No hidden fees. Cancel anytime. Setup in 24–48 hours. Minutes reset monthly. 7-day guarantee: 100% refund on subscription charges and 50% on the Service Setup Fee.
      </p>
      <p class="text-sm text-slate-400">
        Extra usage: $0.20/min.
      </p>
    </div>
  </div>
</section>

<script>
  const monthlyBtn = document.getElementById('monthly-btn')
  const annualBtn = document.getElementById('annual-btn')

  monthlyBtn?.addEventListener('click', () => setBillingPeriod(false))
  annualBtn?.addEventListener('click', () => setBillingPeriod(true))

  function setBillingPeriod(annual: boolean) {
    updateDisplay(annual)
    monthlyBtn?.classList.toggle('toggle-active', !annual)
    monthlyBtn?.classList.toggle('toggle-inactive', annual)
    monthlyBtn?.setAttribute('aria-pressed', String(!annual))
    annualBtn?.classList.toggle('toggle-active', annual)
    annualBtn?.classList.toggle('toggle-inactive', !annual)
    annualBtn?.setAttribute('aria-pressed', String(annual))
  }

  function updateDisplay(annual: boolean) {
    const tildes = document.querySelectorAll('.pricing-tilde')
    const amounts = document.querySelectorAll<HTMLElement>('.pricing-amount')
    amounts.forEach(el => {
      const attr = annual ? 'annualMonthlyDisplay' : 'monthlyDisplay'
      el.textContent = el.dataset[attr] || '--'

      const container = el.closest('[data-pricing-display]')
      const billing = container?.querySelector('.pricing-billing')
      if (billing) {
        billing.textContent = annual
          ? (el.dataset.annualBillingDisplay || 'Billed annually')
          : 'Billed monthly'
      }
    })

    tildes.forEach(el => {
      el.classList.toggle('hidden', !annual)
    })
  }
</script>
