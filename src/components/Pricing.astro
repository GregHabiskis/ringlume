---
import { getPlans, formatPrice } from '../lib/pricing'
import { tinaField } from '@tinacms/astro'
import { formatCopy } from '../lib/tina/model'

interface Props {
	detailed?: boolean
}

const { detailed = false } = Astro.props
const site = Astro.locals.site
const copy = site.pricing.copy
const plans = getPlans(site.pricing)
const Heading = detailed ? 'h1' : 'h2'
const detailsLink = detailed
	? { href: site.links.planComparison, label: copy.compareFeatures }
	: { href: site.links.pricing, label: copy.explorePricing }
const mobileAlignment = {
	billing:
		!detailed && 'max-sm:flex-col max-sm:justify-center max-sm:text-center',
	disclosure: !detailed && 'max-sm:items-center max-sm:text-center',
}
---

<section
	class:list={[
		'scrim content-auto',
		detailed ? 'pb-16 lg:pb-24' : 'py-16 lg:py-24',
	]}
	aria-labelledby="pricing-heading"
	data-pricing-section
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mb-8 grid gap-5 lg:grid-cols-2 lg:items-end lg:gap-16">
			<Heading
				id="pricing-heading"
				class="reveal-text max-w-xl text-h2 font-bold text-fg-1"
			>
				<span data-tina-field={tinaField(copy, 'heading')}>{copy.heading}</span><br /><span class="text-brand-text" data-tina-field={tinaField(copy, 'accent')}
					>{copy.accent}</span
				>
			</Heading>
			<p
				class="max-w-lg text-base leading-relaxed text-fg-3 lg:justify-self-end"
				data-tina-field={tinaField(copy, 'description')}
			>
				{copy.description}
			</p>
		</header>

		<div
			class:list={[
				'mb-6 flex flex-wrap items-center justify-between gap-4',
				mobileAlignment.billing,
			]}
		>
			<p class="text-xs text-fg-3" data-tina-field={tinaField(copy, 'pricesUsd')}>{copy.pricesUsd}</p>
			<div
				class="glass glass-fill glass-regular inline-flex rounded-full p-1"
				role="group"
				aria-label={copy.billingPeriod}
				data-tina-field={tinaField(copy, 'billingPeriod')}
			>
				<button
					type="button"
					id="monthly-btn"
					data-tina-field={tinaField(copy, 'monthly')}
					aria-pressed="true"
					class="pricing-toggle toggle-active min-h-11 rounded-full px-4 text-xs font-semibold"
					>{copy.monthly}</button
				>
				<button
					type="button"
					id="annual-btn"
					data-tina-field={tinaField(copy, 'annually')}
					aria-pressed="false"
					class="pricing-toggle toggle-inactive relative min-h-11 rounded-full px-4 text-xs font-semibold"
					>{copy.annually} <span
						class="annual-discount absolute -top-3 right-0 whitespace-nowrap rounded-full px-2 py-1 text-xs leading-none font-bold text-white"
						data-tina-field={tinaField(copy, 'savings')}
						>{copy.savings}</span
						></button
				>
			</div>
		</div>

		<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
			{
				plans.map((plan) => (
					<article
						class:list={[
							'plan-card glass glass-fill glass-regular flex min-w-0 flex-col rounded-3xl p-5 lg:p-6',
							plan.recommended && 'plan-recommended',
						]}
					>
						<div class="flex min-h-7 items-center justify-between gap-2">
							<h3 class="font-sans text-lg font-semibold text-fg-1" data-tina-field={tinaField(site.pricing.plans[plan.id], 'name')}>
								{plan.name}
							</h3>
							{plan.recommended && (
								<span class="rounded-full bg-brand/15 px-2.5 py-1 text-xs font-semibold text-brand-text">
									<span data-tina-field={tinaField(copy, 'mostPopular')}>{copy.mostPopular}</span>
								</span>
							)}
						</div>
						<p class="mt-1 text-xs text-fg-3" data-tina-field={tinaField(site.pricing.plans[plan.id], 'description')}>{plan.description}</p>
						<div class="mt-6" data-pricing-display>
							<p class="flex items-baseline gap-1 whitespace-nowrap">
								<span
									class="pricing-tilde hidden text-lg text-fg-3"
									aria-hidden="true"
								>
									{copy.approximate}
								</span>
								<span
									class="pricing-amount text-4xl font-semibold tracking-tighter text-fg-1"
									data-monthly-display={formatPrice(plan.monthly)}
									data-tina-field={tinaField(site.pricing.plans[plan.id], 'monthly')}
									data-annual-monthly-display={formatPrice(plan.annualMonthly)}
									data-annual-billing-display={formatCopy(copy.billedAnnually, { price: formatPrice(plan.annualTotal) })}
									data-monthly-billing-display={copy.billedMonthly}
								>
									{formatPrice(plan.monthly)}
								</span>
								<span class="text-xs text-fg-3" data-tina-field={tinaField(copy, 'perMonth')}>{copy.perMonth}</span>
							</p>
							<p
								class="pricing-billing mt-2 text-xs text-fg-3"
								aria-live="polite"
								data-tina-field={tinaField(copy, 'billedMonthly')}
							>
								{copy.billedMonthly}
							</p>
							<p class="mt-2 text-xs leading-relaxed text-fg-3" data-tina-field={tinaField(copy, 'setupFee')}>
								{formatCopy(copy.setupFee, { price: formatPrice(plan.setupFee) })}
							</p>
							<p class="mt-1 text-xs text-fg-3" data-tina-field={tinaField(copy, 'overage')}>
								{formatCopy(copy.overage, { rate: plan.overagePerMinute.toFixed(2) })}
							</p>
						</div>
						<ul class="my-6 space-y-3 border-t border-line pt-5">
							{plan.benefits.map((benefit, index) => (
								<li class="flex items-start gap-2 text-sm leading-relaxed text-fg-2" data-tina-field={tinaField(site.pricing.plans[plan.id].benefits as Record<string, unknown>, `item${index + 1}`)}>
									<svg
										width="14"
										height="18"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										class="shrink-0 text-brand-text"
										aria-hidden="true"
									>
										<path d="m5 12 4 4L19 6" />
									</svg>
									{benefit}
								</li>
							))}
						</ul>
						<a
							href={site.links.freeDemo}
							data-plan={plan.id}
							data-tina-field={tinaField(site.links, 'freeDemo')}
							class:list={[
								'btn mt-auto w-full px-3 text-sm',
								plan.recommended ? 'btn-primary' : 'btn-secondary',
							]}
						>
							<span data-tina-field={tinaField(site.shared, 'getFreeDemo')}>{site.shared.getFreeDemo}</span>
						</a>
					</article>
				))
			}
		</div>

		<div
			class:list={[
				'mt-7 flex flex-col gap-5 border-b border-line pb-8 sm:flex-row sm:items-start sm:justify-between',
				mobileAlignment.disclosure,
			]}
		>
			<div>
				{
					detailed && (
						<p
							class="mb-3 max-w-xl text-sm leading-relaxed text-fg-2"
							data-setup-summary
							data-tina-field={tinaField(copy, 'setupIntro')}
						>
							{copy.setupIntro}{' '}
							<a
								href="/terms#setup-time"
								class="underline underline-offset-4 hover:text-fg-1"
								data-tina-field={tinaField(copy, 'setupDetails')}
							>
								{copy.setupDetails}
							</a>{copy.end}
						</p>
					)
				}
				<p class="text-xs leading-relaxed text-fg-3" data-tina-field={tinaField(copy, 'cancelNotice')}>
					{copy.cancelNotice}
				</p>
				<p class="mt-2 text-xs leading-relaxed text-fg-3">
					<a
						href="/terms#setup-fee-upgrades"
						data-tina-field={tinaField(copy, 'upgradeNotice')}
						class="underline underline-offset-4 hover:text-fg-1"
						>{copy.upgradeNotice}</a
					>
				</p>
			</div>
			<a
				href={detailsLink.href}
				data-tina-field={tinaField(site.links, detailed ? 'planComparison' : 'pricing')}
				class="inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-fg-1 underline underline-offset-8 hover:text-brand-text"
				><span data-tina-field={tinaField(copy, detailed ? 'compareFeatures' : 'explorePricing')}>{detailsLink.label}</span><span aria-hidden="true">&rarr;</span></a
			>
		</div>
	</div>
</section>

<style>
	.annual-discount {
		background: var(--annual-discount-fill);
	}
	.plan-card {
		--glass-edge-hi: color-mix(in srgb, var(--fg-1) 16%, transparent);
	}
	.plan-recommended {
		border-color: color-mix(in srgb, var(--brand) 45%, transparent);
		background: linear-gradient(
			160deg,
			color-mix(in srgb, var(--brand) 8%, var(--bg-alt)),
			var(--bg-alt) 60%
		);
	}
	@media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
		.plan-recommended {
			background: var(--bg-alt);
		}
	}
</style>

<script>
	import { initPricing } from "../scripts/pricing"
	document.querySelectorAll<HTMLElement>("[data-pricing-section]").forEach(initPricing)
</script>
