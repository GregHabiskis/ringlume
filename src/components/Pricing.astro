---
const plans = [
  {
    name: 'Basic',
    monthlyPrice: 299,
    annualPrice: 2990,
    annualMonthly: 249,
    monthlyPriceId: import.meta.env.PUBLIC_PADDLE_BASIC_MONTHLY_PRICE_ID || '',
    annualPriceId: import.meta.env.PUBLIC_PADDLE_BASIC_ANNUAL_PRICE_ID || '',
    description: 'Perfect for small businesses getting started with Voice AI',
    features: [
      '200 Voice Calling Minutes',
      '24/7 Intelligent Call Handling',
      'Knowledge Base Training',
      'Automated Booking (1 Calendar)',
      'Custom CRM Integrations',
      'Daily Post-Call Analytics Reports',
    ],
    cta: 'Get Started',
    popular: false,
  },
  {
    name: 'Pro',
    monthlyPrice: 499,
    annualPrice: 4990,
    annualMonthly: 416,
    monthlyPriceId: import.meta.env.PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID || '',
    annualPriceId: import.meta.env.PUBLIC_PADDLE_PRO_ANNUAL_PRICE_ID || '',
    description: 'Most popular for growing businesses that need more power',
    features: [
      '500 Voice Calling Minutes',
      'Everything in Basic',
      'Live Transfer & Human Escalation',
      'Multilingual Support',
      'Daily Post-Call Recordings & Transcripts',
    ],
    cta: 'Get Started',
    popular: true,
  },
  {
    name: 'Max',
    monthlyPrice: 999,
    annualPrice: 9990,
    annualMonthly: 832,
    monthlyPriceId: import.meta.env.PUBLIC_PADDLE_MAX_MONTHLY_PRICE_ID || '',
    annualPriceId: import.meta.env.PUBLIC_PADDLE_MAX_ANNUAL_PRICE_ID || '',
    description: 'For businesses that need maximum capacity and customization',
    features: [
      '1,200 Voice Calling Minutes/mo',
      'Everything in Pro',
      'Workflow-Triggered Outbound Campaigns',
      'Continuous AI Performance Optimizations',
      'Custom Feature Integrations',
      'Dedicated Priority Support',
    ],
    cta: 'Get Started',
    popular: false,
  },
]
---

<section id="pricing" class="py-20 lg:py-32 bg-navy relative overflow-hidden content-auto">
  <!-- Background Elements: skip heavy blurs on small screens -->
  <div class="absolute inset-0 overflow-hidden hidden md:block" aria-hidden="true">
    <div class="orb orb-sm absolute -top-40 -right-40 w-80 h-80 bg-green-primary/15"></div>
    <div class="orb orb-sm absolute -bottom-40 -left-40 w-80 h-80 bg-green-accent/10"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
        Simple, Transparent <span class="gradient-green-text">Pricing</span>
      </h2>
      <p class="text-lg text-slate-300">
        Choose the plan that fits your business. Upgrade or downgrade anytime.
      </p>
    </div>

    <!-- Billing Toggle -->
    <div class="flex justify-center mb-12">
      <div class="bg-[#1E1F21] rounded-full p-1.5 inline-flex items-center border border-white/10">
        <button
          id="monthly-btn"
          class="pricing-toggle px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 toggle-active"
        >
          Monthly
        </button>
        <button
          id="annual-btn"
          class="pricing-toggle px-6 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 toggle-inactive relative"
        >
          Annually
          <span class="absolute -top-2.5 -right-3 bg-gradient-to-r from-red-500 to-pink-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full shadow-lg">
            Save ~17%
          </span>
        </button>
      </div>
    </div>

    <!-- Pricing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {plans.map((plan) => (
        <div class={`pricing-card bg-slate-bg rounded-3xl p-8 relative ${plan.popular ? 'pricing-card-popular glow-green' : plan.name === 'Max' ? 'border-2 border-amber-500/30 hover:border-amber-500/50 shadow-lg shadow-amber-500/10' : 'border border-white/10 hover:border-white/20'}`}>
          <!-- Popular Badge -->
          {plan.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="gradient-green text-white px-5 py-1.5 rounded-full text-xs font-bold shadow-lg glow-green">
                Most Popular
              </span>
            </div>
          )}

          <!-- Premium Badge -->
          {plan.name === 'Max' && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="bg-gradient-to-r from-amber-500 to-orange-500 text-white px-5 py-1.5 rounded-full text-xs font-bold shadow-lg shadow-amber-500/30">
                Premium
              </span>
            </div>
          )}

          <!-- Plan Name -->
          <div class="mb-6 text-center">
            <h3 class="text-xl font-bold text-white mb-2">{plan.name}</h3>
            <p class="text-sm text-slate-400">{plan.description}</p>
          </div>

          <!-- Price -->
          <div class="mb-8 text-center">
            <div class="flex items-baseline justify-center gap-1">
              <span
                class="pricing-tilde text-5xl font-bold text-white transition-all duration-300 opacity-0"
              >
                ~
              </span>
              <span
                class="pricing-amount text-5xl font-bold text-white transition-all duration-300"
                data-monthly={`$${plan.monthlyPrice}`}
                data-annual={`$${plan.annualMonthly}`}
              >
                ${plan.monthlyPrice}
              </span>
              <span
                class="pricing-period text-slate-400 font-medium transition-all duration-300"
                data-monthly="/mo"
                data-annual="/mo"
              >
                /mo
              </span>
            </div>
            <p
              class="pricing-billing text-sm text-slate-500 mt-1 transition-all duration-300"
              data-monthly="Billed monthly"
              data-annual={`Billed $${plan.annualPrice.toLocaleString()}/year`}
            >
              Billed monthly
            </p>
          </div>

          <!-- Features -->
          <div class="space-y-3.5 mb-8">
            {plan.features.map((feature) => (
              <div class="flex items-start gap-3">
                <div class={`w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 ${plan.popular ? 'gradient-green' : 'gradient-bg'}`}>
                  <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm text-slate-300">{feature}</span>
              </div>
            ))}
          </div>

          <!-- CTA Button -->
          <button
            type="button"
            data-plan={plan.name.toLowerCase()}
            data-monthly-price-id={plan.monthlyPriceId}
            data-annual-price-id={plan.annualPriceId}
            class={`block w-full text-center py-3.5 rounded-xl text-sm font-semibold transition-all duration-300 cursor-pointer ${
              plan.popular
                ? 'gradient-green text-white hover:opacity-90 hover:scale-[1.02] shadow-lg glow-green'
                : 'bg-white/5 text-white border border-white/10 hover:bg-white/10 hover:border-white/20 hover:scale-[1.02]'
            }`}
          >
            {plan.cta}
          </button>
        </div>
      ))}
    </div>

    <!-- Trust Text -->
    <div class="mt-12 text-center">
      <p class="text-sm text-slate-400">
        No hidden fees. Cancel anytime. Setup takes 24-48 hours. Included calling minutes reset monthly. 7-Days Money Back Guarantee.
      </p>
    </div>
  </div>
</section>

<script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const paddleToken = import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN;
    const paddleEnv = import.meta.env.PUBLIC_PADDLE_ENVIRONMENT || 'sandbox';
    const setupFeePriceId = import.meta.env.PUBLIC_PADDLE_SETUP_FEE_PRICE_ID;

    if (window.Paddle && paddleToken) {
      Paddle.Environment.set(paddleEnv);
      Paddle.Initialize({ token: paddleToken });
    }

    const monthlyBtn = document.getElementById('monthly-btn');
    const annualBtn = document.getElementById('annual-btn');
    const amounts = document.querySelectorAll('.pricing-amount');
    const periods = document.querySelectorAll('.pricing-period');
    const billings = document.querySelectorAll('.pricing-billing');
    const tildes = document.querySelectorAll('.pricing-tilde');

    let isAnnual = false;

    function updatePricing() {
      amounts.forEach((el) => {
        const amount = el.getAttribute(`data-${isAnnual ? 'annual' : 'monthly'}`);
        if (amount) el.textContent = amount;
      });

      periods.forEach((el) => {
        const period = el.getAttribute(`data-${isAnnual ? 'annual' : 'monthly'}`);
        el.textContent = period || '';
        el.style.display = period ? '' : 'none';
      });

      billings.forEach((el) => {
        const billing = el.getAttribute(`data-${isAnnual ? 'annual' : 'monthly'}`);
        el.textContent = billing || '';
        el.style.display = billing ? '' : 'none';
      });

      tildes.forEach((el) => {
        el.style.opacity = isAnnual ? '1' : '0';
      });

      if (isAnnual) {
        monthlyBtn.classList.remove('toggle-active');
        monthlyBtn.classList.add('toggle-inactive');
        annualBtn.classList.remove('toggle-inactive');
        annualBtn.classList.add('toggle-active');
      } else {
        annualBtn.classList.remove('toggle-active');
        annualBtn.classList.add('toggle-inactive');
        monthlyBtn.classList.remove('toggle-inactive');
        monthlyBtn.classList.add('toggle-active');
      }
    }

    monthlyBtn.addEventListener('click', () => {
      isAnnual = false;
      updatePricing();
    });

    annualBtn.addEventListener('click', () => {
      isAnnual = true;
      updatePricing();
    });

    document.querySelectorAll('[data-plan]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();

        if (!window.Paddle || !paddleToken) {
          console.error('Paddle.js is not available or client token is missing.');
          return;
        }

        const priceId = isAnnual ? btn.dataset.annualPriceId : btn.dataset.monthlyPriceId;

        if (!priceId) {
          console.error('Missing Paddle price ID for plan:', btn.dataset.plan);
          return;
        }

        if (!setupFeePriceId) {
          console.error('Missing Paddle setup fee price ID.');
          return;
        }

        Paddle.Checkout.open({
          items: [
            { priceId, quantity: 1 },
            { priceId: setupFeePriceId, quantity: 1 },
          ],
        });
      });
    });
  });
</script>
