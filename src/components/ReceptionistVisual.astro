---
import {
	VISUAL_CONVERSATION,
	VISUAL_DURATION,
	getVisualFrame,
	getVisualMessageParts,
} from '../lib/receptionist-visual';

const finalFrame = getVisualFrame(VISUAL_DURATION);
---

<section
	id="visual"
	class="scrim content-auto scroll-mt-24 py-16 lg:py-24"
	aria-labelledby="visual-heading"
>
	<!-- Preserve existing Features bookmarks without a second demonstration. -->
	<span id="capabilities" class="block scroll-mt-24" aria-hidden="true"></span>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="mb-8 text-center lg:mb-10">
			<h2 id="visual-heading" class="reveal-text text-h2 font-bold text-fg-1">
				A call comes in.
				<br class="sm:hidden" />{' '}
				<span class="text-brand-text">Ringlume takes it from here.</span>
			</h2>
			<p class="mt-4 text-fg-3">
				Watch a tree-care request become a booked estimate.
			</p>
		</header>

		<figure class="visual-shell glass glass-fill glass-regular glass-card">
			<figcaption class="visual-toolbar">
				<span class="visual-example">
					<span class="visual-dot" aria-hidden="true"></span>Illustrative
					example
				</span>
				<button
					type="button"
					class="visual-playback"
					data-visual-playback
					hidden
					aria-pressed="false"
				>
					<svg
						width="14"
						height="14"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<path d="M5 3v10M11 3v10"></path>
					</svg>
					<span>Pause animation</span>
				</button>
				<span class="sr-only">
					A fictional after-hours call to Ringlume. It captures Alex Morgan’s
					request for oak removal at 24 Maple Lane, books an agreed Tuesday
					estimate, and prepares a summary for the team. Booking follows the
					business’s availability and rules. This is a silent, condensed
					illustration, not a live dashboard or a timing claim.
				</span>
			</figcaption>

			<div class="visual-scene" data-visual-scene data-phase={finalFrame.phase}>
				<div class="visual-statusbar" aria-hidden="true">
					<div class="visual-status">
						<span class="visual-dot"></span>
						<span data-visual-status>{finalFrame.status}</span>
					</div>
					<span class="visual-afterhours">
						9:47 PM <span>· After hours</span>
					</span>
				</div>

				<div class="visual-workspace">
					<div class="visual-call">
						<div class="visual-call-heading">
							<div class="visual-caller-icon" aria-hidden="true">
								<svg
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="m7 3 3 5-2 2a15 15 0 0 0 6 6l2-2 5 3-1 4C11 22 2 13 3 4l4-1Z"></path>
								</svg>
							</div>
							<div>
								<p class="visual-company-name">Ringlume</p>
								<p class="visual-call-title">One less call to miss.</p>
							</div>
							<span class="visual-timer" data-visual-count aria-hidden="true">
								08 / 08
							</span>
						</div>

						<div class="visual-chat">
							<div
								class="visual-incoming"
								data-visual-incoming
								aria-hidden="true"
								hidden
							>
								<div class="visual-ring-mark">
									<svg
										width="32"
										height="32"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.4"
										stroke-linecap="round"
									>
										<path d="M4 15v-4a8 8 0 0 1 16 0v4M4 12H2v6h4v-6H4Zm16 0h2v6h-4v-6h2ZM18 19c0 2-3 2-6 2"></path>
									</svg>
								</div>
								<p class="text-lg font-semibold text-fg-1">
									Your crew’s off the clock.
								</p>
								<p class="mt-2 text-sm text-fg-3">Your receptionist isn’t.</p>
							</div>
							<div
								class="visual-conversation"
								data-visual-inbox
								tabindex="0"
								role="region"
								aria-label="Illustrative tree-care conversation"
							>
								<ol class="visual-messages" role="list" aria-live="off">
									{VISUAL_CONVERSATION.map(({ speaker }, index) => (
										<li
											class:list={[
												'visual-bubble',
												`visual-bubble-${speaker}`,
												speaker === 'receptionist' &&
													'glass glass-fill glass-regular glass-card',
											]}
											data-visual-message
										>
											<span class="sr-only">
												{speaker === 'caller' ? 'Caller' : 'Ringlume'}:{' '}
											</span>
											“
											{getVisualMessageParts(index).map((part) =>
												part.detail ? (
													<mark class="visual-detail">{part.text}</mark>
												) : (
													part.text
												),
											)}
											”
										</li>
									))}
								</ol>
							</div>
						</div>

						<div class="visual-call-footer" aria-hidden="true">
							<span class="visual-typing">
								<i></i>
								<i></i>
								<i></i>
							</span>
							<span data-visual-caption>Example conversation</span>
							<span class="visual-call-clock" data-visual-timer>
								{finalFrame.timer}
							</span>
						</div>
					</div>

					<div class="visual-outcomes" aria-hidden="true">
						<div class="visual-calendar">
							<div class="visual-calendar-heading">
								<div>
									<p class="visual-label visual-ui-label">Your calendar</p>
									<p class="visual-day">Tuesday</p>
								</div>
								<span class="visual-calendar-icon">
									<svg
										width="20"
										height="20"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
									>
										<rect x="3" y="5" width="18" height="16" rx="3"></rect>
										<path d="M7 3v4m10-4v4M3 11h18"></path>
									</svg>
								</span>
							</div>
							<div class="visual-schedule">
								<div class="visual-slot">
									<span>9:00</span>
									<div class="visual-existing">Crew check-in</div>
								</div>
								<div class="visual-slot visual-slot-booking">
									<span>10:30</span>
									<div class="visual-available">Available for an estimate</div>
									<div class="visual-booking-mount" data-visual-booking-mount>
										<div
											class="visual-booking visual-transfer"
											data-visual-booking
										>
											<div>
												<span class="visual-label">Estimate visit</span>
												<p>Oak removal</p>
												<span class="text-xs">Alex Morgan · 24 Maple Lane</span>
											</div>
										</div>
									</div>
								</div>
								<div class="visual-slot">
									<span>12:00</span>
									<div class="visual-empty-slot"></div>
								</div>
							</div>
						</div>
						<div class="visual-summary-mount" data-visual-summary-mount>
							<div
								class="visual-summary visual-transfer glass glass-fill glass-regular glass-card"
								data-visual-summary
							>
								<div class="visual-summary-icon">
									<svg
										width="19"
										height="19"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<path d="M8 3h8l4 4v14H4V3h4Zm8 0v5h4M8 12h8m-8 4h5"></path>
									</svg>
								</div>
								<div>
									<p class="visual-label visual-ui-label">
										Ready for your team
									</p>
									<div class="visual-summary-content">
										<p class="text-sm font-semibold text-fg-1">
											Alex Morgan · Estimate booked
										</p>
										<p class="mt-1 text-xs leading-relaxed text-fg-3">
											Front-yard oak removal. Tuesday, 10:30.
											<br />
											Callback: 202-555-0148
										</p>
									</div>
								</div>
							</div>
							<p class="visual-summary-waiting" data-visual-waiting hidden>
								Call details will appear here.
							</p>
						</div>
					</div>
				</div>

				<ol
					class="visual-progress"
					role="list"
					aria-label="Replay a storyboard event"
				>
					{['Call answered', 'Estimate booked', 'Team updated'].map(
						(label, index) => (
							<li>
								<button
									type="button"
									class="visual-step-button visual-step-done"
									data-visual-step={index}
									aria-label={`Replay from ${label.toLowerCase()}`}
									disabled
								>
									<span class="visual-step-number">0{index + 1}</span>
									<span>{label}</span>
									<svg
										class="visual-step-border"
										width="100%"
										height="100%"
										aria-hidden="true"
									>
										<rect x="1" y="1" rx="15" pathLength="100"></rect>
									</svg>
									<svg
										class="visual-step-check"
										data-visual-check
										width="22"
										height="22"
										viewBox="0 0 26 26"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path
											d="M4.5 12.5c1.6 1.3 3 3.2 4.4 4.7C12 12.8 16.1 8.1 21 4.5"
											pathLength="100"
										></path>
									</svg>
								</button>
							</li>
						),
					)}
				</ol>
			</div>

			<div class="visual-footnote">
				<p>
					<strong class="font-medium text-fg-2">
						Booking is one possible outcome.
					</strong>
					Ringlume can instead transfer the call or take a message, following
					your rules and availability.
				</p>
				<a href="/#demo" class="visual-try">
					Try it now <span aria-hidden="true">↗</span>
				</a>
			</div>
		</figure>
	</div>
</section>

<script>
	import {
		VISUAL_TRANSFERS,
		createVisualPlayback,
		getVisualFrame,
		getVisualTransferOrigin,
	} from '../lib/receptionist-visual';

	const root = document.querySelector<HTMLElement>('#visual');
	if (root) initializeVisual(root);

	function initializeVisual(root: HTMLElement) {
		const scene = root.querySelector<HTMLElement>('[data-visual-scene]')!;
		const button = root.querySelector<HTMLButtonElement>(
			'[data-visual-playback]',
		)!;
		const label = button.querySelector('span')!;
		const controlIcon = button.querySelector('path')!;
		const status = root.querySelector<HTMLElement>('[data-visual-status]')!;
		const timer = root.querySelector<HTMLElement>('[data-visual-timer]')!;
		const incoming = root.querySelector<HTMLElement>('[data-visual-incoming]')!;
		const inbox = root.querySelector<HTMLElement>('[data-visual-inbox]')!;
		const list = root.querySelector<HTMLElement>('.visual-messages')!;
		const messages = [
			...root.querySelectorAll<HTMLElement>('[data-visual-message]'),
		];
		const counter = root.querySelector<HTMLElement>('[data-visual-count]')!;
		const caption = root.querySelector<HTMLElement>('[data-visual-caption]')!;
		const waiting = root.querySelector<HTMLElement>('[data-visual-waiting]')!;
		const steps = [
			...root.querySelectorAll<HTMLButtonElement>('[data-visual-step]'),
		];
		const progressControls =
			root.querySelector<HTMLElement>('.visual-progress')!;
		const borders = steps.map((step) => step.querySelector('rect')!);
		const checks = steps.map((step) =>
			step.querySelector<SVGSVGElement>('[data-visual-check]')!,
		);
		const checkPaths = checks.map((check) => check.querySelector('path')!);
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
		const clock = createVisualPlayback();
		const flights = (['booking', 'summary'] as const).map((kind) => ({
			kind,
			element: root.querySelector<HTMLElement>(`[data-visual-${kind}]`)!,
			mount: root.querySelector<HTMLElement>(`[data-visual-${kind}-mount]`)!,
			source: messages[VISUAL_TRANSFERS[kind].source],
			started: false,
			progress: 0,
		}));
		let visible = false;
		let sceneVisible = false;
		let controlsVisible = false;
		let request: number | undefined;
		let lastTime: number | null = null;
		let visibleMessages = 0;
		let conversationOffset = 0;

		function positionConversation() {
			const last = messages[visibleMessages - 1];
			conversationOffset = last
				? Math.max(
						0,
						last.offsetTop + last.offsetHeight - inbox.clientHeight + 8,
					)
				: 0;
			list.style.setProperty(
				'--conversation-offset',
				`${-conversationOffset}px`,
			);
		}

		function measureFlight(flight: (typeof flights)[number]) {
			const origin = getVisualTransferOrigin(
				flight.source.getBoundingClientRect(),
				inbox.getBoundingClientRect(),
				flight.mount.getBoundingClientRect(),
			);
			flight.element.style.setProperty('--from-x', `${origin.x}px`);
			flight.element.style.setProperty('--from-y', `${origin.y}px`);
		}

		function render() {
			const state = clock.state;
			const frame = getVisualFrame(
				state.elapsed,
				state.segmentIndex ?? undefined,
			);
			const wasComplete = scene.classList.contains('visual-complete');
			scene.dataset.phase = String(frame.phase);
			if (status.textContent !== frame.status)
				status.textContent = frame.status;
			if (timer.textContent !== frame.timer) timer.textContent = frame.timer;
			if (label.textContent !== state.label) {
				label.textContent = state.label;
				controlIcon.setAttribute(
					'd',
					state.complete
						? 'M3 5a5 5 0 1 1-1 5M3 1v4h4'
						: state.paused
							? 'm5 3 7 5-7 5Z'
							: 'M5 3v10M11 3v10',
				);
			}
			if (state.complete) button.removeAttribute('aria-pressed');
			else button.setAttribute('aria-pressed', String(state.paused));
			scene.classList.toggle('visual-complete', frame.complete);
			inbox.tabIndex = reducedMotion.matches || frame.complete ? 0 : -1;
			incoming.hidden = frame.answered;
			scene.classList.toggle(
				'visual-resetting',
				frame.messages < visibleMessages || frame.messages === 0,
			);
			scene.classList.toggle(
				'visual-is-typing',
				frame.typing && !reducedMotion.matches,
			);
			messages.forEach((message, index) => {
				message.classList.toggle('is-shown', index < frame.messages);
				message.classList.toggle(
					'visual-details-captured',
					frame.highlights[index],
				);
			});
			if (visibleMessages !== frame.messages) {
				visibleMessages = frame.messages;
				positionConversation();
			}
			if (frame.complete && !wasComplete) inbox.scrollTop = conversationOffset;
			const count = `${String(frame.messages).padStart(2, '0')} / 08`;
			if (counter.textContent !== count) counter.textContent = count;
			const captionText =
				frame.typing && !reducedMotion.matches
					? `${frame.callerTyping ? 'Caller' : 'Receptionist'} is speaking`
					: frame.messages === messages.length
						? 'Conversation captured'
						: 'Example conversation';
			if (caption.textContent !== captionText)
				caption.textContent = captionText;
			flights.forEach((flight) => {
				const started = frame[`${flight.kind}Started`];
				const progress = frame[`${flight.kind}Progress`];
				if (started && !flight.started && !reducedMotion.matches)
					measureFlight(flight);
				flight.started = started;
				flight.progress = progress;
				flight.element.classList.toggle('visual-transfer-pending', !started);
				flight.element.classList.toggle(
					'visual-transferring',
					started && progress < 1,
				);
				flight.element.style.setProperty(
					'--flight-progress',
					String(1 - (1 - progress) ** 3),
				);
				flight.element.style.setProperty(
					'--flight-opacity',
					String(Math.min(1, progress * 8)),
				);
			});
			waiting.hidden = frame.summaryStarted;
			steps.forEach((step, index) => {
				step.disabled = reducedMotion.matches;
				step.classList.toggle(
					'visual-step-done',
					frame.stepProgress[index] === 1,
				);
				step.classList.toggle(
					'visual-step-active',
					!reducedMotion.matches && frame.activeStep === index,
				);
				borders[index].style.strokeDashoffset = String(
					100 * (1 - frame.stepProgress[index]),
				);
				checks[index].style.opacity = String(
					Math.min(1, frame.checkProgress[index] * 6),
				);
				checkPaths[index].style.strokeDashoffset = String(
					100 * (1 - frame.checkProgress[index]),
				);
			});
		}

		function stop() {
			if (request !== undefined) {
				cancelAnimationFrame(request);
				if (lastTime !== null) clock.advance(performance.now() - lastTime);
			}
			request = undefined;
			lastTime = null;
		}

		function tick(now: number) {
			if (lastTime !== null) clock.advance(now - lastTime);
			lastTime = now;
			render();
			if (clock.state.complete) {
				request = undefined;
				lastTime = null;
				scene.classList.remove('visual-running');
			} else request = requestAnimationFrame(tick);
		}

		function syncPlayback() {
			stop();
			if (reducedMotion.matches) clock.finish();
			const running =
				visible &&
				!clock.state.paused &&
				!clock.state.complete &&
				!document.hidden &&
				!reducedMotion.matches;
			scene.classList.toggle('visual-running', running);
			scene.classList.toggle('visual-ready', !reducedMotion.matches);
			button.hidden = reducedMotion.matches;
			render();
			if (!running) return;
			lastTime = performance.now();
			request = requestAnimationFrame(tick);
		}

		button.addEventListener('click', () => {
			stop();
			const wasComplete = clock.state.complete;
			clock.press();
			if (wasComplete || clock.state.elapsed === 0) inbox.scrollTop = 0;
			syncPlayback();
		});
		steps.forEach((step, index) => {
			step.addEventListener('click', () => {
				controlsVisible = true;
				visible = true;
				stop();
				clock.playSegment(index);
				inbox.scrollTop = 0;
				syncPlayback();
			});
		});
		const visibilityObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.target === scene) sceneVisible = entry.isIntersecting;
					else controlsVisible = entry.isIntersecting;
				});
				visible = sceneVisible || controlsVisible;
				syncPlayback();
			},
			{ threshold: 0.15 },
		);
		visibilityObserver.observe(scene);
		visibilityObserver.observe(progressControls);
		const resize = new ResizeObserver(() => {
			positionConversation();
			flights.forEach((flight) => {
				if (flight.started && flight.progress < 1) measureFlight(flight);
			});
		});
		resize.observe(inbox);
		resize.observe(list);
		flights.forEach((flight) => resize.observe(flight.mount));
		document.addEventListener('visibilitychange', syncPlayback);
		reducedMotion.addEventListener('change', syncPlayback);
		syncPlayback();
	}
</script>

<style>
	.visual-shell {
		--visual-ui-size: clamp(0.875rem, 0.8rem + 0.2vw, 1rem);
		border-radius: 1.5rem;
		overflow: hidden;
	}
	.visual-toolbar,
	.visual-statusbar,
	.visual-footnote {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.25rem;
	}
	.visual-toolbar {
		flex-wrap: wrap;
		border-bottom: 1px solid var(--line);
		min-height: 4.5rem;
	}
	.visual-example,
	.visual-status {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
	}
	.visual-example {
		color: var(--fg-3);
	}
	.visual-dot {
		display: inline-block;
		width: 6px;
		height: 6px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--brand);
	}
	.visual-example .visual-dot {
		background: var(--fg-3);
	}
	.visual-playback:not([hidden]) {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		font-size: var(--visual-ui-size);
		color: var(--fg-3);
		cursor: pointer;
	}
	.visual-playback:hover {
		color: var(--fg-1);
	}
	.visual-statusbar {
		flex-wrap: wrap;
		padding-block: 1.25rem;
	}
	.visual-status {
		color: var(--brand-text);
		font-weight: 600;
	}
	.visual-afterhours {
		color: var(--fg-3);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
	}
	.visual-afterhours > span {
		display: none;
	}
	.visual-workspace {
		position: relative;
		display: grid;
		gap: 1.25rem;
		padding: 0 1.25rem 1.25rem;
	}
	.visual-call {
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	.visual-call-heading {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-bottom: 1.25rem;
	}
	.visual-caller-icon,
	.visual-summary-icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		border: 1px solid var(--line-strong);
		border-radius: 50%;
		color: var(--brand-text);
	}
	.visual-caller-icon {
		width: 2.75rem;
		height: 2.75rem;
	}
	.visual-label {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--fg-3);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.04em;
	}
	.visual-call-title {
		margin-top: 0.25rem;
		color: var(--fg-1);
		font-size: var(--visual-ui-size);
		font-weight: 600;
	}
