---
import BaseLayout from '../layouts/BaseLayout.astro'
import CopyRegion from '../components/tina/CopyRegion.astro'
import BookDemoBody from '../components/cms-regions/forms/BookDemoBody.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getOffer } from '../lib/offer'
import { formatCopy } from '../lib/tina/site-model'
const copy = Astro.locals.site.forms.bookDemoPage
---

<BaseLayout title={copy.metaTitle} description={formatCopy(copy.metaDescription, { demoFreeMinutes: getOffer(Astro.locals.site.offer).demoFreeMinutes })}>
  <CopyRegion region="header" page="bookDemo"><Header /></CopyRegion>
  <CopyRegion region="bookDemo" page="bookDemo" primary><BookDemoBody /></CopyRegion>
  <CopyRegion region="footer" page="bookDemo"><Footer /></CopyRegion>
</BaseLayout>
