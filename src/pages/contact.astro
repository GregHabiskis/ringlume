---
import BaseLayout from '../layouts/BaseLayout.astro'
import CopyRegion from '../components/tina/CopyRegion.astro'
import ContactBody from '../components/cms-regions/forms/ContactBody.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
const copy = Astro.locals.site.forms.contactPage
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription}>
  <CopyRegion region="header" page="contact"><Header /></CopyRegion>
  <CopyRegion region="contact" page="contact" primary><ContactBody /></CopyRegion>
  <CopyRegion region="footer" page="contact"><Footer /></CopyRegion>
</BaseLayout>
