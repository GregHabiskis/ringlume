---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import FaqBody from '../components/cms-regions/marketing/FaqBody.astro'
import Footer from '../components/Footer.astro'
import CopyRegion from '../components/tina/CopyRegion.astro'
const site = Astro.locals.site
---

<BaseLayout
  title={site.pages.faq.title}
  description={site.pages.faq.description}
>
  <CopyRegion region="header" page="faq"><Header /></CopyRegion>

  <main class="min-h-screen pt-16 lg:pt-20">
    <CopyRegion region="faq" page="faq" primary><FaqBody /></CopyRegion>
  </main>

  <CopyRegion region="footer" page="faq"><Footer /></CopyRegion>
</BaseLayout>
