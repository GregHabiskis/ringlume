---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import FomoSection from '../components/FomoSection.astro'
import Capabilities from '../components/Capabilities.astro'
import Pricing from '../components/Pricing.astro'
import FAQ from '../components/FAQ.astro'
import CtaSection from '../components/CtaSection.astro'
import Footer from '../components/Footer.astro'
import ContactWidget from '../components/ContactWidget.astro'
---

<BaseLayout
  title="Ringlume | Voice AI Agents"
  description="Managed Voice AI reception and automation for forward-thinking businesses."
>
  <Header />

  <main>
    <Hero />
    <FomoSection />
    <Capabilities />
    <Pricing />
    <FAQ />
    <CtaSection />
  </main>

  <Footer />
  <ContactWidget />
</BaseLayout>
