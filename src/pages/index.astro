---
import CopyRegion from '../components/tina/CopyRegion.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import ReceptionistVisual from '../components/ReceptionistVisual.astro'
import HomeBody from '../components/cms-regions/marketing/HomeBody.astro'
import Footer from '../components/Footer.astro'
const site = Astro.locals.site
---

<BaseLayout title={site.pages.home.title} description={site.pages.home.description}>
	<CopyRegion region="header" page="home"><Header /></CopyRegion>
	<main>
		<Hero />
		<ReceptionistVisual />
		<CopyRegion region="home" page="home"><HomeBody /></CopyRegion>
	</main>
	<CopyRegion region="footer" page="home"><Footer /></CopyRegion>
</BaseLayout>
