---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import FomoSection from '../components/FomoSection.astro'
import Capabilities from '../components/Capabilities.astro'
import DemoSection from '../components/DemoSection.astro'
import Pricing from '../components/Pricing.astro'
import FAQ from '../components/FAQ.astro'
import CtaSection from '../components/CtaSection.astro'
import Footer from '../components/Footer.astro'
import type { FaqId } from '../data/faqs'

const homepageFaqIds = [
  'busy-calls',
  'appointments',
  'live-transfer',
  'setup-time',
  'pricing',
] as const satisfies readonly FaqId[]
---

<BaseLayout
  title="Ringlume"
  description="A virtual receptionist for service businesses that answers calls, qualifies leads, and books appointments 24/7."
>
  <Header />

  <main>
    <Hero />
    <FomoSection />
    <Capabilities />
    <DemoSection />
    <Pricing />
    <FAQ faqIds={homepageFaqIds} showAllLink />
    <CtaSection />
  </main>

  <Footer />
</BaseLayout>
