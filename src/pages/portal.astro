---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout
  title="Billing Portal | Ringlume"
  description="Manage your Ringlume subscription, billing, and account settings."
>
  <Header />

  <main class="min-h-[80vh] flex items-center justify-center px-4 py-20">
    <div class="max-w-lg w-full text-center">
      <div class="w-16 h-16 rounded-full gradient-bg flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
        </svg>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Manage <span class="gradient-green-text">Billing</span>
      </h1>
      <p class="text-lg text-slate-300 mb-8">
        Paddle, our payment partner, hosts a secure billing portal where you can
        view invoices, update payment methods, and manage your subscription.
      </p>

      <div class="space-y-4">
        <a
          href="/api/paddle/portal"
          class="inline-block gradient-green text-white px-8 py-3.5 rounded-xl text-sm font-semibold hover:opacity-90 transition-opacity glow-green"
        >
          Open Billing Portal
        </a>
      </div>

      <p class="mt-8 text-sm text-slate-500">
        You will be asked to sign in using the email address on your account.
        Paddle will send a one-time login link to your inbox.
      </p>

      <p class="mt-4 text-sm text-slate-500">
        Need help? <a href="/contact" class="text-green-primary hover:underline">Contact support</a>
      </p>
    </div>
  </main>

  <Footer />
</BaseLayout>
