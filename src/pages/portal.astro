---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

export const prerender = false

const portalUnavailable = Astro.url.searchParams.get('error') === 'portal_unavailable'
---

<BaseLayout
  title="Billing Portal | Ringlume"
  description="Manage your Ringlume subscription, invoices, and payment details through Paddle."
>
  <Header />

  <main class="min-h-[80vh] flex items-center justify-center px-4 py-20">
    <div class="max-w-lg w-full text-center">
      <div class="w-16 h-16 rounded-full gradient-bg flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
        </svg>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Manage <span class="gradient-green-text">Billing</span>
      </h1>
      <p class="text-lg text-slate-300 mb-8">
        Paddle, our payment partner, hosts a secure billing portal where you can
        view invoices, update payment methods, and manage or cancel your subscription.
      </p>

      {portalUnavailable && (
        <div class="mb-8 rounded-2xl border border-red-400/30 bg-red-950/30 p-4 text-left text-sm text-red-100" role="alert">
          The billing portal is temporarily unavailable. Please <a href="/contact" class="font-semibold text-white underline underline-offset-2">contact support</a> for help managing your subscription.
        </div>
      )}

      <div class="space-y-4">
        <a
          href="/api/paddle/portal"
          class="inline-block gradient-green text-white px-8 py-3.5 rounded-xl text-sm font-semibold hover:opacity-90 transition-opacity glow-green focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-accent focus-visible:ring-offset-4 focus-visible:ring-offset-[#111213]"
        >
          Manage or Cancel Subscription
        </a>
      </div>

      <p class="mt-8 text-sm text-slate-500">
        Enter the email address used for your purchase. Paddle will send a secure
        one-time sign-in link to your inbox.
      </p>

      <p class="mt-3 text-sm text-slate-500">
        Paddle will show the cancellation timing and effective date before you confirm.
      </p>

      <p class="mt-4 text-sm text-slate-500">
        Need help? <a href="/contact" class="text-green-primary hover:underline">Contact support</a>
      </p>
    </div>
  </main>

  <Footer />
</BaseLayout>
