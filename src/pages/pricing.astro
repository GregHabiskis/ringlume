---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CopyRegion from '../components/tina/CopyRegion.astro'
import PricingBody from '../components/cms-regions/marketing/PricingBody.astro'
const site = Astro.locals.site
---
<BaseLayout title={site.pages.pricing.title} description={site.pages.pricing.description}>
	<CopyRegion region="header" page="pricing"><Header /></CopyRegion>
	<main class="pt-32 lg:pt-40">
		<CopyRegion region="pricing" page="pricing" primary><PricingBody /></CopyRegion>
	</main>
	<CopyRegion region="footer" page="pricing"><Footer /></CopyRegion>
</BaseLayout>
