---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CopyRegion from '../components/tina/CopyRegion.astro'
import PrivacyBody from '../components/cms-regions/legal/PrivacyBody.astro'

const copy = Astro.locals.site.legal.privacy
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription}>
  <CopyRegion region="header" page="privacy"><Header /></CopyRegion>
  <CopyRegion region="privacy" page="privacy" primary><PrivacyBody /></CopyRegion>
  <CopyRegion region="footer" page="privacy"><Footer /></CopyRegion>
</BaseLayout>
