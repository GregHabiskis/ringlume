---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ContactWidget from '../components/ContactWidget.astro'
---

<BaseLayout
  title="Return & Refund Policy | Ringlume"
  description="Ringlume's 7-day money-back guarantee and refund policy for virtual receptionist subscriptions."
>
  <Header />

  <main class="scrim min-h-screen pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-h1 font-bold text-fg-1 mb-4">Return & Refund Policy</h1>
      <p class="text-fg-3 mb-12">Last Updated: August 8, 2026</p>

      <div class="glass glass-thick grain max-w-none space-y-10 rounded-[32px] p-6 sm:p-10 lg:p-14">

        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">7-Day Money-Back Guarantee</h2>
          <p class="text-fg-2 leading-relaxed font-medium">
            The 7-day money-back guarantee covers all four Ringlume subscription tiers: Basic, Pro,
            Plus, and Max. It applies to both monthly and annual subscriptions.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            If you request a refund within the first 7 calendar days after completing your purchase,
            the subscription charge paid is 100% refundable, regardless of whether you
            selected monthly or annual billing. Contact support@ringlume.com in writing to request
            a refund.
          </p>
          <ul class="list-disc list-inside text-fg-2 space-y-2 mt-4 ml-4">
            <li>Basic, Pro, Plus, and Max subscription charges are fully refundable during the guarantee period</li>
            <li>The guarantee applies equally to monthly and annual subscription charges</li>
            <li>The refund will be processed to the original payment method within 10 business days</li>
          </ul>
          <p class="text-fg-2 leading-relaxed mt-4">
            The one-time Service Setup Fee is 50% refundable during the same 7-day guarantee period.
            The applicable fee is currently $1,200, so the current refundable portion is $600 and the
            remaining $600 is non-refundable. The durable rule is 50% of the applicable Service Setup
            Fee.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            <strong class="text-fg-1">After the 7-day guarantee period:</strong> Subscription charges
            and the Service Setup Fee are non-refundable. No partial refund guarantee applies.
          </p>
        </section>

      </div>
    </div>
  </main>

  <Footer />
  <ContactWidget />
</BaseLayout>
