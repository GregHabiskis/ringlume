---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {
  formatList,
  CAL_BOOKING_URL,
  SUPPORTED_STACK,
} from '../lib/offer'
import { PLANS, USAGE_RATES, formatPrice } from '../lib/pricing'

const overageRates = PLANS.map(
  (plan) => `${plan.name}: $${plan.overagePerMinute.toFixed(2)}/minute`,
).join('; ')

const transferRates = PLANS.map(
  (plan) => `${plan.name}: $${plan.liveTransferPerMinute.toFixed(2)}/minute`,
).join('; ')

const smsRates = PLANS.map(
  (plan) => `${plan.name}: $${plan.smsPerMessage.toFixed(2)}/SMS`,
).join('; ')

const telephonyRates = PLANS.map(
  (plan) => `${plan.name}: from $${plan.telephonyFromPerMinute.toFixed(3)}/minute`,
).join('; ')

const setupUpgradeExamples = [
  { from: PLANS[0], to: PLANS[1] },
  { from: PLANS[0], to: PLANS[2] },
]
---

<BaseLayout
  title="Terms & Conditions | Ringlume"
  description="Terms and conditions governing Ringlume's virtual receptionist and automated call-handling services."
>
  <Header />

  <main class="scrim min-h-screen pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-h1 font-bold text-fg-1 mb-4">Terms & Conditions</h1>
      <p class="text-fg-3 mb-12">Last Updated: November 6, 2026</p>

      <div class="glass glass-fill glass-regular glass-card max-w-none space-y-10 rounded-[32px] p-6 sm:p-10 lg:p-14">

        <!-- 1. Acceptance of Terms -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">1. Acceptance of Terms</h2>
          <p class="text-fg-2 leading-relaxed">
            By accessing or using the services provided by Ringlume ("Company," "we," "us,"
            or "our"), including our virtual receptionist services and automated call-handling and
            voice-processing technology, plus all related software, platforms, and communication tools
            (collectively, the "Services"), you
            ("Client," "you," or "your") agree to be bound by these Terms & Conditions ("Terms").
            If you do not agree to all of these Terms, you are expressly prohibited from using the
            Services and must discontinue use immediately.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            These Terms constitute a legally binding agreement between you and Ringlume.
            We reserve the right to update, modify, or replace these Terms at any time without prior
            notice. Continued use of the Services following any changes constitutes acceptance of
            those changes.
          </p>
        </section>

        <!-- 2. Description of Services -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">2. Description of Services</h2>
          <p class="text-fg-2 leading-relaxed">
            Ringlume provides virtual receptionist and automated call-handling services for
            businesses, including but not limited to:
          </p>
          <ul class="list-disc list-inside text-fg-2 space-y-2 mt-4 ml-4">
            <li>Virtual receptionist services for inbound and outbound call handling</li>
            <li>Automated appointment scheduling and calendar management</li>
            <li>Scheduled outbound calling campaigns</li>
            <li>Call summaries, transcripts, and reporting dashboards</li>
            <li>Setup using your business information and call-handling preferences</li>
            <li>Integration services for customer management systems, SMS, email, and third-party platforms</li>
          </ul>
          <p class="text-fg-2 leading-relaxed mt-4">
            The specific features, capabilities, and scope of the Services are detailed in your
            active subscription plan and may be updated or modified by Ringlume from time
            to time to improve functionality and service quality.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            Every plan includes a User Dashboard and daily call recordings and reports.
            Web calls and web chat widgets are also included on all plans; usage
            charges are governed by <a href="#billing-details" class="text-brand-text underline underline-offset-2">section 3.1</a>.
            Agent bundles, included call minutes and phone numbers, simultaneous-call
            limits, calendar and CRM connections, multilingual support, and support
            levels are set out in the
            <a href="/pricing#plan-comparison" class="text-brand-text underline underline-offset-2">plan comparison</a>
            for your selected plan.
          </p>
          <h3 id="service-details" class="scroll-mt-24 text-lg font-semibold text-fg-1 mt-8 mb-3">
            2.1 Configuration and Integrations
          </h3>
          <p class="text-fg-2 leading-relaxed">
            Your phone setup, calendar, CRM, and any special compliance requirements
            are reviewed before setup. Custom integrations depend on the tools and
            agreed scope. No compliance certification or regulated workflow is
            guaranteed by choosing a plan. Preferred tools and launch estimates are
            explained in <a href="#setup-time" class="text-brand-text underline underline-offset-2">section 7.1</a>.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            HIPAA support and a Business Associate Agreement (BAA) are available on
            all plans through Trillet. Use involving protected health information
            requires confirmation of the applicable BAA, configuration, and agreed
            scope before processing begins.
          </p>
        </section>

        <!-- 3. Subscription Terms & Billing -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">3. Subscription Terms & Billing</h2>
          <p class="text-fg-2 leading-relaxed">
            Ringlume offers four subscription plans: Basic, Pro, Plus, and Max. Each plan is
            available with monthly or annual billing. The subscription fee and billing interval are
            the amounts and terms shown on the Ringlume Pricing page at the time of purchase.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            Subscription charges renew automatically at the selected billing interval until
            cancelled. Customers can manage or cancel a subscription by contacting us through our
            Contact page, and we confirm the cancellation timing and effective date before the
            change takes effect.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            A one-time Service Setup Fee applies when shown on the Ringlume Pricing page. It is
            displayed before payment and is charged with the initial transaction; it is not a
            recurring subscription charge. Applicable taxes are calculated and displayed before
            payment.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            All fees are quoted in United States Dollars (USD) unless otherwise specified. Our payment
            provider processes payment and billing records for Ringlume and provides invoices or
            receipts, payment-method management, and hosted billing tools. Ringlume manually
            sets up and manages the Services, including the dashboard access included
            with every plan.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            <strong class="text-fg-1">No refunds.</strong> All fees, including subscription
            charges and the one-time Service Setup Fee, are non-refundable, except where a
            refund is required by applicable law.
          </p>
          <h3 id="billing-details" class="scroll-mt-24 text-lg font-semibold text-fg-1 mt-8 mb-3">
            3.1 Usage Rates, Annual Billing, and Plan Changes
          </h3>
          <p class="text-fg-2 leading-relaxed">
            Included minutes reset monthly. Extra call-minute rates are
            {overageRates}. Annual subscriptions are charged
            at the full annual total shown on the Pricing page; displayed monthly
            equivalents are approximate, not monthly charges.
          </p>
          <ul class="list-disc list-inside text-fg-2 space-y-2 mt-4 ml-4">
            <li>Live call transfers: {transferRates}.</li>
            <li>SMS messages: {smsRates}.</li>
            <li>Ringlume telephony: {telephonyRates}. These carrier charges apply to calls routed through a phone number in addition to standard call usage.</li>
            <li>
              Additional phone numbers: {formatPrice(USAGE_RATES.additionalPhoneNumberMonthly)}
              per additional number per month, beyond the numbers included in your plan.
            </li>
          </ul>
          <p class="text-fg-2 leading-relaxed mt-4">
            Voice conversations through a website widget or web call use the same
            monthly call-minute allowance and standard per-minute rates as phone
            calls, including your plan's additional-minute rate once the allowance
            is exhausted. Web calls do not use a phone line, so no telephony fee
            applies. This exemption does not make web-call usage free.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            Text messages exchanged through the web chat widget are counted as SMS
            messages for billing purposes and charged at your plan's SMS rate.
            In a type-or-talk session, where a visitor switches between typing and
            speaking, the voice portion is billed as call usage and the typed
            messages are billed at SMS rates. Including a widget in your plan does
            not waive these usage charges.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            Request upgrades or cancellation through our
            <a href="/contact" class="text-brand-text underline underline-offset-2">Contact page</a>.
            Upgrades are charged at the prorated difference for the rest of the
            current billing period. Cancellation takes effect at the end of the
            current billing period. We confirm changes by email.
          </p>
          <h3 id="estimates" class="scroll-mt-24 text-lg font-semibold text-fg-1 mt-8 mb-3">
            3.2 Illustrative Estimates and Wage Comparisons
          </h3>
          <p class="text-fg-2 leading-relaxed">
            The missed-call calculator multiplies missed calls per week by the
            assumed booking rate, booking value, repeat-visit multiplier, and 52
            weeks. Monthly estimates divide that result by 12. These are illustrative
            assumptions, not promised bookings or revenue. Actual recovered revenue
            depends on call volume, lead quality, scheduling capacity, and other factors.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            The wage comparison divides the cited U.S. annual median receptionist
            wage by 12 and rounds to the nearest dollar. Wages exclude benefits and
            payroll taxes and do not cover 24/7 staffing. Ringlume handles phone
            calls and scheduling, not in-person reception or every administrative
            duty. This comparison does not guarantee savings.
          </p>
          <h3 id="setup-fee-upgrades" class="scroll-mt-24 text-lg font-semibold text-fg-1 mt-8 mb-3">
            3.3 Setup Fees When Upgrading
          </h3>
          <p class="text-fg-2 leading-relaxed">
            When you upgrade, the total Service Setup Fees already paid count toward
            the new plan's Service Setup Fee. This includes your initial setup payment
            and any setup-fee top-ups paid on earlier upgrades. You pay only the
            remaining difference, not the full setup fee again. If your previous
            setup payments already cover the new plan's setup fee, no additional
            setup fee is due.
          </p>
          <ul class="list-disc list-inside text-fg-2 space-y-2 mt-4 ml-4">
            {setupUpgradeExamples.map(({ from, to }) => (
              <li>
                {from.name} to {to.name}: {formatPrice(from.setupFee)} already paid
                toward a {formatPrice(to.setupFee)} setup fee means only
                {formatPrice(Math.max(0, to.setupFee - from.setupFee))} extra.
              </li>
            ))}
          </ul>
          <p class="text-fg-2 leading-relaxed mt-4">
            This setup-fee credit is separate from subscription charges and any
            prorated subscription difference due when upgrading.
          </p>
        </section>
        <!-- 4. Intellectual Property & Licensing -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">4. Intellectual Property & Licensing</h2>
          <p class="text-fg-2 leading-relaxed">
            All branded assets, visual compositions, written content, and
            digital materials created specifically for the Client by Ringlume under an active
            subscription ("Client Deliverables") shall be considered the property of the Client upon
            full payment of the applicable subscription fees, subject to the terms herein.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            Ringlume provides value-added managed Services that build on and utilize licensed
            third-party technology infrastructure. Ringlume configures, integrates, deploys,
            optimizes, brands, and supports the Services delivered to the Client.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            The Client is granted a limited, non-exclusive, non-transferable license to use the
            Services and any Client Deliverables for the duration of their active subscription. This
            license does not include the right to resell, sublicense, redistribute, or commercially
            exploit the underlying call-handling technology, voice models, automation frameworks, or
            platform infrastructure.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            All underlying models, language-processing engines, voice-synthesis systems, base
            software frameworks, and platform infrastructure used to deliver the Services are owned
            solely by the applicable third-party infrastructure providers. Ringlume claims no
            ownership interest in that underlying technology beyond its rights under applicable
            licenses.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            Ringlume retains ownership of its branding, reusable configurations, workflows,
            implementation methods, integrations, and other service-layer materials created on top
            of the licensed infrastructure. Client Deliverables created specifically for the Client
            remain subject to the ownership and licensing terms stated above.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            Ringlume remains responsible to the Client for the Services, pricing, support, service
            administration, cancellations, and billing inquiries. Payments are processed by a
            third-party payment provider that handles charges, billing records, invoices or receipts,
            and payment-method management. That payment provider is not responsible for the Services
            themselves.
          </p>
        </section>

        <!-- 5. Acceptable Use -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">5. Acceptable Use</h2>
          <p class="text-fg-2 leading-relaxed">
            The Client agrees not to use, or permit any third party to use, the Services for:
          </p>
          <ul class="list-disc list-inside text-fg-2 space-y-2 mt-4 ml-4">
            <li>Unlawful, fraudulent, deceptive, threatening, abusive, or harassing communications</li>
            <li>Communications that violate the Telephone Consumer Protection Act (TCPA), CAN-SPAM Act, Canada's Anti-Spam Legislation (CASL), or any other applicable telemarketing, marketing, or consent law</li>
            <li>Emergency response, life-safety, safety-critical dispatch, or any use in which a delay, error, or service interruption could result in death, personal injury, or property damage</li>
            <li>Debt collection, healthcare, financial-services, or other regulated communications without appropriate legal and compliance review, authorization, and safeguards</li>
            <li>Any communication that fails to satisfy applicable consent, call-recording disclosure, identification, do-not-call, or opt-out requirements</li>
          </ul>
          <p class="text-fg-2 leading-relaxed mt-4">
            Ringlume may suspend or terminate access to the Services where it reasonably determines
            that the Client's use violates this section or applicable law.
          </p>
        </section>

        <!-- 6. Data Collection & Call Recording -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">6. Data Collection & Call Recording</h2>
          <p class="text-fg-2 leading-relaxed">
            The Services involve the collection, processing, and storage of various categories of
            data, including but not limited to telephone call recordings, voice transcripts, caller
            identification information, appointment schedules, and interaction logs. By using the
            Services, you consent to the collection and processing of this data in accordance with
            our Privacy Policy.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            All inbound and outbound telephone calls managed through Ringlume's automated
            call-handling and voice-processing system may be recorded, transcribed, and stored for
            quality checks, service improvement and training, compliance, and reporting purposes. Call
            recordings and transcripts are accessible through the Client dashboard and may be retained
            for the duration of the subscription plus any period required by applicable law.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            The Client is responsible for ensuring that all applicable federal, state, and local
            laws regarding call recording consent are followed. Ringlume provides tools
            for automated call recording disclosure but does not assume legal liability for
            compliance with jurisdiction-specific recording consent requirements.
          </p>
        </section>

        <!-- 7. Service Availability & SLA -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">7. Service Availability & Uptime</h2>
          <p class="text-fg-2 leading-relaxed">
            Ringlume endeavors to maintain high availability of the Services, targeting
            99.9% uptime for the automated call-handling platform. However, scheduled maintenance
            windows, system upgrades, and unforeseen technical circumstances may temporarily affect
            service availability. The Company will provide reasonable advance notice for scheduled
            maintenance when practicable.
          </p>

          <h3
            id="setup-time"
            class="scroll-mt-16 lg:scroll-mt-20 text-lg font-semibold text-fg-1 mt-8 mb-3"
          >
            7.1 Setup Time and Compatible Tools
          </h3>
          <p class="text-fg-2 leading-relaxed">
            Ringlume handles setup for your agreed call flows and connections. We
            confirm an estimated launch date for the agreed scope, not a universal
            turnaround. A demo is a preview, not a production deployment.
          </p>
          <ol class="list-decimal list-inside text-fg-2 space-y-4 mt-4 ml-4 leading-relaxed">
            <li>
              <strong class="text-fg-1">Review and scope.</strong> Straightforward
              setups use existing, tested configurations for inbound call handling
              and agreed phone or calendar connections. Custom code, PBX changes,
              CRM workflows, multiple locations, and regulated requirements are
              scoped individually. Setup scope is subject to your plan's allowances.
            </li>
            <li>
              <strong class="text-fg-1">Information and access.</strong> We schedule
              setup once the scope is confirmed and we have your approved business
              information and required account access, including services, hours,
              service areas, booking rules, and escalation contacts as applicable.
              Your launch estimate includes our setup queue, configuration, and
              testing, with customer review time agreed with you.
            </li>
            <li>
              <strong class="text-fg-1">Test and approve.</strong> We test the agreed
              answers, lead capture, booking, transfers, and fallback handling where
              applicable. You review and approve the receptionist before we connect
              or change live call routing. Ready for testing is not the same as live:
              launch means your approved receptionist is connected to your phone
              line and ready to take real customer calls.
            </li>
          </ol>
          <p class="text-fg-2 leading-relaxed mt-4">
            These are recommended tools, not requirements or guarantees of native
            integration. Compatibility, permissions, and the features needed are
            checked before we confirm your estimate:
          </p>
          <ul class="list-disc list-inside text-fg-2 space-y-2 mt-4 ml-4">
            <li>{formatList(SUPPORTED_STACK.phone)} for phone service</li>
            <li>{formatList(SUPPORTED_STACK.calendar)} for the calendar</li>
            <li>{formatList(SUPPORTED_STACK.booking)} for booking appointments</li>
            <li>
              a well-known CRM such as {formatList(SUPPORTED_STACK.crm)}
            </li>
          </ul>
          <p class="text-fg-2 leading-relaxed mt-4">
            Choosing a plan or a preferred tool does not guarantee a launch date.
            Number porting, third-party approvals, missing access, customer review
            delays, or changes to requirements can extend the timeline. If timing
            changes, we explain the reason and confirm a revised estimate with you.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            Business days, when used in an estimate, mean Saturday through Thursday,
            excluding U.S. federal holidays, in Eastern Time (America/New_York).
            Setup dates are estimates, not guarantees. Production estimates do not
            change the separate demo-delivery offer.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            Discuss your setup by
            <a
              href={CAL_BOOKING_URL}
              class="text-brand-text underline underline-offset-2 hover:opacity-80"
            >
              booking a meeting
            </a>, or by email, WhatsApp, or phone call (see our
            <a
              href="/contact"
              class="text-brand-text underline underline-offset-2 hover:opacity-80"
            >
              Contact page
            </a>).
          </p>
        </section>

        <!-- 8. Limitation of Liability -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">8. Limitation of Liability</h2>
          <p class="text-fg-2 leading-relaxed">
            To the maximum extent permitted by applicable law, Ringlume, its officers,
            directors, employees, agents, and affiliates shall not be liable for any indirect,
            incidental, special, consequential, or punitive damages, including but not limited to
            loss of profits, data, business opportunities, or goodwill, arising out of or in
            connection with the use of the Services, regardless of the theory of liability.
          </p>
          <p class="text-fg-2 leading-relaxed mt-4">
            In no event shall the total aggregate liability of Ringlume exceed the total
            amount of subscription fees paid by the Client during the twelve (12)-month period
            immediately preceding the event giving rise to the claim.
          </p>
        </section>

        <!-- 9. Indemnification -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">9. Indemnification</h2>
          <p class="text-fg-2 leading-relaxed">
            You agree to indemnify, defend, and hold harmless Ringlume and its officers,
            directors, employees, agents, and affiliates from and against any and all claims,
            liabilities, damages, losses, costs, and expenses (including reasonable attorneys' fees)
            arising out of or in connection with your use of the Services, your violation of these
            Terms, or your violation of any rights of a third party.
          </p>
        </section>

        <!-- 10. Governing Law -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">10. Governing Law & Dispute Resolution</h2>
          <p class="text-fg-2 leading-relaxed">
            These Terms shall be governed by and construed in accordance with the laws of the
            jurisdiction in which Ringlume operates, without regard to its conflict of law
            provisions. Any dispute arising out of or relating to these Terms or the Services shall
            be resolved through binding arbitration in accordance with the rules of the American
            Arbitration Association.
          </p>
        </section>

        <!-- 11. Severability -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">11. Severability</h2>
          <p class="text-fg-2 leading-relaxed">
            If any provision of these Terms is found to be unenforceable or invalid by a court of
            competent jurisdiction, that provision shall be limited or eliminated to the minimum
            extent necessary so that these Terms shall otherwise remain in full force and effect.
          </p>
        </section>

        <!-- 12. Contact -->
        <section>
          <h2 class="text-2xl font-bold text-fg-1 mb-4">12. Contact Information</h2>
          <p class="text-fg-2 leading-relaxed">
            If you have any questions about these Terms & Conditions, please contact us:
          </p>
          <ul class="list-none text-fg-2 space-y-2 mt-4">
            <li><strong class="text-fg-1">Email:</strong> support@ringlume.com</li>
            <li><strong class="text-fg-1">WhatsApp:</strong> +8801951284128</li>
          </ul>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
