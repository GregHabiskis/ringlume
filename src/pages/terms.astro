---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ContactWidget from '../components/ContactWidget.astro'
---

<BaseLayout
  title="Terms & Conditions | All In One System"
  description="Terms and conditions governing the use of All In One System Voice AI agents and related services."
>
  <Header />

  <main class="pt-24 pb-20 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">Terms & Conditions</h1>
      <p class="text-slate-400 mb-12">Last Updated: July 15, 2026</p>

      <div class="prose prose-slate max-w-none space-y-10">

        <!-- 1. Acceptance of Terms -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">1. Acceptance of Terms</h2>
          <p class="text-slate-300 leading-relaxed">
            By accessing or using the services provided by All In One System ("Company," "we," "us,"
            or "our"), including our Voice AI agents and all related
            software, platforms, and communication tools (collectively, the "Services"), you
            ("Client," "you," or "your") agree to be bound by these Terms & Conditions ("Terms").
            If you do not agree to all of these Terms, you are expressly prohibited from using the
            Services and must discontinue use immediately.
          </p>
          <p class="text-slate-300 leading-relaxed mt-4">
            These Terms constitute a legally binding agreement between you and All In One System.
            We reserve the right to update, modify, or replace these Terms at any time without prior
            notice. Continued use of the Services following any changes constitutes acceptance of
            those changes.
          </p>
        </section>

        <!-- 2. Description of Services -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">2. Description of Services</h2>
          <p class="text-slate-300 leading-relaxed">
            All In One System provides a comprehensive suite of digital business solutions, including
            but not limited to:
          </p>
          <ul class="list-disc list-inside text-slate-300 space-y-2 mt-4 ml-4">
            <li>AI-powered Voice Receptionist agents for inbound and outbound call management</li>
            <li>Automated appointment scheduling and calendar management systems</li>
            <li>Workflow-triggered automated outbound calling campaigns</li>
            <li>Post-call analytics, transcription, and reporting dashboards</li>
            <li>Knowledge base training and custom AI behavior configuration</li>
            <li>Integration services for CRM, SMS, email, and third-party platforms</li>
          </ul>
          <p class="text-slate-300 leading-relaxed mt-4">
            The specific features, capabilities, and scope of the Services are detailed in your
            active subscription plan and may be updated or modified by All In One System from time
            to time to improve functionality and service quality.
          </p>
        </section>

        <!-- 3. Subscription Terms & Billing -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">3. Subscription Terms & Billing</h2>
          <p class="text-slate-300 leading-relaxed">
            <strong class="text-white">Monthly Subscription:</strong> The Voice AI Agent service is
            provided on a recurring monthly subscription basis at the rate specified at the time of
            enrollment. As of the date of these Terms, the standard rate is $300 USD per month per
            business location.
          </p>
          <p class="text-slate-300 leading-relaxed mt-4">
            All fees are quoted in United States Dollars (USD) unless otherwise specified. Payments
            are due on a monthly recurring basis and will be automatically charged to the payment
            method on file unless cancelled in accordance with these Terms.
          </p>
        </section>

        <!-- 4. 7-Day Money Back Guarantee -->
        <section class="bg-green-500/10 border border-green-500/20 rounded-2xl p-8">
          <h2 class="text-2xl font-bold text-green-400 mb-4">4. 7-Day Money Back Guarantee</h2>
          <p class="text-green-400 leading-relaxed font-medium">
            We offer a 7-day money back guarantee for new subscriptions.
          </p>
          <p class="text-slate-300 leading-relaxed mt-4">
            If you are not satisfied with the Services within the first 7 days of your initial
            subscription activation, you may request a full refund by contacting our support team.
            To be eligible for a refund under this guarantee:
          </p>
          <ul class="list-disc list-inside text-slate-300 space-y-2 mt-4 ml-4">
            <li>The refund request must be submitted within 7 calendar days of the original subscription start date</li>
            <li>The request must be submitted in writing via email to support@allinonesystem.com</li>
            <li>Only the first subscription activation is eligible; renewal periods are non-refundable</li>
            <li>The refund will be processed to the original payment method within 10 business days</li>
          </ul>
          <p class="text-slate-300 leading-relaxed mt-4">
            <strong class="text-white">After the 7-day period:</strong> All subscription fees paid are
            non-refundable. This includes, but is not limited to:
          </p>
          <ul class="list-disc list-inside text-slate-300 space-y-2 mt-4 ml-4">
            <li>Partial month usage or early cancellation after the 7-day window</li>
            <li>Unused AI agent minutes, call capacity, or feature access</li>
            <li>Changes in business requirements, staffing, or operational needs</li>
            <li>Technical issues arising from client-side configuration or third-party integrations</li>
          </ul>
          <p class="text-slate-300 leading-relaxed mt-4">
            By subscribing to the Services, you acknowledge and agree to this refund policy. The
            7-day money back guarantee applies only to your initial subscription and does not
            extend to any subsequent billing periods or reactivations.
          </p>
        </section>

        <!-- 5. Intellectual Property & Reseller Rights -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">5. Intellectual Property & Licensing</h2>
          <p class="text-slate-300 leading-relaxed">
            All branded assets, visual compositions, written content, and
            digital materials created specifically for the Client by All In One System under an active
            subscription ("Client Deliverables") shall be considered the property of the Client upon
            full payment of the applicable subscription fees, subject to the terms herein.
          </p>
          <p class="text-slate-300 leading-relaxed mt-4">
            All In One System acts as an independent authorized distributor, system integrator, and
            licensed commercial reseller of the core underlying automation and communication engine
            provisioning this infrastructure. While All In One System maintains full operational
            deployment, optimization, and white-label distribution rights to deliver these unified
            suites, intellectual property ownership of the base software engine resides with our
            underlying global infrastructure providers.
          </p>
          <p class="text-slate-300 leading-relaxed mt-4">
            The Client is granted a limited, non-exclusive, non-transferable license to use the
            Services and any Client Deliverables for the duration of their active subscription. This
            license does not include the right to resell, sublicense, redistribute, or commercially
            exploit the underlying AI technology, voice models, automation frameworks, or platform
            infrastructure.
          </p>
          <p class="text-slate-300 leading-relaxed mt-4">
            All proprietary AI models, natural language processing engines, voice synthesis systems,
            automation workflows, and software frameworks used to deliver the Services remain the
            exclusive property of All In One System and its technology partners.
          </p>
        </section>

        <!-- 6. Data Collection & Call Recording -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">6. Data Collection & Call Recording</h2>
          <p class="text-slate-300 leading-relaxed">
            The Services involve the collection, processing, and storage of various categories of
            data, including but not limited to telephone call recordings, voice transcripts, caller
            identification information, appointment schedules, and interaction logs. By using the
            Services, you consent to the collection and processing of this data in accordance with
            our Privacy Policy.
          </p>
          <p class="text-slate-300 leading-relaxed mt-4">
            All inbound and outbound telephone calls managed through the Voice AI agent system may be
            recorded, transcribed, and stored for quality assurance, training, compliance, and
            reporting purposes. Call recordings and transcripts are accessible through the Client
            dashboard and may be retained for the duration of the subscription plus any period
            required by applicable law.
          </p>
          <p class="text-slate-300 leading-relaxed mt-4">
            The Client is responsible for ensuring that all applicable federal, state, and local
            laws regarding call recording consent are followed. All In One System provides tools
            for automated call recording disclosure but does not assume legal liability for
            compliance with jurisdiction-specific recording consent requirements.
          </p>
        </section>

        <!-- 7. Service Availability & SLA -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">7. Service Availability & Uptime</h2>
          <p class="text-slate-300 leading-relaxed">
            All In One System endeavors to maintain high availability of the Services, targeting
            99.9% uptime for the Voice AI platform. However, scheduled maintenance windows, system
            upgrades, and unforeseen technical circumstances may temporarily affect service
            availability. The Company will provide reasonable advance notice for scheduled
            maintenance when practicable.
          </p>
        </section>

        <!-- 8. Limitation of Liability -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">8. Limitation of Liability</h2>
          <p class="text-slate-300 leading-relaxed">
            To the maximum extent permitted by applicable law, All In One System, its officers,
            directors, employees, agents, and affiliates shall not be liable for any indirect,
            incidental, special, consequential, or punitive damages, including but not limited to
            loss of profits, data, business opportunities, or goodwill, arising out of or in
            connection with the use of the Services, regardless of the theory of liability.
          </p>
          <p class="text-slate-300 leading-relaxed mt-4">
            In no event shall the total aggregate liability of All In One System exceed the total
            amount of subscription fees paid by the Client during the twelve (12) month period
            immediately preceding the event giving rise to the claim.
          </p>
        </section>

        <!-- 9. Indemnification -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">9. Indemnification</h2>
          <p class="text-slate-300 leading-relaxed">
            You agree to indemnify, defend, and hold harmless All In One System and its officers,
            directors, employees, agents, and affiliates from and against any and all claims,
            liabilities, damages, losses, costs, and expenses (including reasonable attorneys' fees)
            arising out of or in connection with your use of the Services, your violation of these
            Terms, or your violation of any rights of a third party.
          </p>
        </section>

        <!-- 10. Governing Law -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">10. Governing Law & Dispute Resolution</h2>
          <p class="text-slate-300 leading-relaxed">
            These Terms shall be governed by and construed in accordance with the laws of the
            jurisdiction in which All In One System operates, without regard to its conflict of law
            provisions. Any dispute arising out of or relating to these Terms or the Services shall
            be resolved through binding arbitration in accordance with the rules of the American
            Arbitration Association.
          </p>
        </section>

        <!-- 11. Severability -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">11. Severability</h2>
          <p class="text-slate-300 leading-relaxed">
            If any provision of these Terms is found to be unenforceable or invalid by a court of
            competent jurisdiction, that provision shall be limited or eliminated to the minimum
            extent necessary so that these Terms shall otherwise remain in full force and effect.
          </p>
        </section>

        <!-- 12. Contact -->
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">12. Contact Information</h2>
          <p class="text-slate-300 leading-relaxed">
            If you have any questions about these Terms & Conditions, please contact us:
          </p>
          <ul class="list-none text-slate-300 space-y-2 mt-4">
            <li><strong class="text-white">Email:</strong> support@allinonesystem.com</li>
            <li><strong class="text-white">WhatsApp:</strong> +8801951284128</li>
            <li><strong class="text-white">Telegram:</strong> @fshahariar</li>
          </ul>
        </section>

      </div>
    </div>
  </main>

  <Footer />
  <ContactWidget />
</BaseLayout>
