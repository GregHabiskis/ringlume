---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CopyRegion from '../components/tina/CopyRegion.astro'
import TermsBody from '../components/cms-regions/legal/TermsBody.astro'

const copy = Astro.locals.site.legal.terms
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription}>
  <CopyRegion region="header" page="terms"><Header /></CopyRegion>
  <CopyRegion region="terms" page="terms" primary><TermsBody /></CopyRegion>
  <CopyRegion region="footer" page="terms"><Footer /></CopyRegion>
</BaseLayout>
